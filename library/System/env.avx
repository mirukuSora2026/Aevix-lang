/*
 * Lifecycle of the env public module.
 * @module env
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public import error { EnvError };
import memory;

/*
 * UTF-8 environment access returns owned values and never exposes native pointers.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Optional<string>, EnvError> get(string_view name) {
    mut Tuple<i32, string, i32, i32> outcome = __env_get(name);
    i32 status = *Tuple.get<0>(&outcome);
    if (status == 8) return Result.ok(Optional.none());
    if (status != 0) return Result.err(env_error(status, *Tuple.get<2>(&outcome)));
    string empty;
    Result<string, TextError> initialized = string.from_view("");
    switch (move initialized) {
        case Result<string, TextError>.Ok { string value = value }: empty = value; break;
        case Result<string, TextError>.Err: return Result.err(EnvError.AllocationFailure); break;
    }
    string value = memory.replace<string>(Tuple.get_mut<1>(&mut outcome), empty);
    return Result.ok(Optional.some(value));
}
/*
 * Version history for the env.require public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<string, EnvError> require(string_view name) {
    Optional<string> found = get(name)?;
    switch (move found) {
        case Optional<string>.Some { string value = value }: return Result.ok(value); break;
        case Optional<string>.None: return Result.err(EnvError.NotFound); break;
    }
}
/*
 * Version history for the env.contains public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<bool, EnvError> contains(string_view name) {
    Optional<string> found = get(name)?;
    return Result.ok(Optional.is_some(&found));
}
/*
 * Version history for the env.set public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, EnvError> set(string_view name, string_view value) {
    Tuple<i32, usize, i32, i32> outcome = __env_set(name, value);
    i32 status = *Tuple.get<0>(&outcome);
    if (status == 0) return Result.ok(Unit.value());
    return Result.err(env_error(status, *Tuple.get<2>(&outcome)));
}
/*
 * Version history for the env.remove public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, EnvError> remove(string_view name) {
    Tuple<i32, usize, i32, i32> outcome = __env_remove(name);
    i32 status = *Tuple.get<0>(&outcome);
    if (status == 0) return Result.ok(Unit.value());
    return Result.err(env_error(status, *Tuple.get<2>(&outcome)));
}
EnvError env_error(i32 status, i32 native) {
    if (status == 2) return EnvError.InvalidName;
    if (status == 3) return EnvError.InvalidEncoding;
    if (status == 4 || status == 5) return EnvError.AllocationFailure;
    return EnvError.Os { os_code = native };
}
Tuple<i32, string, i32, i32> __env_get(string_view name) {}
Tuple<i32, usize, i32, i32> __env_set(string_view name, string_view value) {}
Tuple<i32, usize, i32, i32> __env_remove(string_view name) {}
