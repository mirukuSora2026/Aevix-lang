 * Already consumed input is not restored after parse failure; IO and parsing stay distinct.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum ReadError implements Copy, Error {
    /*
     * Version history for the error.ReadError.Io public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Io { /*
 * Version history for the error.ReadError.Io.error public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public IoError error; };
    /*
     * Version history for the error.ReadError.Parse public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Parse { /*
 * Version history for the error.ReadError.Parse.error public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public ParseError error; };

    /*
     * Version history for the error.ReadError.code public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&ReadError self) {
        switch (*self) {
            case ReadError.Io { &IoError cause = error }:
                return cause.code();
                break;
            case ReadError.Parse { &ParseError cause = error }:
                switch (*cause) {
                    case ParseError.EmptyInput: return "parse.empty_input"; break;
                    case ParseError.InvalidSyntax: return "parse.invalid_syntax"; break;
                    case ParseError.OutOfRange: return "parse.out_of_range"; break;
                    case ParseError.NonFinite: return "parse.non_finite"; break;
                    case ParseError.InvalidScalar: return "parse.invalid_scalar"; break;
                }
                break;
        }
    }
    /*
     * Version history for the error.ReadError.message public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&ReadError self) {
        switch (*self) {
            case ReadError.Io { &IoError cause = error }:
                return cause.message();
                break;
            case ReadError.Parse { &ParseError cause = error }:
                switch (*cause) {
                    case ParseError.EmptyInput: return "Input contains no scalar token."; break;
                    case ParseError.InvalidSyntax: return "Input is not a complete valid scalar representation."; break;
                    case ParseError.OutOfRange: return "Input is outside the requested scalar type range."; break;
                    case ParseError.NonFinite: return "A finite scalar value is required."; break;
                    case ParseError.InvalidScalar: return "Input is not a valid Unicode scalar."; break;
                }
                break;
        }
    }
};

/*
 * Explicit, allocation-free adapter from builtin errors to the Error interface.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
/* Moving the adapter preserves its original error value; no implicit conversion or cloning occurs.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum CoreError implements Error {
    /*
     * Preserve an owned CollectionError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Collection {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public CollectionError error;
    };
    /*
     * Preserve an owned RangeError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Range {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public RangeError error;
    };
    /*
     * Preserve an owned BoundsError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Bounds {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public BoundsError error;
    };
    /*
     * Preserve an owned TextError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Text {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public TextError error;
    };
    /*
     * Preserve an owned ParseError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Parse {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public ParseError error;
    };
    /*
     * Preserve an owned IntegerError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Integer {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public IntegerError error;
    };
    /*
     * Preserve an owned FloatError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Float {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public FloatError error;
    };
    /*
     * Preserve the original invalid character scalar without allocation.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Char {
        /*
         * Retain the exact scalar rejected by the checked Char constructor.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public CharError error;
    };
    /*
     * Preserve an owned RefCountError value.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    RefCount {
        /*
         * Original error, available to callers by borrowing or consuming the adapter.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public RefCountError error;
    };

    /*
     * Return a static code without allocating or consuming the stored error.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&CoreError self) {
        switch (*self) {
            case CoreError.Collection { &CollectionError cause = error }:
                switch (*cause) {
                    case CollectionError.AllocationFailure: return "collection.allocation_failure"; break;
                    case CollectionError.SizeOverflow: return "collection.size_overflow"; break;
                }
                break;
            case CoreError.Range { &RangeError cause = error }:
                switch (*cause) {
                    case RangeError.InvalidStep: return "range.invalid_step"; break;
                    case RangeError.CountOverflow: return "range.count_overflow"; break;
                }
                break;
            case CoreError.Bounds { &BoundsError cause = error }:
                switch (*cause) {
                    case BoundsError.OutOfBounds: return "bounds.out_of_bounds"; break;
                    case BoundsError.ReversedRange: return "bounds.reversed_range"; break;
                }
                break;
            case CoreError.Text { &TextError cause = error }:
                switch (*cause) {
                    case TextError.AllocationFailure: return "text.allocation_failure"; break;
                    case TextError.SizeOverflow: return "text.size_overflow"; break;
                    case TextError.InvalidUtf8: return "text.invalid_utf8"; break;
                    case TextError.InvalidBoundary: return "text.invalid_boundary"; break;
                }
                break;
            case CoreError.Parse { &ParseError cause = error }:
                switch (*cause) {
                    case ParseError.EmptyInput: return "parse.empty_input"; break;
                    case ParseError.InvalidSyntax: return "parse.invalid_syntax"; break;
                    case ParseError.OutOfRange: return "parse.out_of_range"; break;
                    case ParseError.NonFinite: return "parse.non_finite"; break;
                    case ParseError.InvalidScalar: return "parse.invalid_scalar"; break;
                }
                break;
            case CoreError.Integer { &IntegerError cause = error }:
                switch (*cause) {
                    case IntegerError.OutOfRange: return "integer.out_of_range"; break;
                }
                break;
            case CoreError.Float { &FloatError cause = error }:
                switch (*cause) {
                    case FloatError.OutOfRange: return "float.out_of_range"; break;
                    case FloatError.NonFinite: return "float.non_finite"; break;
                    case FloatError.NonExact: return "float.non_exact"; break;
                }
                break;
            case CoreError.Char { &CharError cause = error }:
                switch (*cause) {
                    case CharError.InvalidScalar: return "char.invalid_scalar"; break;
                }
                break;
            case CoreError.RefCount { &RefCountError cause = error }:
                switch (*cause) {
                    case RefCountError.CountOverflow: return "memory.ref_count_overflow"; break;
                }
                break;
        }
    }

    /*
     * Return a static message without allocating or consuming the stored error.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&CoreError self) {
        switch (*self) {
            case CoreError.Collection { &CollectionError cause = error }:
                switch (*cause) {
                    case CollectionError.AllocationFailure: return "Memory for the collection could not be allocated."; break;
                    case CollectionError.SizeOverflow: return "The requested collection size is not representable."; break;
                }
                break;
            case CoreError.Range { &RangeError cause = error }:
                switch (*cause) {
                    case RangeError.InvalidStep: return "The range step is invalid for its direction."; break;
                    case RangeError.CountOverflow: return "The range element count is not representable."; break;
                }
                break;
            case CoreError.Bounds { &BoundsError cause = error }:
                switch (*cause) {
                    case BoundsError.OutOfBounds: return "The requested index is outside the valid bounds."; break;
                    case BoundsError.ReversedRange: return "The range start is greater than its end."; break;
                }
                break;
            case CoreError.Text { &TextError cause = error }:
                switch (*cause) {
                    case TextError.AllocationFailure: return "Memory for the text could not be allocated."; break;
                    case TextError.SizeOverflow: return "The requested text size is not representable."; break;
                    case TextError.InvalidUtf8: return "The input is not valid UTF-8."; break;
                    case TextError.InvalidBoundary: return "The byte offset is not a UTF-8 character boundary."; break;
                }
                break;
            case CoreError.Parse { &ParseError cause = error }:
                switch (*cause) {
                    case ParseError.EmptyInput: return "Input contains no scalar token."; break;
                    case ParseError.InvalidSyntax: return "Input is not a complete valid scalar representation."; break;
                    case ParseError.OutOfRange: return "Input is outside the requested scalar type range."; break;
                    case ParseError.NonFinite: return "A finite scalar value is required."; break;
                    case ParseError.InvalidScalar: return "Input is not a valid Unicode scalar."; break;
                }
                break;
            case CoreError.Integer { &IntegerError cause = error }:
                switch (*cause) {
                    case IntegerError.OutOfRange: return "The integer result is outside the requested type range."; break;
                }
                break;
            case CoreError.Float { &FloatError cause = error }:
                switch (*cause) {
                    case FloatError.OutOfRange: return "The floating-point result is outside the requested type range."; break;
                    case FloatError.NonFinite: return "A finite floating-point value is required."; break;
                    case FloatError.NonExact: return "The conversion cannot preserve the value exactly."; break;
                }
                break;
            case CoreError.Char { &CharError cause = error }:
                switch (*cause) {
                    case CharError.InvalidScalar: return "The value is not a valid Unicode scalar."; break;
                }
                break;
            case CoreError.RefCount { &RefCountError cause = error }:
                switch (*cause) {
                    case RefCountError.CountOverflow: return "The shared or weak reference count cannot be increased."; break;
                }
                break;
        }
    }
};

/*
 * Type erasure either moves an existing Box or performs an explicit fallible allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public struct AnyError implements Error {
    Box<dyn Error> owner;

    /*
     * Version history for the error.AnyError.from_box public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public AnyError from_box(Box<dyn Error> value) {
        return AnyError { owner = value };
    }
    /*
     * Version history for the error.AnyError.pack public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public Result<AnyError, InputError<E>> pack<E>(E value) where E implements Error {
        Result<Box<E>, InputError<E>> allocated = Box.new(value);
        switch (move allocated) {
            case Result<Box<E>, InputError<E>>.Ok { Box<E> concrete = value }:
                Box<dyn Error> erased = Box.into_dyn(concrete);
                return Result.ok(AnyError { owner = erased });
                break;
            case Result<Box<E>, InputError<E>>.Err { InputError<E> failure = error }:
                return Result.err(failure);
                break;
        }
    }
    /*
     * Version history for the error.AnyError.code public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&AnyError self) {
        return self.owner.code();
    }
    /*
     * Version history for the error.AnyError.message public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&AnyError self) {
        return self.owner.message();
    }
    /*
     * Version history for the error.AnyError.as_error public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public &dyn Error as_error(&AnyError self) {
        return Box.as_ref(&self.owner);
    }
};
