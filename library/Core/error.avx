    public string_view message(&ProcessError self) {
        switch (*self) {
            case ProcessError.TerminationFailed:
                return "The operating system rejected the child termination request.";
                break;
            case ProcessError.SpawnFailed:
                return "The child process could not be started.";
                break;
            case ProcessError.WaitFailed:
                return "The child process status could not be collected.";
                break;
            case ProcessError.InvalidArgument:
                return "A process argument or environment entry is invalid.";
                break;
            case ProcessError.AlreadyReaped:
                return "The child process status has already been collected.";
                break;
            case ProcessError.TimedOut:
                return "The process did not finish before the deadline.";
                break;
            case ProcessError.AllocationFailure:
                return "Storage for the process operation could not be allocated.";
                break;
            case ProcessError.Unsupported:
                return "The process operation is unavailable on this target.";
                break;
        }
    }
};

