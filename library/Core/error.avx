        switch (*self) {
            case IoError.ReadFailed:
                return "io.read_failed";
                break;
            case IoError.WriteFailed:
                return "io.write_failed";
                break;
            case IoError.FlushFailed:
                return "io.flush_failed";
                break;
            case IoError.Interrupted:
                return "io.interrupted";
                break;
            case IoError.WouldBlock:
                return "io.would_block";
                break;
            case IoError.Closed:
                return "io.closed";
                break;
            case IoError.InvalidUtf8:
                return "io.invalid_utf8";
                break;
            case IoError.InputTooLong:
                return "io.input_too_long";
                break;
            case IoError.AllocationFailure:
                return "io.allocation_failure";
                break;
            case IoError.SizeOverflow:
                return "io.size_overflow";
                break;
            case IoError.Unsupported:
                return "io.unsupported";
                break;
        }
    }

    /*
     * Version history for the error.IoError.message public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&IoError self) {
        switch (*self) {
            case IoError.ReadFailed:
                return "The input operation failed after the reported byte progress.";
                break;
            case IoError.WriteFailed:
                return "The output operation failed after the reported byte progress.";
                break;
            case IoError.FlushFailed:
                return "Buffered output could not be flushed.";
                break;
            case IoError.Interrupted:
                return "The operation was interrupted before it could complete.";
                break;
            case IoError.WouldBlock:
                return "The operation would block on a nonblocking resource.";
                break;
            case IoError.Closed:
                return "The stream or resource is closed.";
                break;
            case IoError.InvalidUtf8:
                return "Input bytes are not a valid UTF-8 sequence.";
                break;
            case IoError.InputTooLong:
                return "Input exceeds the configured byte limit.";
                break;
            case IoError.AllocationFailure:
                return "Memory for the IO operation could not be allocated.";
                break;
            case IoError.SizeOverflow:
                return "The requested IO size is not representable.";
                break;
            case IoError.Unsupported:
                return "The operation is not supported by this resource or target.";
                break;
        }
    }
};

