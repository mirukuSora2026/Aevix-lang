/*
 * Lifecycle of the error public module.
 * @module error
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
import memory { Box, RefCountError };

/*
 * Inspection borrows an owner and returns static codes and summaries; erasure is explicit.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public interface Error {
    /*
     * Version history for the error.Error.code public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&Self self);
    /*
     * Version history for the error.Error.message public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&Self self);
};

