/*
 * Version history for the error.TaskError public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum TaskError implements Copy, Error {
/*
 * The native worker finished without an initialized application result.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Failed;
/*
 * The requested task storage, count or duration exceeds the supported range.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Overflow;
/*
 * This operation would wait for the calling worker itself.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
WouldDeadlock;
/*
 * The operating system rejected worker reaping or another task lifecycle operation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Native {
/*
 * The platform error code captured before any cleanup call.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 os_code;
/*
 * The native error domain accompanying os_code; it is not an address or handle.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 domain;
};

    /*
     * Version history for the error.TaskError.SpawnFailed public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    SpawnFailed { /*
 * Version history for the error.TaskError.SpawnFailed.os_code public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 os_code; };
    /*
     * Version history for the error.TaskError.Cancelled public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Cancelled;
    /*
     * Version history for the error.TaskError.TimedOut public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    TimedOut;
    /*
     * Version history for the error.TaskError.AlreadyJoined public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    AlreadyJoined;
    /*
     * Version history for the error.TaskError.ScopeClosed public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    ScopeClosed;
    /*
     * Version history for the error.TaskError.AllocationFailure public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    AllocationFailure;
    /*
     * Version history for the error.TaskError.Unsupported public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Unsupported;

    /*
     * Version history for the error.TaskError.code public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&TaskError self) {
        switch (*self) {
            case TaskError.Failed: return "task.failed"; break;
            case TaskError.Overflow: return "task.overflow"; break;
            case TaskError.WouldDeadlock: return "task.would_deadlock"; break;
            case TaskError.Native: return "task.native"; break;

            case TaskError.SpawnFailed:
                return "task.spawn_failed";
                break;
            case TaskError.Cancelled:
                return "task.cancelled";
                break;
            case TaskError.TimedOut:
                return "task.timed_out";
                break;
            case TaskError.AlreadyJoined:
                return "task.already_joined";
                break;
            case TaskError.ScopeClosed:
                return "task.scope_closed";
                break;
            case TaskError.AllocationFailure:
                return "task.allocation_failure";
                break;
            case TaskError.Unsupported:
                return "task.unsupported";
                break;
        }
    }

    /*
     * Version history for the error.TaskError.message public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&TaskError self) {
        switch (*self) {
            case TaskError.Failed: return "The native worker did not initialize an application result."; break;
            case TaskError.Overflow: return "The requested task storage, count or duration exceeds the supported range."; break;
            case TaskError.WouldDeadlock: return "The operation would wait for its calling worker."; break;
            case TaskError.Native: return "A native task lifecycle operation failed; the platform code and domain are retained."; break;

            case TaskError.SpawnFailed:
                return "The CPU task could not be started.";
                break;
            case TaskError.Cancelled:
                return "The CPU task was cancelled before producing an application result.";
                break;
            case TaskError.TimedOut:
                return "The task did not finish before the deadline.";
                break;
            case TaskError.AlreadyJoined:
                return "The task result has already been collected.";
                break;
            case TaskError.ScopeClosed:
                return "The task scope is closed to new work.";
                break;
            case TaskError.AllocationFailure:
                return "Storage for the task could not be allocated.";
                break;
            case TaskError.Unsupported:
                return "The task operation is unavailable on this target.";
                break;
        }
    }
};

