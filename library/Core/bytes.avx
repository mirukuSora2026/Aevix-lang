/* Require count 0..7 and fill high positions with zero; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> shift_right(byte value, u32 count) {
    if (count >= 8u32) return Result.err(ByteError.InvalidShift { count = count });
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok(Byte.from_u8(represent<u8>(raw >> count)));
}
/* Read bit index 0..7; index 0 is least significant; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<bool, ByteError> test_bit(byte value, u32 index) {
    if (index >= 8u32) return Result.err(ByteError.InvalidBitIndex { index = index });
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok((raw & (1u32 << index)) != 0u32);
