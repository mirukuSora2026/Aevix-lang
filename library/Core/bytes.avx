/* Set bit index 0..7 in a copied pattern; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> set_bit(byte value, u32 index) {
    if (index >= 8u32) return Result.err(ByteError.InvalidBitIndex { index = index });
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok(Byte.from_u8(represent<u8>(raw | (1u32 << index))));
}
/* Clear bit index 0..7 in a copied pattern; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> clear_bit(byte value, u32 index) {
    if (index >= 8u32) return Result.err(ByteError.InvalidBitIndex { index = index });
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok(Byte.from_u8(represent<u8>(raw & (255u32 ^ (1u32 << index)))));
}
/* Toggle bit index 0..7 in a copied pattern; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> toggle_bit(byte value, u32 index) {
    if (index >= 8u32) return Result.err(ByteError.InvalidBitIndex { index = index });
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok(Byte.from_u8(represent<u8>(raw ^ (1u32 << index))));
}
/* Assign bit index 0..7 from a boolean; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> with_bit(byte value, u32 index, bool bit) {
    if (bit) return set_bit(value, index);
    return clear_bit(value, index);
}
Result<unit, ByteError> check_bits(u32 start, u32 width) {
    if (start > 8u32 || width > 8u32 - start)
        return Result.err(ByteError.InvalidBitRange { start = start, width = width });
    return Result.ok(Unit.value());
}
/* Right-align a contained bit range and clear all other positions; no allocation.
 * A zero-width range is valid at start 0..8 and returns the zero pattern.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> extract_bits(byte value, u32 start, u32 width) {
    check_bits(start, width)?;
    u32 mask = (1u32 << width) - 1u32;
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok(Byte.from_u8(represent<u8>((raw >> start) & mask)));
}
/* Replace a contained bit range after validating range and field fit; no truncation or allocation.
 * A zero-width range accepts only a zero field and returns the unchanged pattern.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> deposit_bits(byte value, u32 start, u32 width, byte field) {
    check_bits(start, width)?;
    u32 mask = (1u32 << width) - 1u32;
    u32 incoming = represent<u32>(Byte.to_u8(field));
    if (incoming > mask) return Result.err(ByteError.FieldOutOfRange { field = field, width = width });
    u32 raw = represent<u32>(Byte.to_u8(value));
    u32 output = (raw & (255u32 ^ (mask << start))) | (incoming << start);
    return Result.ok(Byte.from_u8(represent<u8>(output)));
}
/* Return the high four bits right-aligned; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte high_nibble(byte value) { return Byte.from_u8(Byte.to_u8(value) >> 4); }
/* Return the low four bits and clear high positions; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte low_nibble(byte value) { return Byte.from_u8(Byte.to_u8(value) & 15u8); }
/* Require both inputs 0..15; report the first invalid input before combining; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> join_nibbles(byte high, byte low) {
    if (Byte.to_u8(high) > 15u8) return Result.err(ByteError.InvalidNibble { value = high, position = 0 });
    if (Byte.to_u8(low) > 15u8) return Result.err(ByteError.InvalidNibble { value = low, position = 1 });
    u32 output = (represent<u32>(Byte.to_u8(high)) << 4) | represent<u32>(Byte.to_u8(low));
    return Result.ok(Byte.from_u8(represent<u8>(output)));
}
/* Parse exactly eight ASCII 0/1 digits; invalid length takes precedence, then first invalid byte.
 * O(8), no allocation, prefix, whitespace or separators.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> parse_binary(string_view text) {
    Slice<byte> input = string.as_bytes(text);
    if (Slice.len(input) != 8) return Result.err(ByteError.InvalidBinaryLength { length = Slice.len(input) });
    mut usize index = 0;
    mut u32 output = 0;
    while (index < 8) {
        u8 digit = Byte.to_u8(input[index]);
        if (digit != 48u8 && digit != 49u8) return Result.err(ByteError.InvalidBinaryDigit { offset = index });
        output = (output << 1) | represent<u32>(digit - 48u8);
        index++;
    }
    return Result.ok(Byte.from_u8(represent<u8>(output)));
}
/* Validate full capacity before writing eight ASCII digits; return 8, leave the tail unchanged.
 * O(8), no allocation; a rejected destination is not partially modified.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize, ByteError> format_binary_into(byte value, MutSlice<byte> output) {
    check_range(Slice.len(&output), 0, 8)?;
    u32 raw = represent<u32>(Byte.to_u8(value));
    mut u32 mask = 128;
    mut usize index = 0;
    while (index < 8) {
        output[index] = Byte.from_u8((raw & mask) != 0u32 ? 49u8 : 48u8);
        mask = mask >> 1;
        index++;
    }
    return Result.ok(8usize);
}
/* Allocate exactly eight ASCII binary digits; the inline temporary does not allocate.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<string, ByteError> format_binary(byte value) {
    mut byte output[8] = [Byte.from_u8(0u8), Byte.from_u8(0u8), Byte.from_u8(0u8), Byte.from_u8(0u8), Byte.from_u8(0u8), Byte.from_u8(0u8), Byte.from_u8(0u8), Byte.from_u8(0u8)];
    format_binary_into(value, Slice.from_array_mut(&mut output))?;
    return ascii_string(Slice.from_array(&output));
}
/* Compare exact eight-bit patterns; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool equal(byte left, byte right) { return Byte.to_u8(left) == Byte.to_u8(right); }
/* Order unsigned patterns with the shared ordering.Ordering type; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Ordering compare_bits(byte left, byte right) {
    if (Byte.to_u8(left) < Byte.to_u8(right)) return Ordering.Less;
    if (Byte.to_u8(left) > Byte.to_u8(right)) return Ordering.Greater;
    return Ordering.Equal;
}
/* Compare unsigned bytes then lengths; O(min(n,m)), no text collation or allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Ordering compare_lexicographic(Slice<byte> left, Slice<byte> right) {
    mut usize index = 0;
    while (index < Slice.len(left) && index < Slice.len(right)) {
        if (Byte.to_u8(left[index]) < Byte.to_u8(right[index])) return Ordering.Less;
        if (Byte.to_u8(left[index]) > Byte.to_u8(right[index])) return Ordering.Greater;
        index++;
    }
    if (Slice.len(left) < Slice.len(right)) return Ordering.Less;
    if (Slice.len(left) > Slice.len(right)) return Ordering.Greater;
    return Ordering.Equal;
}


/* Copy an initialized byte extent inside one exclusive buffer, allowing overlap; O(n), no allocation.
 * Require an ascending, unit-step descriptor and start <= end. Descriptor errors precede bounds errors.
 * Half-open [length,length) is empty; a closed endpoint must name an existing element before adding one.
 * Validate source and destination completely before any write. A rejected call leaves all bytes unchanged.
 * Successful empty copies allow destination == length. No native byte order or pointer access is involved.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> copy_within(MutSlice<byte> buffer, Range<usize> source, usize destination) {
    if (Range.is_descending(&source) || Range.step_magnitude(&source) != 1usize)
        return Result.err(ByteError.NonContiguousRange);
    usize start = Range.start(&source);
    usize end = Range.end(&source);
    if (start > end) return Result.err(ByteError.ReversedRange { start = start, end = end });
    usize length = Slice.len(&buffer);
    if (start > length) return Result.err(ByteError.OutOfBounds { offset = start, width = 0, length = length });
    mut usize stop = end;
    if (Range.is_inclusive(&source)) {
        if (end >= length) return Result.err(ByteError.OutOfBounds { offset = end, width = 1, length = length });
        stop = end + 1;
    } else {
        if (end > length) return Result.err(ByteError.OutOfBounds { offset = start, width = end - start, length = length });
    }
    usize width = stop - start;
    check_range(length, destination, width)?;
    if (width == 0 || destination == start) return Result.ok(Unit.value());
    if (destination > start && destination < stop) {
        mut usize remaining = width;
        while (remaining > 0) { remaining--; buffer[destination + remaining] = buffer[start + remaining]; }
    } else {
        mut usize index = 0;
        while (index < width) { buffer[destination + index] = buffer[start + index]; index++; }
    }
    return Result.ok(Unit.value());
}


Result<unit, ByteError> collection_status(Result<unit, CollectionError> input) {
    switch (move input) {
        case Result<unit, CollectionError>.Ok: return Result.ok(Unit.value()); break;
        case Result<unit, CollectionError>.Err { CollectionError reason = error }:
            switch (reason) {
                case CollectionError.AllocationFailure: return Result.err(ByteError.AllocationFailure); break;
                case CollectionError.SizeOverflow: return Result.err(ByteError.SizeOverflow); break;
            }
            break;
    }
}
/* Reserve capacity for an empty owning byte buffer. Spare capacity is never readable data.
 * Allocation failure returns no owner; capacity zero performs no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<byte>, ByteError> with_capacity(usize capacity) { return allocate_capacity(capacity); }
/* Allocate length initialized zero bytes; O(length), with one reserved byte buffer.
 * Reserving the complete size precedes initialization and failure releases temporary storage.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<byte>, ByteError> allocate(usize length) {
    mut Vector<byte> output = allocate_capacity(length)?;
    mut usize index = 0;
    while (index < length) { append_byte(&mut output, Byte.from_u8(0u8))?; index++; }
    return Result.ok(output);
}
/* Allocate an independent byte copy; O(n), source ownership and contents are unchanged on failure.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<byte>, ByteError> from_slice(Slice<byte> input) {
    mut Vector<byte> output = allocate_capacity(Slice.len(input))?;
    mut usize index = 0;
    while (index < Slice.len(input)) { append_byte(&mut output, input[index])?; index++; }
    return Result.ok(output);
}
/* Inspect reserved byte capacity without moving or changing the owner; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize capacity(&Vector<byte> input) { return Vector.capacity(input); }
/* Reserve length plus additional before any logical change; allocation/size failure preserves the owner.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> reserve(&mut Vector<byte> buffer, usize additional) {
    return collection_status(Vector.reserve(&mut *buffer, additional));
}
/* Append one initialized Copy byte; allocation/size failure leaves contents and length unchanged.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> push(&mut Vector<byte> buffer, byte value) { return append_byte(&mut *buffer, value); }
/* Remove and return the last byte, or None for an empty owner; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Optional<byte> pop(&mut Vector<byte> buffer) { return Vector.pop(buffer); }
/* Clear initialized bytes while retaining capacity; no allocation or cryptographic erasure promise.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public unit clear(&mut Vector<byte> buffer) { return Vector.clear(buffer); }
/* Insert through length, shifting the initialized suffix; validate before allocating or mutating.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> insert(&mut Vector<byte> buffer, usize offset, byte value) {
    usize length = Vector.len(&*buffer);
    check_range(length, offset, 0)?;
    Result<unit, InputError<byte>> inserted = Vector.insert(&mut *buffer, offset, value);
    switch (move inserted) {
        case Result<unit, InputError<byte>>.Ok: return Result.ok(Unit.value()); break;
        case Result<unit, InputError<byte>>.Err { InputError<byte> reason = error }:
            switch (reason) {
                case InputError<byte>.AllocationFailure: return Result.err(ByteError.AllocationFailure); break;
                case InputError<byte>.SizeOverflow: return Result.err(ByteError.SizeOverflow); break;
                case InputError<byte>.OutOfBounds: return Result.err(ByteError.OutOfBounds { offset = offset, width = 0, length = length }); break;
            }
            break;
    }
}
/* Remove an initialized byte and shift its suffix; validate first, then perform no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> remove(&mut Vector<byte> buffer, usize offset) {
    usize length = Vector.len(&*buffer);
    check_range(length, offset, 1)?;
    Result<byte, BoundsError> removed = Vector.remove(&mut *buffer, offset);
    switch (move removed) {
        case Result<byte, BoundsError>.Ok { byte value = value }: return Result.ok(value); break;
        case Result<byte, BoundsError>.Err: return Result.err(ByteError.OutOfBounds { offset = offset, width = 1, length = length }); break;
    }
}
/* Require length no greater than the initialized length, then discard the suffix; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> truncate(&mut Vector<byte> buffer, usize length) {
    usize current = Vector.len(&*buffer);
    check_range(current, length, 0)?;
    Vector.truncate(&mut *buffer, length);
    return Result.ok(Unit.value());
}
/* Copy initialized bytes only when complete lengths match; O(n), no allocation or partial error write.
 * The exclusive destination and readonly source cannot be conflicting aliases.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> copy_from(MutSlice<byte> destination, Slice<byte> source) {
    usize expected = Slice.len(&destination);
    usize actual = Slice.len(source);
    if (expected != actual) return Result.err(ByteError.LengthMismatch { expected = expected, actual = actual });
    mut usize index = 0;
    while (index < actual) { destination[index] = source[index]; index++; }
    return Result.ok(Unit.value());
}
/* Reserve the entire appended length before copying; O(n), with at most one buffer growth.
 * A failed reserve leaves length, capacity and contents unchanged. Input cannot alias a live mutation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> extend(&mut Vector<byte> buffer, Slice<byte> input) {
    reserve(&mut *buffer, Slice.len(input))?;
    mut usize index = 0;
    while (index < Slice.len(input)) { append_byte(&mut *buffer, input[index])?; index++; }
    return Result.ok(Unit.value());
}
/* Grow with initialized fill bytes or truncate. Reserve complete growth before changing logical contents.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> resize(&mut Vector<byte> buffer, usize length, byte fill) {
    usize current = Vector.len(&*buffer);
    if (length <= current) { Vector.truncate(&mut *buffer, length); return Result.ok(Unit.value()); }
    reserve(&mut *buffer, length - current)?;
    mut usize index = current;
    while (index < length) { append_byte(&mut *buffer, fill)?; index++; }
    return Result.ok(Unit.value());
}
/* Append Copy bytes and empty the independent source only after the full destination copy commits.
 * A failed reserve preserves both owners and their capacities; source capacity is retained on success.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> append(&mut Vector<byte> destination, &mut Vector<byte> source) {
    usize length = Vector.len(&*source);
    reserve(&mut *destination, length)?;
    mut usize index = 0;
    while (index < length) { append_byte(&mut *destination, source[index])?; index++; }
    Vector.clear(&mut *source);
    return Result.ok(Unit.value());
}
/* Allocate an independent owning tail, then truncate the source only after that copy succeeds.
 * Offset through length is allowed; a failing bounds/allocation check leaves the original owner unchanged.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<byte>, ByteError> split_off(&mut Vector<byte> buffer, usize offset) {
    usize length = Vector.len(&*buffer);
    check_range(length, offset, 0)?;
    mut Vector<byte> tail = allocate_capacity(length - offset)?;
    mut usize index = offset;
    while (index < length) { append_byte(&mut tail, buffer[index])?; index++; }
    Vector.truncate(&mut *buffer, offset);
    return Result.ok(tail);
}
Result<Tuple<usize, usize>, ByteError> extent(Range<usize> range, usize length) {
    if (Range.is_descending(&range) || Range.step_magnitude(&range) != 1usize)
        return Result.err(ByteError.NonContiguousRange);
    usize start = Range.start(&range);
    usize end = Range.end(&range);
    if (start > end) return Result.err(ByteError.ReversedRange { start = start, end = end });
    if (start > length) return Result.err(ByteError.OutOfBounds { offset = start, width = 0, length = length });
    if (Range.is_inclusive(&range)) {
        if (end >= length) return Result.err(ByteError.OutOfBounds { offset = end, width = 1, length = length });
        return Result.ok(Tuple.make(start, end + 1));
    }
    if (end > length) return Result.err(ByteError.OutOfBounds { offset = start, width = end - start, length = length });
    return Result.ok(Tuple.make(start, end));
}
/* Borrow a checked extent without copying bytes or extending the original owner lifetime; no allocation.
 * Open/closed ascending unit-step bounds follow copy_within; reversed extents are rejected.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Slice<byte>, ByteError> slice(Slice<byte> input, Range<usize> range) {
    Tuple<usize, usize> bounds = extent(range, Slice.len(input))?;
    usize start = *Tuple.get<0>(&bounds);
    usize end = *Tuple.get<1>(&bounds);
    Result<Slice<byte>, BoundsError> outcome = Slice.slice(input, start, end);
    switch (move outcome) {
        case Result<Slice<byte>, BoundsError>.Ok { Slice<byte> value = value }: return Result.ok(value); break;
        case Result<Slice<byte>, BoundsError>.Err: return Result.err(ByteError.OutOfBounds { offset = start, width = end - start, length = Slice.len(input) }); break;
    }
}
/* Borrow an exclusive checked extent; returned views retain the original buffer loan through Result.
 * No allocation or byte copy; conflicting parent access remains suspended until the sub-borrow ends.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<MutSlice<byte>, ByteError> slice_mut(MutSlice<byte> input, Range<usize> range) {
    usize length = Slice.len(&input);
    Tuple<usize, usize> bounds = extent(range, length)?;
    usize start = *Tuple.get<0>(&bounds);
    usize end = *Tuple.get<1>(&bounds);
    Result<MutSlice<byte>, BoundsError> outcome = Slice.slice_mut(input, start, end);
    switch (move outcome) {
        case Result<MutSlice<byte>, BoundsError>.Ok { MutSlice<byte> value = value }: return Result.ok(value); break;
        case Result<MutSlice<byte>, BoundsError>.Err: return Result.err(ByteError.OutOfBounds { offset = start, width = end - start, length = length }); break;
    }
}


/* Only strict UTF-8 validation and owned UTF-8 decoding call this domain-specific adapter.
 * Other encoding domains are internal contract violations, never fabricated UTF-8 offsets.
 */
ByteError utf8_error(encoding.EncodingError reason) {
    switch (reason) {
        case encoding.EncodingError.InvalidUtf8 { usize offset = offset }: return ByteError.InvalidUtf8 { offset = offset }; break;
        case encoding.EncodingError.AllocationFailure: return ByteError.AllocationFailure; break;
        case encoding.EncodingError.SizeOverflow: return ByteError.SizeOverflow; break;
        default: Never.unreachable(); break;
    }
}
/* Strictly validate all input bytes without allocation; preserve the actual byte error offset.
 * Reject overlong encodings, surrogates, values above U+10FFFF and incomplete sequences.
 * BOM, embedded NUL, unassigned scalars and noncharacters remain valid Unicode content.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> utf8_validate(Slice<byte> input) {
    Result<usize, encoding.EncodingError> validated = encoding.validate_utf8(input);
    switch (move validated) {
        case Result<usize, encoding.EncodingError>.Ok: return Result.ok(Unit.value()); break;
        case Result<usize, encoding.EncodingError>.Err { encoding.EncodingError reason = error }: return Result.err(utf8_error(reason)); break;
    }
}
/* Validate and copy complete UTF-8 into an independent owned string; report byte offsets before allocation.
 * O(n) validation plus owned copying; the underlying string.from_utf8 validates again, so input can be scanned twice.
 * No temporary scalar vector, normalization, replacement, implicit BOM or terminator is added.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<string, ByteError> decode_utf8(Slice<byte> input) {
    Result<string, encoding.EncodingError> decoded = encoding.decode_utf8(input);
    switch (move decoded) {
        case Result<string, encoding.EncodingError>.Ok { string text = value }: return Result.ok(text); break;
        case Result<string, encoding.EncodingError>.Err { encoding.EncodingError reason = error }: return Result.err(utf8_error(reason)); break;
    }
}
/* Allocate an independent copy of validated text bytes, without a trailing NUL or implicit BOM.
 * O(n) byte copying with one reserved buffer; source text ownership and contents remain unchanged.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<byte>, ByteError> encode_utf8(string_view input) { return from_slice(string.as_bytes(input)); }
