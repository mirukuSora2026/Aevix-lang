u128 wide_unsigned_max() { return 340282366920938463463374607431768211455u128; }
Result<u128, ByteError> read_wide(Slice<byte> input, usize offset, bool little) {
    check_range(Slice.len(input), offset, 16)?;
    mut u128 output = 0;
    mut usize index = 0;
    while (index < 16) {
        usize position = little ? offset + 15 - index : offset + index;
        output = (output << 8) | represent<u128>(Byte.to_u8(input[position]));
        index++;
    }
    return Result.ok(output);
}
Result<usize, ByteError> write_wide(MutSlice<byte> output, usize offset, u128 value, bool little) {
    check_range(Slice.len(&output), offset, 16)?;
    mut u128 remaining = value;
    mut usize index = 0;
    while (index < 16) {
        usize position = little ? offset + index : offset + 15 - index;
        output[position] = Byte.from_u8(represent<u8>(remaining & 255u128));
        remaining = remaining >> 8;
        index++;
    }
    return Result.ok(16usize);
}
i128 signed_wide(u128 raw) {
    if (raw <= 170141183460469231731687303715884105727u128) return represent<i128>(raw);
    i128 complement = represent<i128>(wide_unsigned_max() - raw);
    return -complement - 1i128;
}
u128 unsigned_wide(i128 value) {
    if (value >= 0i128) return represent<u128>(value);
    i128 complement = -(value + 1i128);
    return wide_unsigned_max() - represent<u128>(complement);
}
