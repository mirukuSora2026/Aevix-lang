public u32 leading_zeros(byte value) {
    mut u32 raw = represent<u32>(Byte.to_u8(value));
    mut u32 count = 0;
    while (count < 8u32 && (raw & 128u32) == 0u32) { raw = (raw << 1) & 255u32; count++; }
    return count;
}
