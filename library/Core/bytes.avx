 * @deprecated_at none
 * @removed_at none
 */
public bool is_all_ones(byte value) { return Byte.to_u8(value) == 255u8; }
/* Count set positions; at most eight iterations, no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_ones(byte value) {
