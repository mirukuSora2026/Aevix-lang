/*
 * Synchronous bounded byte operations. Integer and floating codecs use explicit little or big endian,
 * accept unaligned positions, and validate the complete range before any write.
 * byte remains distinct from u8. No operation accesses a raw pointer or native handle.
 * Floating codecs preserve representation bits without numeric conversion or NaN canonicalization.
 * Hex text is strict ASCII without prefixes, separators or whitespace.
 * @module bytes
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public import ordering { Ordering };
import error { Error };
import encoding;

/* Byte offsets and lengths identify the original input or destination buffer.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public enum ByteError implements Copy, Error {
    /* The complete requested range is outside the initialized buffer. No write occurred.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    OutOfBounds { /*
 * Version history for the bytes.ByteError.OutOfBounds.offset public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize offset; /*
 * Version history for the bytes.ByteError.OutOfBounds.width public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize width; /*
 * Version history for the bytes.ByteError.OutOfBounds.length public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize length; };
    /* Hex decoding requires an even length; parsing one byte requires exactly two digits.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidHexLength { /*
 * Version history for the bytes.ByteError.InvalidHexLength.length public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize length; };
    /* The first invalid ASCII hex byte, measured in UTF-8 input bytes.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidHexDigit { /*
 * Version history for the bytes.ByteError.InvalidHexDigit.offset public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize offset; };
    /* Output allocation failed. Any temporary buffer has been cleaned.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    AllocationFailure;
    /* The required output length is not representable.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    SizeOverflow;
    /* The count is outside the supported 0..7 checked-shift range.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidShift { /*
 * Version history for the bytes.ByteError.InvalidShift.count public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count; };
    /* The bit index is outside 0..7. Bit zero is least significant.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidBitIndex { /*
 * Version history for the bytes.ByteError.InvalidBitIndex.index public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 index; };
    /* start must be at most 8 and width must be at most 8-start.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidBitRange { /*
 * Version history for the bytes.ByteError.InvalidBitRange.start public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 start; /*
 * Version history for the bytes.ByteError.InvalidBitRange.width public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 width; };
    /* The right-aligned field does not fit in the requested width; it is never truncated.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    FieldOutOfRange { /*
 * Version history for the bytes.ByteError.FieldOutOfRange.field public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte field; /*
 * Version history for the bytes.ByteError.FieldOutOfRange.width public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 width; };
    /* A nibble exceeds 15; position 0 denotes high and position 1 denotes low.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidNibble { /*
 * Version history for the bytes.ByteError.InvalidNibble.value public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte value; /*
 * Version history for the bytes.ByteError.InvalidNibble.position public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 position; };
    /* Binary parsing requires exactly eight ASCII digits.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidBinaryLength { /*
 * Version history for the bytes.ByteError.InvalidBinaryLength.length public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize length; };
    /* The first byte outside ASCII 0/1, measured in UTF-8 input bytes.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidBinaryDigit { /*
 * Version history for the bytes.ByteError.InvalidBinaryDigit.offset public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize offset; };
    /* Buffer extents require an ascending range with a unit step, even when empty.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    NonContiguousRange;
    /* An ascending iteration may be empty, but a reversed buffer extent is rejected as a likely mistake.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    ReversedRange { /*
 * Version history for the bytes.ByteError.ReversedRange.start public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize start; /*
 * Version history for the bytes.ByteError.ReversedRange.end public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize end; };
    /* Equal-length copy requires the full source to match the initialized destination length.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    LengthMismatch { /*
 * Version history for the bytes.ByteError.LengthMismatch.expected public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize expected; /*
 * Version history for the bytes.ByteError.LengthMismatch.actual public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize actual; };
    /* A strict UTF-8 decoder reports the actual invalid or incomplete sequence byte position.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidUtf8 { /*
 * Version history for the bytes.ByteError.InvalidUtf8.offset public API.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize offset; };
    /* Return a static inspection code without allocating.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&Self self) {
        switch (*self) {
            case ByteError.OutOfBounds: return "bytes.out_of_bounds"; break;
            case ByteError.InvalidHexLength: return "bytes.invalid_hex_length"; break;
            case ByteError.InvalidHexDigit: return "bytes.invalid_hex_digit"; break;
            case ByteError.AllocationFailure: return "bytes.allocation_failure"; break;
            case ByteError.SizeOverflow: return "bytes.size_overflow"; break;
            case ByteError.InvalidShift: return "bytes.invalid_shift"; break;
            case ByteError.InvalidBitIndex: return "bytes.invalid_bit_index"; break;
            case ByteError.InvalidBitRange: return "bytes.invalid_bit_range"; break;
            case ByteError.FieldOutOfRange: return "bytes.field_out_of_range"; break;
            case ByteError.InvalidNibble: return "bytes.invalid_nibble"; break;
            case ByteError.InvalidBinaryLength: return "bytes.invalid_binary_length"; break;
            case ByteError.InvalidBinaryDigit: return "bytes.invalid_binary_digit"; break;
            case ByteError.NonContiguousRange: return "bytes.non_contiguous_range"; break;
            case ByteError.ReversedRange: return "bytes.reversed_range"; break;
            case ByteError.LengthMismatch: return "bytes.length_mismatch"; break;
            case ByteError.InvalidUtf8: return "bytes.invalid_utf8"; break;
        }
    }
    /* Return a static description without retaining any input.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&Self self) {
        switch (*self) {
            case ByteError.OutOfBounds: return "The complete byte range is outside the initialized buffer."; break;
            case ByteError.InvalidHexLength: return "Hex input has an invalid number of ASCII digits."; break;
            case ByteError.InvalidHexDigit: return "Hex input contains a byte outside ASCII 0-9, a-f and A-F."; break;
            case ByteError.AllocationFailure: return "Byte output storage could not be allocated."; break;
            case ByteError.SizeOverflow: return "Byte output exceeds the supported buffer length."; break;
            case ByteError.InvalidShift: return "A checked byte shift count must be between zero and seven."; break;
            case ByteError.InvalidBitIndex: return "A byte bit index must be between zero and seven."; break;
            case ByteError.InvalidBitRange: return "The complete bit range must be contained in eight bits."; break;
            case ByteError.FieldOutOfRange: return "The supplied field does not fit in the requested bit width."; break;
            case ByteError.InvalidNibble: return "Both nibble inputs must fit in four bits."; break;
            case ByteError.InvalidBinaryLength: return "Binary input must contain exactly eight ASCII digits."; break;
            case ByteError.InvalidBinaryDigit: return "Binary input contains a byte other than ASCII zero or one."; break;
            case ByteError.NonContiguousRange: return "A byte buffer extent must use an ascending range with a unit step."; break;
            case ByteError.ReversedRange: return "A byte buffer extent must not end before it starts."; break;
            case ByteError.LengthMismatch: return "Byte source and destination slices must have equal initialized lengths."; break;
            case ByteError.InvalidUtf8: return "Byte input contains an invalid or incomplete UTF-8 sequence."; break;
        }
    }
};

T represent<T, U>(U value) {
    Result<T, IntegerError> converted = Integer.convert<T>(value);
    switch (move converted) {
        case Result<T, IntegerError>.Ok { T output = value }: return output; break;
        case Result<T, IntegerError>.Err: Never.unreachable(); break;
    }
}
Result<unit, ByteError> check_range(usize length, usize offset, usize width) {
    if (offset > length || width > length - offset)
        return Result.err(ByteError.OutOfBounds { offset = offset, width = width, length = length });
    return Result.ok(Unit.value());
}
Result<u64, ByteError> read_unsigned(Slice<byte> input, usize offset, usize width, bool little) {
    check_range(Slice.len(input), offset, width)?;
    mut u64 output = 0;
    mut usize index = 0;
    while (index < width) {
        usize position = little ? offset + width - 1 - index : offset + index;
        output = (output << 8) | represent<u64>(Byte.to_u8(input[position]));
        index++;
    }
    return Result.ok(output);
}
Result<usize, ByteError> write_unsigned(MutSlice<byte> output, usize offset, usize width, u64 value, bool little) {
    check_range(Slice.len(&output), offset, width)?;
    mut u64 remaining = value;
    mut usize index = 0;
    while (index < width) {
        usize position = little ? offset + index : offset + width - 1 - index;
        output[position] = Byte.from_u8(represent<u8>(remaining & 255u64));
        remaining = remaining >> 8;
        index++;
    }
    return Result.ok(width);
}
Result<Vector<byte>, ByteError> allocate_capacity(usize capacity) {
    Result<Vector<byte>, CollectionError> created = [];
    switch (move created) {
        case Result<Vector<byte>, CollectionError>.Ok { Vector<byte> empty = value }:
            mut Vector<byte> output = empty;
            Result<unit, CollectionError> reserved = Vector.reserve(&mut output, capacity);
            switch (move reserved) {
                case Result<unit, CollectionError>.Ok: return Result.ok(output); break;
                case Result<unit, CollectionError>.Err { CollectionError reason = error }:
                    switch (reason) {
                        case CollectionError.AllocationFailure: return Result.err(ByteError.AllocationFailure); break;
                        case CollectionError.SizeOverflow: return Result.err(ByteError.SizeOverflow); break;
                    }
                    break;
            }
            break;
        case Result<Vector<byte>, CollectionError>.Err { CollectionError reason = error }:
            switch (reason) {
                case CollectionError.AllocationFailure: return Result.err(ByteError.AllocationFailure); break;
                case CollectionError.SizeOverflow: return Result.err(ByteError.SizeOverflow); break;
            }
            break;
    }
}
Result<unit, ByteError> append_byte(&mut Vector<byte> output, byte value) {
    Result<unit, InputError<byte>> added = Vector.push(output, value);
    switch (move added) {
        case Result<unit, InputError<byte>>.Ok: return Result.ok(Unit.value()); break;
        case Result<unit, InputError<byte>>.Err { InputError<byte> reason = error }:
            switch (reason) {
                case InputError<byte>.AllocationFailure: return Result.err(ByteError.AllocationFailure); break;
                case InputError<byte>.SizeOverflow: return Result.err(ByteError.SizeOverflow); break;
                case InputError<byte>.OutOfBounds: Never.unreachable(); break;
            }
            break;
    }
}
Result<string, ByteError> ascii_string(Slice<byte> input) {
    Result<string, TextError> converted = string.from_utf8(input);
    switch (move converted) {
        case Result<string, TextError>.Ok { string output = value }: return Result.ok(output); break;
        case Result<string, TextError>.Err { TextError reason = error }:
            switch (reason) {
                case TextError.AllocationFailure: return Result.err(ByteError.AllocationFailure); break;
                case TextError.SizeOverflow: return Result.err(ByteError.SizeOverflow); break;
                default: Never.unreachable(); break;
            }
            break;
    }
}
i32 hex_value(u8 value) {
    if (value >= 48u8 && value <= 57u8) return represent<i32>(value - 48u8);
    if (value >= 65u8 && value <= 70u8) return represent<i32>(value - 65u8) + 10;
    if (value >= 97u8 && value <= 102u8) return represent<i32>(value - 97u8) + 10;
    return -1;
}
byte hex_digit(u8 value, bool uppercase) {
    if (value < 10u8) return Byte.from_u8(value + 48u8);
    return Byte.from_u8(value - 10u8 + (uppercase ? 65u8 : 97u8));
}
bool matches_at(Slice<byte> input, Slice<byte> needle, usize offset) {
    if (offset > Slice.len(input) || Slice.len(needle) > Slice.len(input) - offset) return false;
    mut usize index = 0;
    while (index < Slice.len(needle)) {
        if (Byte.to_u8(input[offset + index]) != Byte.to_u8(needle[index])) return false;
        index++;
    }
    return true;
}

/* Copy one byte value or return None for an invalid offset; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Optional<byte> get(Slice<byte> input, usize offset) {
    if (offset >= Slice.len(input)) return Optional.none();
    return Optional.some(input[offset]);
}
/* Validate the offset before replacing one initialized byte; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<unit, ByteError> set(MutSlice<byte> output, usize offset, byte value) {
    check_range(Slice.len(&output), offset, 1)?;
    output[offset] = value;
    return Result.ok(Unit.value());
}
/* Return initialized length; O(1), no allocation or ownership transfer.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize len(Slice<byte> input) { return Slice.len(input); }
/* Test initialized length; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_empty(Slice<byte> input) { return Slice.len(input) == 0; }
/* Fill the initialized exclusive view; O(n), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public unit fill(MutSlice<byte> output, byte value) {
    mut usize index = 0;
    while (index < Slice.len(&output)) { output[index] = value; index++; }
    return Unit.value();
}
/* Return the first matching byte offset; O(n), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Optional<usize> find(Slice<byte> input, byte value) {
    mut usize index = 0;
    while (index < Slice.len(input)) {
        if (Byte.to_u8(input[index]) == Byte.to_u8(value)) return Optional.some(index);
        index++;
    }
    return Optional.none();
}
/* Return the first subsequence match; an empty needle matches zero.
 * Worst-case O((n-m+1)*m) comparisons and O(1) extra storage; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Optional<usize> find_subsequence(Slice<byte> input, Slice<byte> needle) {
    if (Slice.len(needle) > Slice.len(input)) return Optional.none();
    usize last = Slice.len(input) - Slice.len(needle);
    mut usize offset = 0;
    while (true) {
        if (matches_at(input, needle, offset)) return Optional.some(offset);
        if (offset == last) return Optional.none();
        offset++;
    }
}
/* Test a byte prefix without interpreting UTF-8; O(m), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool starts_with(Slice<byte> input, Slice<byte> prefix) { return matches_at(input, prefix, 0); }
/* Test a byte suffix without interpreting UTF-8; O(m), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool ends_with(Slice<byte> input, Slice<byte> suffix) {
    if (Slice.len(suffix) > Slice.len(input)) return false;
    return matches_at(input, suffix, Slice.len(input) - Slice.len(suffix));
}

/* Parse exactly two ASCII hex digits into one byte; O(1), no allocation.
 * Invalid length takes precedence; otherwise report the first invalid byte offset.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> parse_hex(string_view text) {
    Slice<byte> input = string.as_bytes(text);
    if (Slice.len(input) != 2) return Result.err(ByteError.InvalidHexLength { length = Slice.len(input) });
    i32 high = hex_value(Byte.to_u8(input[0]));
    if (high < 0) return Result.err(ByteError.InvalidHexDigit { offset = 0 });
    i32 low = hex_value(Byte.to_u8(input[1]));
    if (low < 0) return Result.err(ByteError.InvalidHexDigit { offset = 1 });
    return Result.ok(Byte.from_u8(represent<u8>(high * 16 + low)));
}
/* Decode an even number of ASCII hex digits. Validate the entire input before allocation.
 * O(n) time and n/2 output bytes; no prefix, whitespace, separators or implicit text conversion.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<byte>, ByteError> decode_hex(string_view text) {
    Slice<byte> input = string.as_bytes(text);
    usize length = Slice.len(input);
    if (length % 2 != 0) return Result.err(ByteError.InvalidHexLength { length = length });
    mut usize index = 0;
    while (index < length) {
        if (hex_value(Byte.to_u8(input[index])) < 0) return Result.err(ByteError.InvalidHexDigit { offset = index });
        index++;
    }
    mut Vector<byte> output = allocate_capacity(length / 2)?;
    index = 0;
    while (index < length) {
        i32 high = hex_value(Byte.to_u8(input[index]));
        i32 low = hex_value(Byte.to_u8(input[index + 1]));
        append_byte(&mut output, Byte.from_u8(represent<u8>(high * 16 + low)))?;
        index += 2;
    }
    return Result.ok(output);
}
/* Write two ASCII hex digits only after validating the full destination capacity.
 * Return 2; leave trailing bytes unchanged; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize, ByteError> format_hex_into(byte value, MutSlice<byte> output, bool uppercase) {
    check_range(Slice.len(&output), 0, 2)?;
    u8 raw = Byte.to_u8(value);
    output[0] = hex_digit(raw >> 4, uppercase);
    output[1] = hex_digit(raw & 15u8, uppercase);
    return Result.ok(2usize);
}
/* Allocate a two-digit ASCII string. Inline temporary bytes require no heap buffer.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<string, ByteError> format_hex(byte value, bool uppercase) {
    mut byte output[2] = [Byte.from_u8(0u8), Byte.from_u8(0u8)];
    format_hex_into(value, Slice.from_array_mut(&mut output), uppercase)?;
    return ascii_string(Slice.from_array(&output));
}
/* Encode two ASCII digits per input byte after checking output length multiplication.
 * O(n) time; explicitly allocate a temporary 2*n byte buffer and then the owned string.
 * Both empty input and empty output are supported; no source buffer is retained.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<string, ByteError> encode_hex(Slice<byte> input, bool uppercase) {
    usize length = Slice.len(input);
    if (length > 9223372036854775807usize) return Result.err(ByteError.SizeOverflow);
    mut Vector<byte> output = allocate_capacity(length * 2)?;
    mut usize index = 0;
    while (index < length) {
        u8 raw = Byte.to_u8(input[index]);
        append_byte(&mut output, hex_digit(raw >> 4, uppercase))?;
        append_byte(&mut output, hex_digit(raw & 15u8, uppercase))?;
        index++;
    }
    return ascii_string(Slice.from_vector(&output));
}

/* Read 1 unaligned unsigned byte; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8, ByteError> read_u8(Slice<byte> input, usize offset) {
    u64 raw = read_unsigned(input, offset, 1, true)?;
    return Result.ok(represent<u8>(raw));
}
/* Validate all 1 destination byte before writing unsigned representation.
 * Return 1; no alignment requirement, allocation or partial write on bounds failure.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize, ByteError> write_u8(MutSlice<byte> output, usize offset, u8 value) {
    return write_unsigned(output, offset, 1, represent<u64>(value), true);
}

/* Read 1 unaligned two's-complement signed byte; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8, ByteError> read_i8(Slice<byte> input, usize offset) {
    u64 raw = read_unsigned(input, offset, 1, true)?;
    i128 wide = represent<i128>(raw);
    return Result.ok(represent<i8>(wide >= 128i128 ? wide - 256i128 : wide));
}
/* Validate all 1 destination byte before writing two's-complement signed representation.
 * Return 1; no alignment requirement, allocation or partial write on bounds failure.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize, ByteError> write_i8(MutSlice<byte> output, usize offset, i8 value) {
    i128 wide = represent<i128>(value);
    return write_unsigned(output, offset, 1, represent<u64>(wide < 0i128 ? wide + 256i128 : wide), true);
}

/* Read 2 unaligned unsigned bytes in little endian; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16, ByteError> read_u16_le(Slice<byte> input, usize offset) {
    u64 raw = read_unsigned(input, offset, 2, true)?;
    return Result.ok(represent<u16>(raw));
}
/* Validate all 2 destination bytes before writing unsigned representation in little endian.
 * Return 2; no alignment requirement, allocation or partial write on bounds failure.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize, ByteError> write_u16_le(MutSlice<byte> output, usize offset, u16 value) {
    return write_unsigned(output, offset, 2, represent<u64>(value), true);
}

/* Read 2 unaligned unsigned bytes in big endian; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16, ByteError> read_u16_be(Slice<byte> input, usize offset) {
    u64 raw = read_unsigned(input, offset, 2, false)?;
    return Result.ok(represent<u16>(raw));
}
/* Validate all 2 destination bytes before writing unsigned representation in big endian.
 * Return 2; no alignment requirement, allocation or partial write on bounds failure.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize, ByteError> write_u16_be(MutSlice<byte> output, usize offset, u16 value) {
