/* Intersect exact eight-bit patterns; O(1), no allocation or numeric arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte bit_and(byte left, byte right) { return Byte.from_u8(Byte.to_u8(left) & Byte.to_u8(right)); }
/* Union exact eight-bit patterns; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte bit_or(byte left, byte right) { return Byte.from_u8(Byte.to_u8(left) | Byte.to_u8(right)); }
/* Toggle positions present in exactly one pattern; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte bit_xor(byte left, byte right) { return Byte.from_u8(Byte.to_u8(left) ^ Byte.to_u8(right)); }
/* Invert exactly eight value bits; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte bit_not(byte value) { return Byte.from_u8(Byte.to_u8(value) ^ 255u8); }
/* Keep left bits absent from right; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte bit_and_not(byte left, byte right) { return bit_and(left, bit_not(right)); }
