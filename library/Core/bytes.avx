public u32 leading_ones(byte value) { return leading_zeros(bit_not(value)); }
/* Count low zero positions; zero has eight; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_zeros(byte value) {
    mut u32 raw = represent<u32>(Byte.to_u8(value));
    mut u32 count = 0;
    while (count < 8u32 && (raw & 1u32) == 0u32) { raw = raw >> 1; count++; }
    return count;
}
/* Count low one positions; the all-one pattern has eight; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_ones(byte value) { return trailing_zeros(bit_not(value)); }
/* Return zero for zero, otherwise the highest set position plus one; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 bit_length(byte value) { return 8u32 - leading_zeros(value); }
/* Test odd set-bit parity; at most eight iterations, no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool parity_odd(byte value) { return count_ones(value) % 2u32 != 0u32; }
/* Reverse eight bit positions, not byte order; exactly eight iterations, no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte reverse_bits(byte value) {
    mut u32 raw = represent<u32>(Byte.to_u8(value));
    mut u32 output = 0;
    mut u32 count = 0;
    while (count < 8u32) { output = (output << 1) | (raw & 1u32); raw = raw >> 1; count++; }
    return Byte.from_u8(represent<u8>(output));
