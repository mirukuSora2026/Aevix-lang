/* Rotate modulo eight in the opposite direction; O(1), no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte rotate_right(byte value, u32 count) {
    u32 shift = count % 8u32;
    u32 raw = represent<u32>(Byte.to_u8(value));
