/* Require count 0..7, discard high bits, and fill low positions with zero; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte, ByteError> shift_left(byte value, u32 count) {
    if (count >= 8u32) return Result.err(ByteError.InvalidShift { count = count });
    u32 raw = represent<u32>(Byte.to_u8(value));
    return Result.ok(Byte.from_u8(represent<u8>((raw << count) & 255u32)));
