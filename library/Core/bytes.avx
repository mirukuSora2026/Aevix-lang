 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte zero() { return Byte.from_u8(0u8); }
/* Return the all-one eight-bit pattern; no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public byte ones() { return Byte.from_u8(255u8); }
