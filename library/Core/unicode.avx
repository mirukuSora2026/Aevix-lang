/*
 * Allocate Unicode 17 default isolated-scalar full case_fold. Only unconditional SpecialCasing rules apply; normalization and contextual/Turkic casing are separate. Errors use UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<string,UnicodeError> case_fold(char c){return ucd_full_case(c,ucd_full_case_fold_data(),ucd_full_case_fold_pool_data());}
Result<string,UnicodeError> ucd_full_case(char c,string_view table,string_view pool){
    Slice<byte> index=string.as_bytes(table);usize at=ucd_sparse(table,Char.to_u32(c),10usize);
    mut byte output[12]=[Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8)];
    mut usize used=0usize;
    if(at==Slice.len(index)){used=encode_utf8_into(c,Slice.from_array_mut(&mut output))?;}
    else{
        usize offset=represent<usize>(ucd_unpack(index,at+4usize,4usize));usize count=represent<usize>(ucd_unpack(index,at+8usize,2usize));
        Slice<byte> sequences=string.as_bytes(pool);mut usize item=0usize;
        while(item<count){char mapped=scalar(ucd_unpack(sequences,offset+item*4usize,4usize));MutSlice<byte> storage=Slice.from_array_mut(&mut output);MutSlice<byte> tail=proven(Slice.slice_mut(storage,used,12usize));used+=encode_utf8_into(mapped,tail)?;item++;}
    }
    return own_bytes(proven(Slice.slice(Slice.from_array(&output),0usize,used)));
}
