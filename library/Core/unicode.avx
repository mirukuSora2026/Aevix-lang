string_view ucd_part(string_view input,usize offset,usize length){return proven(string.slice_bytes(input,offset,offset+length));}
Optional<string_view> ucd_algorithmic_prefix(u32 code){
if(code>=13312u32&&code<=19903u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=19968u32&&code<=40959u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=94208u32&&code<=100351u32)return Optional.some("TANGUT IDEOGRAPH-");
if(code>=101632u32&&code<=101662u32)return Optional.some("TANGUT IDEOGRAPH-");
if(code>=131072u32&&code<=173791u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=173824u32&&code<=177983u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=177984u32&&code<=178205u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=178208u32&&code<=183981u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=183984u32&&code<=191456u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=191472u32&&code<=192093u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=196608u32&&code<=201546u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=201552u32&&code<=205743u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
if(code>=205744u32&&code<=210041u32)return Optional.some("CJK UNIFIED IDEOGRAPH-");
return Optional.none();}
Result<string,UnicodeError> ucd_algorithmic_name(u32 code,string_view prefix){
    mut byte buffer[40]=[Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8)];
    Slice<byte> front=string.as_bytes(prefix);usize length=Slice.len(front);mut usize at=0usize;
    while(at<length){buffer[at]=front[at];at++;}
    usize digits=code<65536u32?4usize:(code<1048576u32?5usize:6usize);
    mut usize position=0usize;
    while(position<digits){usize shift=(digits-position-1usize)*4usize;u32 nibble=(code>>shift)&15u32;buffer[length+position]=Byte.from_u8(represent<u8>(nibble<10u32?nibble+48u32:nibble+55u32));position++;}
    return own_bytes(proven(Slice.slice(Slice.from_array(&buffer),0usize,length+digits)));
}
u8 ucd_ascii_upper(u8 value){if(value>=97u8&&value<=122u8)return value-32u8;return value;}
i32 ucd_compare_name(Slice<byte> input,Slice<byte> pool,usize offset,usize length){
    usize input_length=Slice.len(input);mut usize at=0usize;
    while(at<input_length&&at<length){u8 left=ucd_ascii_upper(Byte.to_u8(input[at]));u8 right=Byte.to_u8(pool[offset+at]);if(left<right)return -1;if(left>right)return 1;at++;}
    if(input_length<length)return -1;if(input_length>length)return 1;return 0;
}
bool ucd_prefix_equal(Slice<byte> input,Slice<byte> prefix){
    usize length=Slice.len(prefix);if(Slice.len(input)<length)return false;mut usize index=0usize;
    while(index<length){if(ucd_ascii_upper(Byte.to_u8(input[index]))!=Byte.to_u8(prefix[index]))return false;index++;}return true;
}
Optional<char> ucd_lookup_algorithmic(Slice<byte> input,string_view prefix){
    Slice<byte> front=string.as_bytes(prefix);usize start=Slice.len(front);usize length=Slice.len(input);
    if(!ucd_prefix_equal(input,front)||length<start+4usize||length>start+6usize)return Optional.none();
    mut u32 code=0u32;mut usize offset=start;
    while(offset<length){i32 digit=hex_value(Byte.to_u8(input[offset]));if(digit<0)return Optional.none();code=(code<<4)|represent<u32>(digit);offset++;}
    usize digits=code<65536u32?4usize:(code<1048576u32?5usize:6usize);
    if(length!=start+digits)return Optional.none();
    Optional<string_view> actual=ucd_algorithmic_prefix(code);
    switch(actual){case Optional<string_view>.Some {string_view expected=value}:if(string.equals(expected,prefix))return Optional.some(scalar(code));return Optional.none();break;case Optional<string_view>.None:return Optional.none();break;}
}
/*
 * Allocate the canonical Unicode 17 name, including algorithmic Hangul/CJK/Tangut names. Controls, private-use and unnamed/unassigned scalars return None. Allocation errors use UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Optional<string>,UnicodeError> name(char c){
    u32 code=Char.to_u32(c);Optional<string_view> algorithmic=ucd_algorithmic_prefix(code);
    switch(algorithmic){case Optional<string_view>.Some {string_view prefix=value}:return Result.ok(Optional.some(ucd_algorithmic_name(code,prefix)?));break;case Optional<string_view>.None:break;}
    string_view table=ucd_name_index_data();Slice<byte> index=string.as_bytes(table);usize at=ucd_sparse(table,code,10usize);
    if(at==Slice.len(index))return Result.ok(Optional.none());
    usize offset=represent<usize>(ucd_unpack(index,at+4usize,4usize));usize length=represent<usize>(ucd_unpack(index,at+8usize,2usize));
    return Result.ok(Optional.some(own_bytes(string.as_bytes(ucd_part(ucd_name_pool_data(),offset,length)))?));
}
/*
 * Resolve canonical names and all five formal Name_Alias kinds. ASCII letter case is ignored; spaces and hyphens are exact, preserving Hangul OE/O-E distinctions. Unknown or noncanonical spellings return InvalidSyntax at byte zero; no allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<char,UnicodeError> lookup_name(string_view name){
    Slice<byte> input=string.as_bytes(name);usize length=Slice.len(input);mut usize offset=0usize;
    while(offset<length){if(Byte.to_u8(input[offset])>127u8)return Result.err(UnicodeError.InvalidSyntax {offset=0usize});offset++;}
    Slice<byte> index=string.as_bytes(ucd_name_lookup_data());Slice<byte> pool=string.as_bytes(ucd_name_pool_data());
    mut usize low=0usize;mut usize high=Slice.len(index)/10usize;
    while(low<high){usize middle=low+(high-low)/2usize;usize at=middle*10usize;usize start=represent<usize>(ucd_unpack(index,at,4usize));usize size=represent<usize>(ucd_unpack(index,at+4usize,2usize));i32 compared=ucd_compare_name(input,pool,start,size);if(compared>0)low=middle+1usize;else if(compared<0)high=middle;else return Result.ok(scalar(ucd_unpack(index,at+6usize,4usize)));}
Optional<char> found_cjk=ucd_lookup_algorithmic(input,"CJK UNIFIED IDEOGRAPH-");
switch(found_cjk){case Optional<char>.Some {char found=value}:return Result.ok(found);break;case Optional<char>.None:break;}
Optional<char> found_tangut=ucd_lookup_algorithmic(input,"TANGUT IDEOGRAPH-");
switch(found_tangut){case Optional<char>.Some {char found=value}:return Result.ok(found);break;case Optional<char>.None:break;}
return Result.err(UnicodeError.InvalidSyntax {offset=0usize});}
/*
 * Allocate all formal Name_Alias strings in pinned file order, retaining each alias kind represented in that data. The vector is empty when absent; allocation errors preserve cleanup of earlier entries.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<string>,UnicodeError> name_aliases(char c){
    Result<Vector<string>,CollectionError> empty=[];mut Vector<string> output=proven(empty);
    string_view table=ucd_alias_index_data();Slice<byte> index=string.as_bytes(table);usize at=ucd_sparse(table,Char.to_u32(c),10usize);
    if(at==Slice.len(index))return Result.ok(output);
    usize start=represent<usize>(ucd_unpack(index,at+4usize,4usize));usize count=represent<usize>(ucd_unpack(index,at+8usize,2usize));Slice<byte> aliases=string.as_bytes(ucd_alias_pool_data());
    mut usize item=0usize;while(item<count){usize offset=represent<usize>(ucd_unpack(aliases,start+item*6usize,4usize));usize length=represent<usize>(ucd_unpack(aliases,start+item*6usize+4usize,2usize));string owned=own_bytes(string.as_bytes(ucd_part(ucd_name_pool_data(),offset,length)))?;ucd_push_name(&mut output,owned)?;item++;}
    return Result.ok(output);
}
Result<unit,UnicodeError> ucd_push_name(&mut Vector<string> output,string value){
    Result<unit,InputError<string>> appended=Vector.push(output,value);
    switch(move appended){case Result<unit,InputError<string>>.Ok:return Result.ok(Unit.value());break;case Result<unit,InputError<string>>.Err {InputError<string> cause=error}:switch(move cause){case InputError<string>.SizeOverflow:return Result.err(UnicodeError.SizeOverflow);break;case InputError<string>.AllocationFailure:return Result.err(UnicodeError.AllocationFailure);break;default:Never.unreachable();break;}break;}
}
/*
 * Borrow the exact Unicode release identifier for these immutable source tables; no locale or runtime database is consulted.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public string_view unicode_version(){return "17.0.0";}
/*
 * Borrow the SHA-256 of the canonical input/license/table manifest; table encoding and policy are reproducible from pinned inputs.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public string_view ucd_fingerprint(){return "sha256:bc5030fabc46f618b8af92c08c7b1b71f175b26337b48de61b047b6958662de5";}
