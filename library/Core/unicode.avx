LineBreak ucd_LineBreak(u32 value){switch(value){
case 0u32:return LineBreak.Aksara;break;
case 1u32:return LineBreak.AksaraPrebase;break;
case 2u32:return LineBreak.AksaraStart;break;
case 3u32:return LineBreak.Alphabetic;break;
case 4u32:return LineBreak.Ambiguous;break;
case 5u32:return LineBreak.BreakAfter;break;
case 6u32:return LineBreak.BreakBefore;break;
case 7u32:return LineBreak.BreakBoth;break;
case 8u32:return LineBreak.BreakSymbols;break;
case 9u32:return LineBreak.CarriageReturn;break;
case 10u32:return LineBreak.CloseParenthesis;break;
case 11u32:return LineBreak.ClosePunctuation;break;
case 12u32:return LineBreak.CombiningMark;break;
case 13u32:return LineBreak.ComplexContext;break;
case 14u32:return LineBreak.ConditionalJapaneseStarter;break;
case 15u32:return LineBreak.ContingentBreak;break;
case 16u32:return LineBreak.EBase;break;
case 17u32:return LineBreak.EModifier;break;
case 18u32:return LineBreak.Exclamation;break;
case 19u32:return LineBreak.Glue;break;
case 20u32:return LineBreak.H2;break;
case 21u32:return LineBreak.H3;break;
case 22u32:return LineBreak.HebrewLetter;break;
case 23u32:return LineBreak.Hyphen;break;
case 24u32:return LineBreak.Ideographic;break;
case 25u32:return LineBreak.InfixNumeric;break;
case 26u32:return LineBreak.Inseparable;break;
case 27u32:return LineBreak.JL;break;
case 28u32:return LineBreak.JT;break;
case 29u32:return LineBreak.JV;break;
case 30u32:return LineBreak.LineFeed;break;
case 31u32:return LineBreak.MandatoryBreak;break;
case 32u32:return LineBreak.NextLine;break;
case 33u32:return LineBreak.Nonstarter;break;
case 34u32:return LineBreak.Numeric;break;
case 35u32:return LineBreak.OpenPunctuation;break;
case 36u32:return LineBreak.PostfixNumeric;break;
case 37u32:return LineBreak.PrefixNumeric;break;
case 38u32:return LineBreak.Quotation;break;
case 39u32:return LineBreak.RegionalIndicator;break;
case 40u32:return LineBreak.Space;break;
case 41u32:return LineBreak.Surrogate;break;
case 42u32:return LineBreak.UnambiguousHyphen;break;
case 43u32:return LineBreak.Unknown;break;
case 44u32:return LineBreak.Virama;break;
case 45u32:return LineBreak.ViramaFinal;break;
case 46u32:return LineBreak.WordJoiner;break;
case 47u32:return LineBreak.ZWJ;break;
case 48u32:return LineBreak.ZWSpace;break;
default:Never.unreachable();break;}}
