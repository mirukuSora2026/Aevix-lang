/*
 * Return the pinned Age value, or None for code points without a UCD age.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Optional<UnicodeVersion> age(char c){switch(ucd_find(ucd_age_data(),Char.to_u32(c),2usize)){
case 0u32:return Optional.none();break;
case 1u32:return Optional.some(UnicodeVersion {major=10u8,minor=0u8,patch=0u8});break;
case 2u32:return Optional.some(UnicodeVersion {major=11u8,minor=0u8,patch=0u8});break;
case 3u32:return Optional.some(UnicodeVersion {major=12u8,minor=0u8,patch=0u8});break;
case 4u32:return Optional.some(UnicodeVersion {major=12u8,minor=1u8,patch=0u8});break;
case 5u32:return Optional.some(UnicodeVersion {major=13u8,minor=0u8,patch=0u8});break;
case 6u32:return Optional.some(UnicodeVersion {major=14u8,minor=0u8,patch=0u8});break;
case 7u32:return Optional.some(UnicodeVersion {major=15u8,minor=0u8,patch=0u8});break;
case 8u32:return Optional.some(UnicodeVersion {major=15u8,minor=1u8,patch=0u8});break;
case 9u32:return Optional.some(UnicodeVersion {major=16u8,minor=0u8,patch=0u8});break;
case 10u32:return Optional.some(UnicodeVersion {major=17u8,minor=0u8,patch=0u8});break;
case 11u32:return Optional.some(UnicodeVersion {major=1u8,minor=1u8,patch=0u8});break;
case 12u32:return Optional.some(UnicodeVersion {major=2u8,minor=0u8,patch=0u8});break;
case 13u32:return Optional.some(UnicodeVersion {major=2u8,minor=1u8,patch=0u8});break;
case 14u32:return Optional.some(UnicodeVersion {major=3u8,minor=0u8,patch=0u8});break;
case 15u32:return Optional.some(UnicodeVersion {major=3u8,minor=1u8,patch=0u8});break;
case 16u32:return Optional.some(UnicodeVersion {major=3u8,minor=2u8,patch=0u8});break;
case 17u32:return Optional.some(UnicodeVersion {major=4u8,minor=0u8,patch=0u8});break;
case 18u32:return Optional.some(UnicodeVersion {major=4u8,minor=1u8,patch=0u8});break;
case 19u32:return Optional.some(UnicodeVersion {major=5u8,minor=0u8,patch=0u8});break;
case 20u32:return Optional.some(UnicodeVersion {major=5u8,minor=1u8,patch=0u8});break;
case 21u32:return Optional.some(UnicodeVersion {major=5u8,minor=2u8,patch=0u8});break;
case 22u32:return Optional.some(UnicodeVersion {major=6u8,minor=0u8,patch=0u8});break;
case 23u32:return Optional.some(UnicodeVersion {major=6u8,minor=1u8,patch=0u8});break;
case 24u32:return Optional.some(UnicodeVersion {major=6u8,minor=2u8,patch=0u8});break;
case 25u32:return Optional.some(UnicodeVersion {major=6u8,minor=3u8,patch=0u8});break;
case 26u32:return Optional.some(UnicodeVersion {major=7u8,minor=0u8,patch=0u8});break;
case 27u32:return Optional.some(UnicodeVersion {major=8u8,minor=0u8,patch=0u8});break;
case 28u32:return Optional.some(UnicodeVersion {major=9u8,minor=0u8,patch=0u8});break;
default:Never.unreachable();break;}}
/*
 * Unicode 17 QuickCheck property values; variants have no numeric ABI guarantee.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum QuickCheck implements Copy {
/*
 * The No value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
No;
/*
 * The Maybe value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Maybe;
/*
 * The Yes value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Yes;
};
QuickCheck ucd_QuickCheck(u32 value){switch(value){
case 0u32:return QuickCheck.No;break;
case 1u32:return QuickCheck.Maybe;break;
case 2u32:return QuickCheck.Yes;break;
default:Never.unreachable();break;}}
string_view ucd_nfc_quick_check_data(){return "00000200<00100<50200<60100<=0200<?0100<@0200<A0100<B0200<C0100<E0200<K0100<L0200<S0100<Y0200<]0100<_0200<`0100<b0200<h0100<i0200=00000=20100=30000=50100=60200=d0000=e0200=n0000=o0200>70000>80200IC0100IF0200Tl0100Tm0200UH0000UP0200Vn0100Vo0200WG0100WH0200WL0000WN0200WO0000WP0200Xc0000Xd0200Xf0000Xg0200YI0000YL0200YN0000YO0200\\n0100\\o0200]F0100]H0200]L0000]N0200^n0100^o0200_G0100_H0200aF0100aG0200c20100c30200cE0100cG0200dn0100do0200eG0100eH0200g:0100g;0200g?0100g@0200gO0100gP0200m30000m40200m=0000m>0200mB0000mC0200mG0000mH0200mL0000mM0200mY0000mZ0200mc0000md0200me0000mg0200mh0000mi0200n10000n20200nC0000nD0200nM0000nN0200nR0000nS0200nW0000nX0200n\\0000n]0200ni0000nj02010^01010_02015Q01015f02016X0101730201\\e0101\\f0201ma0001mb0201mc0001md0201me0001mf0201mg0001mh0201mi0001mj0201mk0001ml0201mm0001mn0201nk0001nl0201nn0001no0201o90001o:0201o;0001o<0201oC0001oD0201oK0001oL0201oS0001oT0201o[0001o\\0201o^0001o`0201oi0001oj0201ok0001ol0201om0001on02020000020202024V00024W02024Z00024\\0202<Y0002<[0202[L0002[M02032I01032K020?T0000?X>020?X@000?XA020?XB000?XC020?XE000?XO020?XP000?XQ020?XR000?XS020?XU000?XW020?XZ000?Y^020?Y`000?[J020?\\M000?\\N020?\\O000?\\P020?\\Z000?\\g020?\\h000?\\m020?\\n000?\\o020?]0000?]2020?]3000?]5020?]6000?]?020A2j010A2k020A4W010A4X020A<n010A<o020A=G010A=H020A>h010A>i020A>k010A>l020A?2010A?3020A?5010A?6020A?7010A?:020AB`010ABa020ABj010ABk020ABm010ABn020AF_010AF`020AT`010ATa020F4N010F4Z020FeW010FeY020M5N000M5U020M6k000M71020_P0000_XN02";}
/*
 * Return the scalar Unicode 17 NFC_QC property; whole-string normalization requires additional context.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
