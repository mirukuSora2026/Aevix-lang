/*
 * Return the decimal digit value only for Nd scalars; no allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Optional<u8> decimal_value(char c){u32 value=ucd_find(ucd_decimal_value_data(),Char.to_u32(c),2usize);if(value==10u32)return Optional.none();return Optional.some(represent<u8>(value));}
/*
 * Unicode 17 BidiClass property values; variants have no numeric ABI guarantee.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum BidiClass implements Copy {
/*
 * The ArabicLetter value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
ArabicLetter;
/*
 * The ArabicNumber value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
ArabicNumber;
/*
 * The BoundaryNeutral value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
BoundaryNeutral;
/*
 * The CommonSeparator value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
CommonSeparator;
/*
 * The EuropeanNumber value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
EuropeanNumber;
/*
 * The EuropeanSeparator value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
EuropeanSeparator;
/*
 * The EuropeanTerminator value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
EuropeanTerminator;
/*
 * The FirstStrongIsolate value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
FirstStrongIsolate;
/*
 * The LeftToRight value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LeftToRight;
/*
 * The LeftToRightEmbedding value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LeftToRightEmbedding;
/*
 * The LeftToRightIsolate value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LeftToRightIsolate;
/*
 * The LeftToRightOverride value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LeftToRightOverride;
/*
 * The NonspacingMark value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
NonspacingMark;
/*
 * The OtherNeutral value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
OtherNeutral;
/*
 * The ParagraphSeparator value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
ParagraphSeparator;
/*
 * The PopDirectionalFormat value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
PopDirectionalFormat;
/*
 * The PopDirectionalIsolate value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
PopDirectionalIsolate;
/*
 * The RightToLeft value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
RightToLeft;
/*
 * The RightToLeftEmbedding value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
RightToLeftEmbedding;
/*
 * The RightToLeftIsolate value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
RightToLeftIsolate;
/*
 * The RightToLeftOverride value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
RightToLeftOverride;
/*
 * The SegmentSeparator value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
SegmentSeparator;
/*
 * The WhiteSpace value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
WhiteSpace;
};
BidiClass ucd_BidiClass(u32 value){switch(value){
case 0u32:return BidiClass.ArabicLetter;break;
case 1u32:return BidiClass.ArabicNumber;break;
case 2u32:return BidiClass.BoundaryNeutral;break;
case 3u32:return BidiClass.CommonSeparator;break;
case 4u32:return BidiClass.EuropeanNumber;break;
case 5u32:return BidiClass.EuropeanSeparator;break;
case 6u32:return BidiClass.EuropeanTerminator;break;
case 7u32:return BidiClass.FirstStrongIsolate;break;
case 8u32:return BidiClass.LeftToRight;break;
case 9u32:return BidiClass.LeftToRightEmbedding;break;
case 10u32:return BidiClass.LeftToRightIsolate;break;
case 11u32:return BidiClass.LeftToRightOverride;break;
case 12u32:return BidiClass.NonspacingMark;break;
case 13u32:return BidiClass.OtherNeutral;break;
case 14u32:return BidiClass.ParagraphSeparator;break;
case 15u32:return BidiClass.PopDirectionalFormat;break;
case 16u32:return BidiClass.PopDirectionalIsolate;break;
case 17u32:return BidiClass.RightToLeft;break;
case 18u32:return BidiClass.RightToLeftEmbedding;break;
case 19u32:return BidiClass.RightToLeftIsolate;break;
case 20u32:return BidiClass.RightToLeftOverride;break;
case 21u32:return BidiClass.SegmentSeparator;break;
case 22u32:return BidiClass.WhiteSpace;break;
default:Never.unreachable();break;}}
