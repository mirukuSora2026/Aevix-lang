/*
 * Return the Unicode 17 script property; this is not a text segmentation or rendering algorithm.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Script script(char c){return ucd_Script(ucd_find(ucd_script_data(),Char.to_u32(c),2usize));}
/*
 * Unicode 17 GraphemeBreak property values; variants have no numeric ABI guarantee.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum GraphemeBreak implements Copy {
/*
 * The CR value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
CR;
/*
 * The Control value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
