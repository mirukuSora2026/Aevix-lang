/*
 * Return the Unicode 17 grapheme_break property; this is not a text segmentation or rendering algorithm.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public GraphemeBreak grapheme_break(char c){return ucd_GraphemeBreak(ucd_find(ucd_grapheme_break_data(),Char.to_u32(c),2usize));}
/*
 * Unicode 17 WordBreak property values; variants have no numeric ABI guarantee.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum WordBreak implements Copy {
/*
 * The ALetter value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
ALetter;
/*
 * The CR value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
CR;
/*
 * The DoubleQuote value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
DoubleQuote;
/*
 * The Extend value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Extend;
/*
 * The ExtendNumLet value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
ExtendNumLet;
/*
 * The Format value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Format;
/*
 * The HebrewLetter value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
HebrewLetter;
/*
 * The Katakana value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Katakana;
/*
 * The LF value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LF;
/*
 * The MidLetter value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
MidLetter;
/*
 * The MidNum value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
MidNum;
/*
 * The MidNumLet value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
MidNumLet;
/*
 * The Newline value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Newline;
/*
 * The Numeric value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Numeric;
/*
 * The Other value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Other;
/*
 * The RegionalIndicator value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
RegionalIndicator;
/*
 * The SingleQuote value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
SingleQuote;
/*
 * The WSegSpace value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
WSegSpace;
/*
 * The ZWJ value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
ZWJ;
};
WordBreak ucd_WordBreak(u32 value){switch(value){
case 0u32:return WordBreak.ALetter;break;
case 1u32:return WordBreak.CR;break;
case 2u32:return WordBreak.DoubleQuote;break;
case 3u32:return WordBreak.Extend;break;
case 4u32:return WordBreak.ExtendNumLet;break;
case 5u32:return WordBreak.Format;break;
case 6u32:return WordBreak.HebrewLetter;break;
case 7u32:return WordBreak.Katakana;break;
case 8u32:return WordBreak.LF;break;
case 9u32:return WordBreak.MidLetter;break;
case 10u32:return WordBreak.MidNum;break;
case 11u32:return WordBreak.MidNumLet;break;
case 12u32:return WordBreak.Newline;break;
case 13u32:return WordBreak.Numeric;break;
case 14u32:return WordBreak.Other;break;
case 15u32:return WordBreak.RegionalIndicator;break;
case 16u32:return WordBreak.SingleQuote;break;
case 17u32:return WordBreak.WSegSpace;break;
case 18u32:return WordBreak.ZWJ;break;
default:Never.unreachable();break;}}
