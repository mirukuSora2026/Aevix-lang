SentenceBreak ucd_SentenceBreak(u32 value){switch(value){
case 0u32:return SentenceBreak.ATerm;break;
case 1u32:return SentenceBreak.CR;break;
case 2u32:return SentenceBreak.Close;break;
case 3u32:return SentenceBreak.Extend;break;
case 4u32:return SentenceBreak.Format;break;
case 5u32:return SentenceBreak.LF;break;
case 6u32:return SentenceBreak.Lower;break;
case 7u32:return SentenceBreak.Numeric;break;
case 8u32:return SentenceBreak.OLetter;break;
case 9u32:return SentenceBreak.Other;break;
case 10u32:return SentenceBreak.SContinue;break;
case 11u32:return SentenceBreak.STerm;break;
case 12u32:return SentenceBreak.Sep;break;
case 13u32:return SentenceBreak.Sp;break;
case 14u32:return SentenceBreak.Upper;break;
default:Never.unreachable();break;}}
