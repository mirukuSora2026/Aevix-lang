/*
 * Return the Unicode 17 sentence_break property; this is not a text segmentation or rendering algorithm.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public SentenceBreak sentence_break(char c){return ucd_SentenceBreak(ucd_find(ucd_sentence_break_data(),Char.to_u32(c),2usize));}
