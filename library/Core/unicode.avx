/*
 * The exact reduced rational Numeric_Value, including Han numeric data; denominator is positive.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public struct UnicodeNumeric implements Copy {
/*
 * The signed rational numerator.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i64 numerator;
/*
 * The strictly positive rational denominator.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u64 denominator;
};
/*
 * Return the exact pinned numeric rational, or None; never round through a float.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Optional<UnicodeNumeric> numeric_value(char c){switch(ucd_find(ucd_numeric_data(),Char.to_u32(c),2usize)){
case 0u32:return Optional.none();break;
case 1u32:return Optional.some(UnicodeNumeric {numerator=-1i64,denominator=2u64});break;
case 2u32:return Optional.some(UnicodeNumeric {numerator=0i64,denominator=1u64});break;
