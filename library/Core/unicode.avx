 * @removed_at none
 */
LF;
/*
 * The LV value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LV;
/*
 * The LVT value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
LVT;
/*
 * The Other value from the pinned Unicode property artifact.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Other;
/*
 * The Prepend value from the pinned Unicode property artifact.
