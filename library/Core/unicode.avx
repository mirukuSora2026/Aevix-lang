import ascii;
import encoding;
import error { Error };
public import ordering { Ordering };

/*
 * Unicode scalar/ASCII/code-unit operations and pinned Unicode 17 properties, independent of the ambient locale.
 * Import explicitly; these source functions are not aliases added to the Char namespace.
 * Codec/parse/allocation errors use UnicodeError; primitive from_u32/from_utf32 preserve CharError.
 * UTF codecs follow Unicode17 chapter3; fixed range predicates follow chapter23.
 * The generated property artifact is reproduced offline from third_party/unicode/17.0.0.
 * Break APIs expose properties only; normalization, segmentation, bidi reordering and display layout remain separate algorithms.
 * https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/
 * https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-23/
 * @module unicode
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
/*
 * Source codec errors are distinct from compiler CharError; all payloads are Copy and no borrowed storage is retained.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum UnicodeError implements Copy, Error {
    /*
     * A rejected scalar with its exact original u32.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Scalar {
        /*
         * The exact reason value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public CharError reason;
    };
    /*
     * An existing strict codec failure, preserving offsets in source code units.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Encoding {
        /*
         * The exact reason value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public encoding.EncodingError reason;
    };
    /*
     * A scalar or byte is outside the seven-bit ASCII domain.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    InvalidAscii {
        /*
         * The exact value value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public u32 value;
    };
    /*
     * The radix must be in the inclusive range2..36.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    InvalidRadix {
        /*
         * The exact radix value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public u32 radix;
    };
    /*
     * An exact-one decoder received no scalar.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    EmptyInput;
    /*
     * An exact-one decoder found a suffix after its first complete scalar.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    TrailingInput {
        /*
         * The exact offset value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize offset;
    };
    /*
     * An escape or U+ spelling is invalid at this UTF8 byte offset.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    InvalidSyntax {
        /*
         * The exact offset value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize offset;
    };
    /*
     * A valid UTF8 prefix needs more bytes; offset is the scalar start.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    IncompleteUtf8 {
        /*
         * The exact offset value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize offset;
        /*
         * The exact expected value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize expected;
        /*
         * The exact available value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize available;
    };
    /*
     * A UTF16 high surrogate needs its second unit; offsets count u16 units.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    IncompleteUtf16 {
        /*
         * The exact offset value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize offset;
        /*
         * The exact expected value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize expected;
        /*
         * The exact available value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize available;
    };
    /*
     * No output was modified because the complete encoded scalar would not fit.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    BufferTooSmall {
        /*
         * The exact required value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize required;
        /*
         * The exact available value for this failure.
         * @since 0.3
         * @deprecated_at none
         * @removed_at none
         */
        public usize available;
    };
    /*
     * Owned output allocation failed without losing input ownership.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    AllocationFailure;
    /*
     * The requested owned output length cannot be represented.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    SizeOverflow;
    /*
     * Return a stable machine-readable error code without allocating.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&Self self) { switch(*self) {
        case UnicodeError.Scalar: return "unicode.scalar"; break;
        case UnicodeError.Encoding { encoding.EncodingError nested=reason }: return nested.code(); break;
        case UnicodeError.InvalidAscii: return "unicode.invalid_ascii"; break;
        case UnicodeError.InvalidRadix: return "unicode.invalid_radix"; break;
        case UnicodeError.EmptyInput: return "unicode.empty_input"; break;
        case UnicodeError.TrailingInput: return "unicode.trailing_input"; break;
        case UnicodeError.InvalidSyntax: return "unicode.invalid_syntax"; break;
        case UnicodeError.IncompleteUtf8: return "unicode.incomplete_utf8"; break;
        case UnicodeError.IncompleteUtf16: return "unicode.incomplete_utf16"; break;
        case UnicodeError.BufferTooSmall: return "unicode.buffer_too_small"; break;
        case UnicodeError.AllocationFailure: return "unicode.allocation_failure"; break;
        case UnicodeError.SizeOverflow: return "unicode.size_overflow"; break;
    } }
    /*
     * Return a static human-readable error message without allocating.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&Self self) { switch(*self) {
        case UnicodeError.Scalar: return "A rejected scalar with its exact original u32."; break;
        case UnicodeError.Encoding { encoding.EncodingError nested=reason }: return nested.message(); break;
        case UnicodeError.InvalidAscii: return "A scalar or byte is outside the seven-bit ASCII domain."; break;
        case UnicodeError.InvalidRadix: return "The radix must be in the inclusive range2..36."; break;
        case UnicodeError.EmptyInput: return "An exact-one decoder received no scalar."; break;
        case UnicodeError.TrailingInput: return "An exact-one decoder found a suffix after its first complete scalar."; break;
        case UnicodeError.InvalidSyntax: return "An escape or U+ spelling is invalid at this UTF8 byte offset."; break;
        case UnicodeError.IncompleteUtf8: return "A valid UTF8 prefix needs more bytes; offset is the scalar start."; break;
        case UnicodeError.IncompleteUtf16: return "A UTF16 high surrogate needs its second unit; offsets count u16 units."; break;
        case UnicodeError.BufferTooSmall: return "No output was modified because the complete encoded scalar would not fit."; break;
        case UnicodeError.AllocationFailure: return "Owned output allocation failed without losing input ownership."; break;
        case UnicodeError.SizeOverflow: return "The requested owned output length cannot be represented."; break;
    } }
};


/* Internal conversions have proved ranges at every call site. A violation is an internal invariant failure. */
T represent<T,U>(U value) {
    Result<T,IntegerError> converted=Integer.convert<T>(value);
    switch(move converted){case Result<T,IntegerError>.Ok {T exact=value}:return exact;break;default:Never.unreachable();break;}
}
T proven<T,E>(Result<T,E> input) {
    switch(move input){case Result<T,E>.Ok {T exact=value}:return exact;break;default:Never.unreachable();break;}
}
char scalar(u32 value) { return proven(Char.from_u32(value)); }
Result<char,UnicodeError> checked_scalar(u32 value) {
    Result<char,CharError> converted=Char.from_u32(value);
    switch(move converted){
        case Result<char,CharError>.Ok {char exact=value}:return Result.ok(exact);break;
        case Result<char,CharError>.Err {CharError cause=error}:return Result.err(UnicodeError.Scalar {reason=cause});break;
    }
}
Result<string,UnicodeError> own_bytes(Slice<byte> value) {
    Result<string,TextError> text=string.from_utf8(value);
    switch(move text){
        case Result<string,TextError>.Ok {string output=value}:return Result.ok(output);break;
        case Result<string,TextError>.Err {TextError reason=error}:
            switch(reason){
                case TextError.AllocationFailure:return Result.err(UnicodeError.AllocationFailure);break;
                case TextError.SizeOverflow:return Result.err(UnicodeError.SizeOverflow);break;
                /* All callers supply encoded scalars or checked ASCII escape bytes. */
                default:Never.unreachable();break;
            }
            break;
    }
}
UnicodeError utf8_error(usize offset) {return UnicodeError.Encoding {reason=encoding.EncodingError.InvalidUtf8 {offset=offset}};}
UnicodeError utf16_error(usize offset) {return UnicodeError.Encoding {reason=encoding.EncodingError.InvalidUtf16 {offset=offset}};}
UnicodeError bounds_error(usize offset,usize length) {return UnicodeError.Encoding {reason=encoding.EncodingError.OffsetOutOfBounds {offset=offset,length=length}};}
u8 raw_byte(Slice<byte> input,usize index) {return Byte.to_u8(input[index]);}
i32 hex_value(u8 value) {
    if(value>=48u8&&value<=57u8)return represent<i32>(value-48u8);
    if(value>=65u8&&value<=70u8)return represent<i32>(value-65u8)+10;
    if(value>=97u8&&value<=102u8)return represent<i32>(value-97u8)+10;
    return -1;
}
Result<char,UnicodeError> parse_hex(Slice<byte> input,usize start,usize end) {
    if(start==end)return Result.err(UnicodeError.InvalidSyntax {offset=start});
    mut u32 raw=0u32;
    mut usize index=start;
    while(index<end){
        i32 digit=hex_value(raw_byte(input,index));
        if(digit<0||index-start>=6usize)return Result.err(UnicodeError.InvalidSyntax {offset=index});
        raw=(raw<<4)|represent<u32>(digit);index++;
    }
    return checked_scalar(raw);
}
Result<usize,UnicodeError> escape_bytes(char value,MutSlice<byte> output,bool force_unicode) {
    u32 raw=Char.to_u32(value);
    if(!force_unicode){
        mut u8 short=0u8;
        if(raw==0u32)short=48u8;
        else if(raw==10u32)short=110u8;
        else if(raw==13u32)short=114u8;
        else if(raw==9u32)short=116u8;
        else if(raw==34u32)short=34u8;
        else if(raw==39u32)short=39u8;
        else if(raw==92u32)short=92u8;
        if(short!=0u8){output[0]=Byte.from_u8(92u8);output[1]=Byte.from_u8(short);return Result.ok(2usize);}
        if(raw>=32u32&&raw<=126u32){output[0]=Byte.from_u8(represent<u8>(raw));return Result.ok(1usize);}
    }
    output[0]=Byte.from_u8(92u8);output[1]=Byte.from_u8(117u8);output[2]=Byte.from_u8(123u8);
    mut usize digits=1usize;
    mut u32 remaining=raw;
    while(remaining>=16u32){digits++;remaining=remaining>>4;}
    mut usize index=0usize;
    while(index<digits){
        usize shift=(digits-index-1usize)*4usize;
        u32 digit=(raw>>shift)&15u32;
        output[3usize+index]=Byte.from_u8(represent<u8>(digit<10u32?digit+48u32:digit+87u32));
        index++;
    }
    output[3usize+digits]=Byte.from_u8(125u8);
    return Result.ok(4usize+digits);
}
Result<string,UnicodeError> escaped(char value,bool force_unicode) {
    mut byte output[10]=[Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8),Byte.from_u8(0u8)];
    usize length=escape_bytes(value,Slice.from_array_mut(&mut output),force_unicode)?;
    Slice<byte> prefix=proven(Slice.slice(Slice.from_array(&output),0usize,length));
    return own_bytes(prefix);
}

/*
 * Compare scalar values after ASCII folding; no locale or allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Ordering ascii_compare_ignore_case(char left,char right) {
    char a=ascii.to_lower(left);char b=ascii.to_lower(right);return a<b?Ordering.Less:(a>b?Ordering.Greater:Ordering.Equal);
}

/*
 * Decode one seven-bit byte; reject values 128…255. The error carrier is UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<char,UnicodeError> ascii_decode(byte value) {
    return ascii_from_u8(Byte.to_u8(value));
}

/*
 * Require radix 2…36; accept ASCII digits and letters only. The error carrier is UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Optional<u32>,UnicodeError> ascii_digit_value(char c,u32 radix) {
    if(radix<2u32||radix>36u32)return Result.err(UnicodeError.InvalidRadix {radix=radix});return Result.ok(proven(ascii.digit_value(c,radix)));
}

/*
 * Encode one ASCII scalar as one byte; reject non-ASCII values. The error carrier is UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<byte,UnicodeError> ascii_encode(char c) {
    u32 raw=Char.to_u32(c);if(raw>127u32)return Result.err(UnicodeError.InvalidAscii {value=raw});return Result.ok(Byte.from_u8(represent<u8>(raw)));
}

/*
 * Compare after ASCII folding; never Unicode-fold non-ASCII scalars.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_equal_ignore_case(char left,char right) {
    return ascii.equal_ignore_case(left,right);
}

/*
 * Allocate an ASCII diagnostic escape; reject non-ASCII input. The error carrier is UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<string,UnicodeError> ascii_escape(char c) {
    u32 raw=Char.to_u32(c);if(raw>127u32)return Result.err(UnicodeError.InvalidAscii {value=raw});return escaped(c,false);
}

/*
 * Accept 0…127, including NUL and controls; reject high-bit input. The error carrier is UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<char,UnicodeError> ascii_from_u8(u8 value) {
    u32 raw=represent<u32>(value);if(raw>127u32)return Result.err(UnicodeError.InvalidAscii {value=raw});return Result.ok(scalar(raw));
}

/*
 * A–Z or a–z; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_alphabetic(char c) {
    return ascii.is_alphabetic(c);
}

/*
 * ASCII letter or decimal digit; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_alphanumeric(char c) {
    return ascii.is_alphanumeric(c);
}

/*
 * 0 or 1; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_binary_digit(char c) {
    return ascii.is_binary_digit(c);
}

/*
 * SPACE or horizontal tab; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_blank(char c) {
    return c==' '||c=='\t';
}

/*
 * U+0000…U+001F or U+007F; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_control(char c) {
    return ascii.is_control(c);
}

/*
 * 0–9; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_digit(char c) {
    return ascii.is_digit(c);
}

/*
 * U+0021…U+007E; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_graphic(char c) {
    return ascii.is_graphic(c);
}

/*
 * 0–9, A–F, or a–f; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_hex_digit(char c) {
    return ascii.is_hex_digit(c);
}

/*
 * a–z; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_lowercase(char c) {
    return ascii.is_lowercase(c);
}

/*
 * 0–7; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_octal_digit(char c) {
    return ascii.is_oct_digit(c);
}

/*
 * U+0020…U+007E; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_printable(char c) {
    return ascii.is_printable(c);
}

/*
 * Graphic ASCII excluding letters and digits; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_punctuation(char c) {
    return ascii.is_punctuation(c);
}

/*
 * Plus or minus; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_sign(char c) {
    return c=='+'||c=='-';
}

/*
 * A–Z; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_uppercase(char c) {
    return ascii.is_uppercase(c);
}

/*
 * HT, LF, FF, CR, or SPACE; VT excluded; non-ASCII returns false, without allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool ascii_is_whitespace(char c) {
    return c==' '||c=='\t'||c=='\n'||c=='\u{c}'||c=='\r';
}

/*
 * Require exactly one ASCII scalar and consume the whole input. The error carrier is UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<char,UnicodeError> ascii_parse(string_view text) {
    char value=parse_scalar(text)?;u32 raw=Char.to_u32(value);if(raw>127u32)return Result.err(UnicodeError.InvalidAscii {value=raw});return Result.ok(value);
}

/*
 * Map A–Z to a–z; all other scalars remain unchanged.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public char ascii_to_lowercase(char c) {
    return ascii.to_lower(c);
}

/*
 * Map a–z to A–Z; all other scalars remain unchanged.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public char ascii_to_uppercase(char c) {
    return ascii.to_upper(c);
}

/*
 * Decode at a code-unit offset; return the scalar and units consumed. Offsets count u16 elements, never serialized bytes; the suffix is not validated.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Tuple<char,usize>,UnicodeError> decode_utf16_at(Slice<u16> units,usize offset) {
    usize length=Slice.len(units);
    if(offset>length)return Result.err(bounds_error(offset,length));
    if(offset==length)return Result.err(UnicodeError.IncompleteUtf16 {offset=offset,expected=1usize,available=0usize});
    u32 first=represent<u32>(units[offset]);
    if(first<55296u32||first>57343u32)return Result.ok(Tuple.make(scalar(first),1usize));
    if(first>56319u32)return Result.err(utf16_error(offset));
    if(length-offset<2usize)return Result.err(UnicodeError.IncompleteUtf16 {offset=offset,expected=2usize,available=length-offset});
    u32 second=represent<u32>(units[offset+1usize]);
    if(second<56320u32||second>57343u32)return Result.err(utf16_error(offset+1usize));
    u32 raw=65536u32+((first-55296u32)<<10)+(second-56320u32);
    return Result.ok(Tuple.make(scalar(raw),2usize));
}

/*
 * Decode at a byte boundary; return the scalar and byte count consumed. UTF8 byte offsets are absolute; suffix bytes are not validated.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Tuple<char,usize>,UnicodeError> decode_utf8_at(Slice<byte> units,usize offset) {
    usize length=Slice.len(units);
    if(offset>length)return Result.err(bounds_error(offset,length));
    if(offset==length)return Result.err(UnicodeError.IncompleteUtf8 {offset=offset,expected=1usize,available=0usize});
    u8 lead=raw_byte(units,offset);
    mut usize width=1usize;mut u32 raw=represent<u32>(lead);
    if(lead>=194u8&&lead<=223u8){width=2usize;raw=represent<u32>(lead&31u8);}
    else if(lead>=224u8&&lead<=239u8){width=3usize;raw=represent<u32>(lead&15u8);}
    else if(lead>=240u8&&lead<=244u8){width=4usize;raw=represent<u32>(lead&7u8);}
    else if(lead>=128u8)return Result.err(utf8_error(offset));
    mut usize index=1usize;
    while(index<width){
        if(index>=length-offset)return Result.err(UnicodeError.IncompleteUtf8 {offset=offset,expected=width,available=length-offset});
        u8 next=raw_byte(units,offset+index);
        if(next<128u8||next>191u8||(index==1usize&&((lead==224u8&&next<160u8)||(lead==237u8&&next>159u8)||(lead==240u8&&next<144u8)||(lead==244u8&&next>143u8))))return Result.err(utf8_error(offset+index));
        raw=(raw<<6)|represent<u32>(next&63u8);index++;
    }
    return Result.ok(Tuple.make(scalar(raw),width));
}

/*
 * Validate exclusive capacity before writing one or two units. No allocation, no partial write on capacity failure, and trailing output remains unchanged.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize,UnicodeError> encode_utf16_into(char c,MutSlice<u16> output) {
    usize required=represent<usize>(utf16_length(c));usize available=Slice.len(&output);
    if(available<required)return Result.err(UnicodeError.BufferTooSmall {required=required,available=available});
    u32 raw=Char.to_u32(c);
    if(required==1usize)output[0]=represent<u16>(raw);
    else {u32 supplementary=raw-65536u32;output[0]=represent<u16>(55296u32|(supplementary>>10));output[1]=represent<u16>(56320u32|(supplementary&1023u32));}
    return Result.ok(required);
}

/*
 * Validate capacity before writing one to four bytes; no allocation. No allocation, no partial write on capacity failure, and trailing output remains unchanged.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<usize,UnicodeError> encode_utf8_into(char c,MutSlice<byte> output) {
    usize required=represent<usize>(utf8_length(c));usize available=Slice.len(&output);
    if(available<required)return Result.err(UnicodeError.BufferTooSmall {required=required,available=available});
    u32 raw=Char.to_u32(c);
