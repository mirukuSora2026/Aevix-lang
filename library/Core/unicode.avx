public char simple_case_fold(char c){string_view table=ucd_simple_case_fold_data();usize at=ucd_sparse(table,Char.to_u32(c),8usize);Slice<byte> bytes=string.as_bytes(table);if(at==Slice.len(bytes))return c;return scalar(ucd_unpack(bytes,at+4usize,4usize));}
