/*
 * Test Unicode 17 Alphabetic; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_alphabetic(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&1u32)!=0u32;}
/*
 * Test Unicode 17 Case_Ignorable; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_case_ignorable(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&2u32)!=0u32;}
/*
 * Test Unicode 17 Cased; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_cased(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&4u32)!=0u32;}
/*
 * Test Unicode 17 Default_Ignorable_Code_Point; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_default_ignorable(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&8u32)!=0u32;}
/*
 * Test Unicode 17 Join_Control; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_join_control(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&16u32)!=0u32;}
/*
 * Test Unicode 17 Lowercase; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_lowercase(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&32u32)!=0u32;}
/*
 * Test Unicode 17 Uppercase; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_uppercase(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&64u32)!=0u32;}
/*
 * Test Unicode 17 Variation_Selector; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_variation_selector(char c){return (ucd_find(ucd_flags_data(),Char.to_u32(c),2usize)&128u32)!=0u32;}
/*
 * Test Unicode 17 White_Space; locale independent and allocation free.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
