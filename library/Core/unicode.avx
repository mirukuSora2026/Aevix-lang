case 3u32:return GeneralCategory.PrivateUse;break;
case 4u32:return GeneralCategory.Surrogate;break;
case 5u32:return GeneralCategory.LowercaseLetter;break;
case 6u32:return GeneralCategory.ModifierLetter;break;
case 7u32:return GeneralCategory.OtherLetter;break;
case 8u32:return GeneralCategory.TitlecaseLetter;break;
case 9u32:return GeneralCategory.UppercaseLetter;break;
case 10u32:return GeneralCategory.SpacingMark;break;
case 11u32:return GeneralCategory.EnclosingMark;break;
case 12u32:return GeneralCategory.NonspacingMark;break;
case 13u32:return GeneralCategory.DecimalNumber;break;
case 14u32:return GeneralCategory.LetterNumber;break;
case 15u32:return GeneralCategory.OtherNumber;break;
case 16u32:return GeneralCategory.ConnectorPunctuation;break;
case 17u32:return GeneralCategory.DashPunctuation;break;
case 18u32:return GeneralCategory.ClosePunctuation;break;
case 19u32:return GeneralCategory.FinalPunctuation;break;
case 20u32:return GeneralCategory.InitialPunctuation;break;
case 21u32:return GeneralCategory.OtherPunctuation;break;
case 22u32:return GeneralCategory.OpenPunctuation;break;
case 23u32:return GeneralCategory.CurrencySymbol;break;
case 24u32:return GeneralCategory.ModifierSymbol;break;
case 25u32:return GeneralCategory.MathSymbol;break;
case 26u32:return GeneralCategory.OtherSymbol;break;
case 27u32:return GeneralCategory.LineSeparator;break;
case 28u32:return GeneralCategory.ParagraphSeparator;break;
case 29u32:return GeneralCategory.SpaceSeparator;break;
