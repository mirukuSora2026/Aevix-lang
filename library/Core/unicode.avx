/*
 * Allocate Unicode 17 default isolated-scalar full lowercase. Only unconditional SpecialCasing rules apply; normalization and contextual/Turkic casing are separate. Errors use UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<string,UnicodeError> to_lowercase(char c){return ucd_full_case(c,ucd_full_lowercase_data(),ucd_full_lowercase_pool_data());}
