/*
 * Apply Unicode 17 default non-Turkic simple titlecase; identity when absent, no context or allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public char simple_titlecase(char c){string_view table=ucd_simple_titlecase_data();usize at=ucd_sparse(table,Char.to_u32(c),8usize);Slice<byte> bytes=string.as_bytes(table);if(at==Slice.len(bytes))return c;return scalar(ucd_unpack(bytes,at+4usize,4usize));}
