GraphemeBreak ucd_GraphemeBreak(u32 value){switch(value){
case 0u32:return GraphemeBreak.CR;break;
case 1u32:return GraphemeBreak.Control;break;
case 2u32:return GraphemeBreak.Extend;break;
case 3u32:return GraphemeBreak.L;break;
case 4u32:return GraphemeBreak.LF;break;
case 5u32:return GraphemeBreak.LV;break;
case 6u32:return GraphemeBreak.LVT;break;
case 7u32:return GraphemeBreak.Other;break;
case 8u32:return GraphemeBreak.Prepend;break;
case 9u32:return GraphemeBreak.RegionalIndicator;break;
case 10u32:return GraphemeBreak.SpacingMark;break;
case 11u32:return GraphemeBreak.T;break;
case 12u32:return GraphemeBreak.V;break;
case 13u32:return GraphemeBreak.ZWJ;break;
default:Never.unreachable();break;}}
