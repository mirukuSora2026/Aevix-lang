/*
 * Allocate the Script_Extensions set in stable Script variant order; UCD defaults are singleton Script sets. Allocation errors use UnicodeError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<Script>,UnicodeError> script_extensions(char c){
    u32 set_id=ucd_find(ucd_script_extensions_data(),Char.to_u32(c),2usize);
    Slice<byte> index=string.as_bytes(ucd_script_extension_index_data());usize position=represent<usize>(set_id)*6usize;
    usize offset=represent<usize>(ucd_unpack(index,position,4usize));usize length=represent<usize>(ucd_unpack(index,position+4usize,2usize));
    Slice<byte> pool=string.as_bytes(ucd_script_extension_pool_data());
    Result<Vector<Script>,CollectionError> empty=[];
    mut Vector<Script> output=proven(empty);
    mut usize at=0usize;while(at<length){ucd_push_script(&mut output,ucd_Script(ucd_unpack(pool,offset+at*2usize,2usize)))?;at++;}
    return Result.ok(output);
}
Result<unit,UnicodeError> ucd_push_script(&mut Vector<Script> output,Script value){
    Result<unit,InputError<Script>> appended=Vector.push(output,value);
    switch(move appended){case Result<unit,InputError<Script>>.Ok:return Result.ok(Unit.value());break;case Result<unit,InputError<Script>>.Err {InputError<Script> cause=error}:switch(move cause){case InputError<Script>.SizeOverflow:return Result.err(UnicodeError.SizeOverflow);break;case InputError<Script>.AllocationFailure:return Result.err(UnicodeError.AllocationFailure);break;default:Never.unreachable();break;}break;}
}
usize ucd_sparse(string_view table,u32 code,usize stride){
    Slice<byte> data=string.as_bytes(table);mut usize low=0usize;mut usize high=Slice.len(data)/stride;
    while(low<high){usize middle=low+(high-low)/2usize;u32 found=ucd_unpack(data,middle*stride,4usize);if(found<code)low=middle+1usize;else high=middle;}
    if(low==Slice.len(data)/stride||ucd_unpack(data,low*stride,4usize)!=code)return Slice.len(data);
    return low*stride;
}
