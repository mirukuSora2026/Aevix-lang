/*
 * Return the named Unicode 17 block, including unassigned positions inside a block; gaps return None.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Optional<UnicodeBlock> block(char c){u32 value=ucd_find(ucd_block_data(),Char.to_u32(c),2usize);if(value==0u32)return Optional.none();return Optional.some(ucd_UnicodeBlock(value-1u32));}
/*
 * An exact Unicode release identifier; the current artifact uses major/minor with patch zero.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public struct UnicodeVersion implements Copy {
/*
 * The major release component.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u8 major;
/*
 * The minor release component.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u8 minor;
/*
 * The patch release component.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u8 patch;
};
