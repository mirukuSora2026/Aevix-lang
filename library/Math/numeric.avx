/*
 * Lifecycle of the numeric public module.
 * @module numeric
 * @since 0.2
 * @deprecated_at none
 * @removed_at none
 */
/*
 * A sealed scalar-format capability implemented by the compiler for builtin
 * f16, bf16, f32 and f64. Import explicitly before using a Floating bound.
 * @since 0.2
 * @deprecated_at none
 * @removed_at none
 */
public interface Floating {};

/*
 * IEEE scalar classification, independent of a particular NaN payload.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum FloatClass implements Copy { /*
 * Version history for the numeric.FloatClass.Nan public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Nan; /*
 * Version history for the numeric.FloatClass.Infinite public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Infinite; /*
 * Version history for the numeric.FloatClass.Zero public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Zero; /*
 * Version history for the numeric.FloatClass.Subnormal public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Subnormal; /*
 * Version history for the numeric.FloatClass.Normal public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
Normal; };
