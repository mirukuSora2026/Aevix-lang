/*
 * Exact-bit utilities for f16, bf16, f32 and f64. Every operation is O(1), performs no
 * allocation, and calls no native/C math routine. Classification and sign operations
 * never quiet a signaling NaN. Unary representation-preserving operations keep NaN
 * payloads unless their documented sign operation changes that sign bit.
 * Total comparison distinguishes signed zeros and NaN representations; it is not
 * the same relation as ordinary floating equality or approximate equality.
 * @module floating
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public import numeric { FloatClass };
public import ordering { Ordering };

/*
 * f16 Spacing between one and the next greater representable value.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 EPSILON_F16 = 0.0009765625f16;

/*
 * f16 Smallest strictly positive normal value.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 MIN_POSITIVE_NORMAL_F16 = 6.103515625e-05f16;

/*
 * f16 Smallest strictly positive nonzero value, including subnormals.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 MIN_POSITIVE_SUBNORMAL_F16 = 5.960464477539063e-08f16;

/*
 * f16 Greatest finite value.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 MAX_VALUE_F16 = 65504.0f16;

/*
 * f16 Least finite value, the negative of MAX_VALUE.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 MIN_VALUE_F16 = -65504.0f16;

/*
 * f16 Positive zero with an unset sign bit.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 POSITIVE_ZERO_F16 = 0.0f16;

/*
 * f16 Negative zero with a set sign bit.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public const f16 NEGATIVE_ZERO_F16 = -0.0f16;

/*
 * Return positive infinity in f16; constructed directly from its exact bit word.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 infinity_f16() { return Float.from_bits<f16>(31744u16); }

/*
 * Return negative infinity in f16; constructed directly from its exact bit word.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 neg_infinity_f16() { return Float.from_bits<f16>(64512u16); }

/*
 * Return a canonical positive quiet NaN with zero trailing payload in f16; constructed directly from its exact bit word.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 nan_f16() { return Float.from_bits<f16>(32256u16); }

/*
 * Classify every f16 encoding without floating arithmetic; preserve the input representation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public FloatClass classify(f16 value) {
    u16 raw = Float.to_bits(value);
    u16 exponent = raw & 31744u16;
    u16 fraction = raw & 1023u16;
    if (exponent == 31744u16) return fraction == 0u16 ? FloatClass.Infinite : FloatClass.Nan;
    if (exponent == 0u16) return fraction == 0u16 ? FloatClass.Zero : FloatClass.Subnormal;
    return FloatClass.Normal;
}

/*
 * f16: True for every quiet or signaling NaN, regardless of sign or payload.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_nan(f16 value) {
    return (Float.to_bits(value) & 32767u16) > 31744u16;
}

/*
 * f16: True for either signed infinity.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_infinite(f16 value) {
    return (Float.to_bits(value) & 32767u16) == 31744u16;
}

/*
 * f16: True for signed zeros, subnormals and normal finite values.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_finite(f16 value) {
    return (Float.to_bits(value) & 32767u16) < 31744u16;
}

/*
 * f16: True for finite nonzero normalized values.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_normal(f16 value) {
    return (Float.to_bits(value) & 31744u16) != 0u16 && (Float.to_bits(value) & 31744u16) != 31744u16;
}

/*
 * f16: True for nonzero finite values below the normal threshold.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_subnormal(f16 value) {
    return (Float.to_bits(value) & 31744u16) == 0u16 && (Float.to_bits(value) & 1023u16) != 0u16;
}

/*
 * f16: True for either signed zero.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_zero(f16 value) {
    return (Float.to_bits(value) & 32767u16) == 0u16;
}

/*
 * f16: Inspect the sign bit, including negative zero and negative NaNs.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_sign_negative(f16 value) {
    return (Float.to_bits(value) & 32768u16) != 0u16;
}

/*
 * f16: Inspect an unset sign bit, including positive zero and positive NaNs.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_sign_positive(f16 value) {
    return (Float.to_bits(value) & 32768u16) == 0u16;
}

/*
 * Invert only the f16 sign bit, preserving every magnitude and NaN payload bit.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 neg(f16 value) {
    return Float.from_bits<f16>(Float.to_bits(value) ^ 32768u16);
}

/*
 * Clear only the f16 sign bit; NaN payload and signaling state are preserved.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 abs(f16 value) {
    return Float.from_bits<f16>(Float.to_bits(value) & 32767u16);
}

/*
 * Keep f16 magnitude/payload from value and copy only the sign bit from sign.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 copy_sign(f16 value, f16 sign) {
    return Float.from_bits<f16>((Float.to_bits(value) & 32767u16) | (Float.to_bits(sign) & 32768u16));
}

/*
 * Return signed one for nonzero non-NaN f16; preserve signed zero and every NaN bit unchanged.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 signum(f16 value) {
    if (is_nan(value) || is_zero(value)) return value;
    return Float.from_bits<f16>((Float.to_bits(value) & 32768u16) | 15360u16);
}

/*
 * Next numerically greater f16; preserve NaN bits and positive infinity. Either zero steps to the minimum positive subnormal.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 next_up(f16 value) {
    if (is_nan(value)) return value;
    u16 raw = Float.to_bits(value);
    if (raw == 31744u16) return value;
    if ((raw & 32767u16) == 0u16) return Float.from_bits<f16>(1u16);
    return Float.from_bits<f16>((raw & 32768u16) != 0u16 ? raw - 1u16 : raw + 1u16);
}

/*
 * Next numerically smaller f16; preserve NaN bits and negative infinity. Either zero steps to the minimum negative subnormal.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f16 next_down(f16 value) {
    if (is_nan(value)) return value;
    u16 raw = Float.to_bits(value);
    if (raw == 64512u16) return value;
    if ((raw & 32767u16) == 0u16) return Float.from_bits<f16>(32769u16);
    return Float.from_bits<f16>((raw & 32768u16) != 0u16 ? raw + 1u16 : raw - 1u16);
}

/*
 * IEEE total order for f16 encodings: negative NaNs, negative infinity, negative finite values, -0, +0, positive finite values, positive infinity, positive NaNs. Negative NaN quietness/payload order is reversed; identical encodings compare Equal.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Ordering total_cmp(f16 left, f16 right) {
    u16 left_bits = Float.to_bits(left);
    u16 right_bits = Float.to_bits(right);
    u16 left_key = (left_bits & 32768u16) != 0u16 ? ~left_bits : left_bits | 32768u16;
    u16 right_key = (right_bits & 32768u16) != 0u16 ? ~right_bits : right_bits | 32768u16;
    if (left_key < right_key) return Ordering.Less;
    if (left_key > right_key) return Ordering.Greater;
    return Ordering.Equal;
}

/*
 * Catalog-spelled alias of total_cmp for f16; preserves the same signed-zero and NaN distinctions.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Ordering total_compare(f16 left, f16 right) {
    return total_cmp(left, right);
}

