public Result<u16, IntegerMathError> lcm(u16 left, u16 right) {
    if (left == 0 || right == 0) return Result.ok(0);
    u16 reduced = left / gcd(left, right);
    if (reduced > 65535u16 / right) return Result.err(IntegerMathError.Overflow);
    return Result.ok(reduced * right);
}

