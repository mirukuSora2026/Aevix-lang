/*
 * Return the numeric argument when exactly one input is NaN; equal signed-zero choice follows host C math.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f64 max(f64 left, f64 right) { return fmax(left, right); }
/*
 * Test whether the value is NaN without allocating.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_nan(f64 value) { return value != value; }
/*
 * Test either infinity; NaN returns false.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_infinite(f64 value) { return value > 1.7976931348623157e308 || value < -1.7976931348623157e308; }
/*
 * Test finite normal, subnormal and zero values.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_finite(f64 value) { return value == value && value <= 1.7976931348623157e308 && value >= -1.7976931348623157e308; }
/*
 * Inspect the sign, including negative zero and signed NaN.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_sign_negative(f64 value) { return copysign(1.0, value) < 0.0; }
/*
 * Test finite values with a normal exponent.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_normal(f64 value) { return is_finite(value) && abs(value) >= 2.2250738585072014e-308; }
/*
 * Test finite nonzero values below the smallest normal magnitude.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool is_subnormal(f64 value) { return is_finite(value) && value != 0.0 && abs(value) < 2.2250738585072014e-308; }
/*
 * Classify the scalar without interpreting its NaN payload.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public FloatClass classify(f64 value) { if (is_nan(value)) return FloatClass.Nan; if (is_infinite(value)) return FloatClass.Infinite; if (value == 0.0) return FloatClass.Zero; if (is_subnormal(value)) return FloatClass.Subnormal; return FloatClass.Normal; }
/*
 * Return signed one for nonzero non-NaN values; preserve signed zero and a NaN value.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public f64 signum(f64 value) { if (is_nan(value) || value == 0.0) return value; return copysign(1.0, value); }
/*
 * Clamp to inclusive non-NaN ascending bounds; a NaN input remains NaN.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<f64, FloatMathError> clamp(f64 value, f64 lower, f64 upper) { if (is_nan(lower) || is_nan(upper) || lower > upper) return Result.err(FloatMathError.InvalidBounds); return Result.ok(value < lower ? lower : value > upper ? upper : value); }
/*
 * Require a finite nonnegative input and return its square root.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<f64, FloatMathError> checked_sqrt(f64 value) { if (!is_finite(value)) return Result.err(FloatMathError.NonFinite); if (value < 0.0) return Result.err(FloatMathError.Domain); return Result.ok(sqrt(value)); }
/*
 * Require a finite positive input and return its natural logarithm.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<f64, FloatMathError> checked_log(f64 value) { if (!is_finite(value)) return Result.err(FloatMathError.NonFinite); if (value <= 0.0) return Result.err(FloatMathError.Domain); return Result.ok(log(value)); }
/*
 * Reject nonfinite input or an overflowing exponential; finite underflow to zero is retained.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<f64, FloatMathError> checked_exp(f64 value) { if (!is_finite(value)) return Result.err(FloatMathError.NonFinite); f64 computed = exp(value); if (!is_finite(computed)) return Result.err(FloatMathError.Overflow); return Result.ok(computed); }
/*
 * Check finite inputs, real-domain validity and finite result; zero to zero is one.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<f64, FloatMathError> checked_pow(f64 base, f64 exponent) { if (!is_finite(base) || !is_finite(exponent)) return Result.err(FloatMathError.NonFinite); if (base == 0.0 && exponent < 0.0) return Result.err(FloatMathError.Domain); f64 computed = pow(base, exponent); if (is_nan(computed)) return Result.err(FloatMathError.Domain); if (!is_finite(computed)) return Result.err(FloatMathError.Overflow); return Result.ok(computed); }
/*
 * Check finite inputs and finite hypotenuse output without a naive squared intermediate.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<f64, FloatMathError> checked_hypot(f64 left, f64 right) { if (!is_finite(left) || !is_finite(right)) return Result.err(FloatMathError.NonFinite); f64 computed = hypot(left, right); if (!is_finite(computed)) return Result.err(FloatMathError.Overflow); return Result.ok(computed); }
