    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) {
            if (factor != 0 && result > 65535u16 / factor) return Result.err(IntegerMathError.Overflow);
            result *= factor;
        }
        remaining /= 2u32;
        if (remaining != 0u32) {
            if (factor != 0 && factor > 65535u16 / factor) return Result.err(IntegerMathError.Overflow);
