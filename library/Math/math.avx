/*
 * Compute the exact nonnegative u8 greatest common divisor; gcd(0, 0) is zero. Euclidean remainder steps allocate nothing.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u8 gcd(u8 left, u8 right) {
    mut u8 a = left;
    mut u8 b = right;
    while (b != 0) { u8 remainder = a % b; a = b; b = remainder; }
    return a;
}

/*
 * Compute the nonnegative u8 least common multiple after dividing by gcd; zero inputs return zero and overflow is explicit.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8, IntegerMathError> lcm(u8 left, u8 right) {
    if (left == 0 || right == 0) return Result.ok(0);
    u8 reduced = left / gcd(left, right);
    if (reduced > 255u8 / right) return Result.err(IntegerMathError.Overflow);
    return Result.ok(reduced * right);
}

/*
 * Compute exact u8 exponentiation with checked products and at most 32 exponent steps; 0^0 is 1.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8, IntegerMathError> checked_pow(u8 base, u32 exponent) {
    mut u8 result = 1;
    mut u8 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) {
            if (factor != 0 && result > 255u8 / factor) return Result.err(IntegerMathError.Overflow);
            result *= factor;
        }
        remaining /= 2u32;
        if (remaining != 0u32) {
            if (factor != 0 && factor > 255u8 / factor) return Result.err(IntegerMathError.Overflow);
            factor *= factor;
        }
    }
    return Result.ok(result);
}

