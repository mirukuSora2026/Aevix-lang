/*
 * Compute the exact nonnegative u64 greatest common divisor; gcd(0, 0) is zero. Euclidean remainder steps allocate nothing.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u64 gcd(u64 left, u64 right) {
    mut u64 a = left;
    mut u64 b = right;
    while (b != 0) { u64 remainder = a % b; a = b; b = remainder; }
    return a;
}

/*
 * Compute the nonnegative u64 least common multiple after dividing by gcd; zero inputs return zero and overflow is explicit.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<u64, IntegerMathError> lcm(u64 left, u64 right) {
    if (left == 0 || right == 0) return Result.ok(0);
    u64 reduced = left / gcd(left, right);
    if (reduced > 18446744073709551615u64 / right) return Result.err(IntegerMathError.Overflow);
    return Result.ok(reduced * right);
}

/*
 * Compute exact u64 exponentiation with checked products and at most 32 exponent steps; 0^0 is 1.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<u64, IntegerMathError> checked_pow(u64 base, u32 exponent) {
    mut u64 result = 1;
    mut u64 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) {
            if (factor != 0 && result > 18446744073709551615u64 / factor) return Result.err(IntegerMathError.Overflow);
            result *= factor;
        }
        remaining /= 2u32;
        if (remaining != 0u32) {
            if (factor != 0 && factor > 18446744073709551615u64 / factor) return Result.err(IntegerMathError.Overflow);
            factor *= factor;
        }
    }
    return Result.ok(result);
}

