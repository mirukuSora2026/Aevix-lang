/*
 * Return the exact u8 magnitude of i8, including its signed minimum. Never negate MIN directly.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u8 unsigned_abs(i8 value) {
    i8 nonnegative = value < 0 ? -(value + 1) : value;
    Result<u8, IntegerError> converted = Integer.convert<u8>(nonnegative);
    switch (converted) {
        case Result<u8, IntegerError>.Ok { u8 magnitude = value }: return value < 0 ? magnitude + 1 : magnitude; break;
        default: Never.unreachable(); break;
    }
}

