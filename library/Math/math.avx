// Native scalar floating-point mathematics.
/*
 * Scalar f32/f64 functions use the host C math library without allocation.
 * NaN, infinity, signed zero and the current floating-point environment follow that library.
 * Transcendental results may differ in their last bits between target math libraries.
 * errno and floating-point status flags are not translated into Aevix errors by these calls.
 * Reference: https://eel.is/c++draft/c.math
 */
/*
 * Checked floating-point domain, finite-input, result-overflow and clamp-bound failures.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum FloatMathError implements Copy, Error {
    /*
     * Version history for the math.FloatMathError.Domain public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Domain;
    /*
     * Version history for the math.FloatMathError.NonFinite public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    NonFinite;
    /*
     * Version history for the math.FloatMathError.Overflow public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    Overflow;
    /*
     * Version history for the math.FloatMathError.InvalidBounds public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    InvalidBounds;
    /*
     * Version history for the math.FloatMathError.code public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&FloatMathError self) {
        switch (*self) {
            case FloatMathError.Domain: return "math.float_domain"; break;
            case FloatMathError.NonFinite: return "math.non_finite"; break;
            case FloatMathError.Overflow: return "math.float_overflow"; break;
            case FloatMathError.InvalidBounds: return "math.invalid_float_bounds"; break;
        }
    }
    /*
     * Version history for the math.FloatMathError.message public API.
     * @since 0.3
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&FloatMathError self) {
        switch (*self) {
            case FloatMathError.Domain: return "The finite arguments are outside the function domain."; break;
            case FloatMathError.NonFinite: return "The checked operation requires finite arguments."; break;
            case FloatMathError.Overflow: return "The floating-point result is not finite."; break;
            case FloatMathError.InvalidBounds: return "Clamp bounds are NaN or in descending order."; break;
        }
    }
};

