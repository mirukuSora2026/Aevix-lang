    u8 magnitude = checked_pow(unsigned_abs(base), exponent)?;
    if (base < 0 && exponent % 2u32 != 0u32) {
        Result<i8, IntegerError> converted = Integer.convert<i8>(magnitude - 1);
        switch (converted) {
            case Result<i8, IntegerError>.Ok { i8 predecessor = value }: return Result.ok(-predecessor - 1); break;
            default: return Result.err(IntegerMathError.Overflow); break;
        }
    }
    Result<i8, IntegerError> converted = Integer.convert<i8>(magnitude);
    switch (converted) {
        case Result<i8, IntegerError>.Ok { i8 output = value }: return Result.ok(output); break;
        default: return Result.err(IntegerMathError.Overflow); break;
    }
}

