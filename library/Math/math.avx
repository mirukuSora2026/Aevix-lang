
/*
 * Exact primitive integer mathematics. Explicit overloads preserve the input width and perform no allocation.
 * isize and usize follow Aevix's currently supported 64-bit target ABIs.
 * @module math
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
import error { Error };
/*
 * Re-export the canonical classification type shared with pure floating utilities.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public import numeric { FloatClass };

/*
 * Explicit source-math failures; these do not add variants to the compiler's IntegerError.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public enum IntegerMathError implements Copy, Error {
/*
 * The exact arithmetic result is outside the declared output integer type.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    Overflow;
/*
 * The inclusive lower clamp bound is greater than the upper bound.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    InvalidBounds;
/*
 * Return a stable nonallocating diagnostic code.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public string_view code(&IntegerMathError self) {
        switch (*self) {
            case IntegerMathError.Overflow: return "math.integer_overflow"; break;
            case IntegerMathError.InvalidBounds: return "math.invalid_bounds"; break;
        }
    }

/*
 * Return a stable nonallocating summary.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public string_view message(&IntegerMathError self) {
        switch (*self) {
            case IntegerMathError.Overflow: return "The exact result does not fit its output integer type."; break;
            case IntegerMathError.InvalidBounds: return "The lower clamp bound exceeds the upper bound."; break;
        }
    }
};

/*
 * Return the lesser i8 value without conversion or allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i8 min(i8 left, i8 right) { return left < right ? left : right; }

/*
 * Return the greater i8 value without conversion or allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i8 max(i8 left, i8 right) { return left > right ? left : right; }

/*
 * Clamp i8 to inclusive bounds, returning InvalidBounds before any clamp if lower exceeds upper.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8, IntegerMathError> clamp(i8 value, i8 lower, i8 upper) {
    if (lower > upper) return Result.err(IntegerMathError.InvalidBounds);
    return Result.ok(value < lower ? lower : (value > upper ? upper : value));
}

/*
 * Return the exact i8 average rounded toward zero, without overflowing the sum.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i8 midpoint(i8 left, i8 right) {
    i8 halves = left / 2 + right / 2;
    i8 remainders = left % 2 + right % 2;
    i8 result = halves + remainders / 2;
    if (remainders % 2 != 0) {
        if (result > 0 && remainders < 0) return result - 1;
        if (result < 0 && remainders > 0) return result + 1;
    }
    return result;
}

/*
 * Return -1, 0, or 1 in i8 without changing its integer type.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i8 signum(i8 value) { return value < 0 ? -1 : (value == 0 ? 0 : 1); }

