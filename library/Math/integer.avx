    return Result.ok(left % right);
}

/*
 * Exact checked u32 power; zero exponent, including 0^0, returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u32,IntegerArithmeticError> checked_pow(u32 base, u32 exponent) {
    mut u32 result = 1u32;
    mut u32 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = checked_mul(result, factor)?;
        remaining /= 2u32;
        if (remaining != 0u32) factor = checked_mul(factor, factor)?;
    }
    return Result.ok(result);
}

