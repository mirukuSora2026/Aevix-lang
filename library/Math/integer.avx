 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u32,IntegerArithmeticError> checked_add(u32 left, u32 right) {
    if (left > 4294967295u32 - right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left + right);
}

/*
 * Exact checked u32 sub; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u32,IntegerArithmeticError> checked_sub(u32 left, u32 right) {
