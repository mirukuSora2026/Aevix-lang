public i32 wrapping_mul(i32 left, i32 right) {
    return signed_bits_i32(wrapping_mul(bits(left), bits(right)));
}

/*
 * Modular i32 negation; zero stays zero and signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i32 wrapping_neg(i32 value) {
    return wrapping_sub(0i32, value);
}

/*
 * i32 power modulo 2^32; zero exponent returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i32 wrapping_pow(i32 base, u32 exponent) {
    mut i32 result = 1i32;
    mut i32 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = wrapping_mul(result, factor);
        remaining /= 2u32;
        if (remaining != 0u32) factor = wrapping_mul(factor, factor);
    }
    return result;
}

/*
 * Modular absolute i32 value; signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i32 wrapping_abs(i32 value) {
    return value < 0i32 ? wrapping_neg(value) : value;
}

/*
 * i32 add clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i32 saturating_add(i32 left, i32 right) {
    switch (checked_add(left, right)) {
        case Result<i32,IntegerArithmeticError>.Ok { i32 output = value }: return output; break;
        default: return right < 0i32 ? -2147483648i32 : 2147483647i32; break;
    }
}

/*
 * Wrapped i32 add and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i32,bool> overflowing_add(i32 left, i32 right) {
    return Tuple.make(wrapping_add(left, right), has_error(checked_add(left, right)));
}

/*
 * i32 sub clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
