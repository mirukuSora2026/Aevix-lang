/*
 * Explicit-import integer arithmetic and bit utilities. No hidden allocation. IntegerArithmeticError is distinct from compiler IntegerError and math.IntegerMathError. Native-sized types follow the supported 64-bit targets.
 * @module integer
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */

import error { Error };

/*
 * Failures of explicitly imported arithmetic helpers; the canonical IntegerError is unchanged.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public enum IntegerArithmeticError implements Copy, Error {
/*
 * The exact arithmetic result cannot be represented by the requested output type.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
    Overflow;
/*
 * The divisor is zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
    DivisionByZero;
/*
 * Return a stable, allocation-free error code.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
    public string_view code(&Self self) {
        switch (*self) {
            case IntegerArithmeticError.Overflow: return "integer.overflow"; break;
            case IntegerArithmeticError.DivisionByZero: return "integer.division_by_zero"; break;
        }
    }
/*
 * Return a stable, allocation-free error description.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
    public string_view message(&Self self) {
        switch (*self) {
            case IntegerArithmeticError.Overflow: return "The exact result does not fit its integer type."; break;
            case IntegerArithmeticError.DivisionByZero: return "Integer division requires a nonzero divisor."; break;
        }
    }
};
T represent<T,U>(U value) {
    switch (Integer.convert<T>(value)) {
        case Result<T,IntegerError>.Ok { T output = value }: return output; break;
        default: Never.unreachable(); break;
    }
}
bool has_error<T>(Result<T,IntegerArithmeticError> outcome) {
    switch (move outcome) { case Result<T,IntegerArithmeticError>.Err: return true; break; default: return false; break; }
}

/*
 * The exact i8 minimum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const i8 MIN_I8 = -128i8;

/*
 * The exact i8 maximum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const i8 MAX_I8 = 127i8;

u8 bits(i8 value) { if (value >= 0i8) return represent<u8>(value); return 255u8 - represent<u8>(-(value + 1i8)); }

i8 signed_bits_i8(u8 value) { if (value <= 127u8) return represent<i8>(value); return -represent<i8>(255u8 - value) - 1i8; }

/*
 * Exact i8 magnitude, including MIN, returned in u8; never negate MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 unsigned_abs(i8 value) {
    return value < 0i8 ? represent<u8>(-(value + 1i8)) + 1u8 : represent<u8>(value);
}

/*
 * Exact checked i8 add; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_add(i8 left, i8 right) {
    if ((right > 0i8 && left > 127i8 - right) || (right < 0i8 && left < -128i8 - right)) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left + right);
}

/*
 * Exact checked i8 sub; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_sub(i8 left, i8 right) {
    if ((right > 0i8 && left < -128i8 + right) || (right < 0i8 && left > 127i8 + right)) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left - right);
}

/*
 * Exact checked i8 multiplication; division bounds avoid intermediate overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_mul(i8 left, i8 right) {
    if (left == 0i8 || right == 0i8) return Result.ok(0i8);
    bool negative = (left < 0i8) != (right < 0i8);
    u8 a = unsigned_abs(left);
    u8 b = unsigned_abs(right);
    u8 limit = negative ? 128u8 : 127u8;
    if (a > limit / b) return Result.err(IntegerArithmeticError.Overflow);
    u8 product = a * b;
    return Result.ok(negative ? -represent<i8>(product - 1u8) - 1i8 : represent<i8>(product));
}

/*
 * Checked truncated i8 div; MIN/-1 is Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_div(i8 left, i8 right) {
    if (right == 0i8) return Result.err(IntegerArithmeticError.DivisionByZero);
    if (left == -128i8 && right == -1i8) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left / right);
}

/*
 * Checked truncated i8 rem; MIN%-1 is zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_rem(i8 left, i8 right) {
    if (right == 0i8) return Result.err(IntegerArithmeticError.DivisionByZero);
    if (left == -128i8 && right == -1i8) return Result.ok(0i8);
    return Result.ok(left % right);
}

/*
 * Exact checked i8 power; zero exponent, including 0^0, returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_pow(i8 base, u32 exponent) {
    mut i8 result = 1i8;
    mut i8 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = checked_mul(result, factor)?;
        remaining /= 2u32;
        if (remaining != 0u32) factor = checked_mul(factor, factor)?;
    }
    return Result.ok(result);
}

/*
 * Checked signed i8 neg; MIN produces Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_neg(i8 value) {
    if (value == -128i8) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(-value);
}

/*
 * Checked signed i8 abs; MIN produces Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i8,IntegerArithmeticError> checked_abs(i8 value) {
    if (value == -128i8) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(value < 0i8 ? -value : value);
}

/*
 * i8 add modulo 2^8, reinterpreted without out-of-range casts.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 wrapping_add(i8 left, i8 right) {
    return signed_bits_i8(wrapping_add(bits(left), bits(right)));
}

/*
 * i8 sub modulo 2^8, reinterpreted without out-of-range casts.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 wrapping_sub(i8 left, i8 right) {
    return signed_bits_i8(wrapping_sub(bits(left), bits(right)));
}

/*
 * i8 mul modulo 2^8, reinterpreted without out-of-range casts.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 wrapping_mul(i8 left, i8 right) {
    return signed_bits_i8(wrapping_mul(bits(left), bits(right)));
}

/*
 * Modular i8 negation; zero stays zero and signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 wrapping_neg(i8 value) {
    return wrapping_sub(0i8, value);
}

/*
 * i8 power modulo 2^8; zero exponent returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 wrapping_pow(i8 base, u32 exponent) {
    mut i8 result = 1i8;
    mut i8 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = wrapping_mul(result, factor);
        remaining /= 2u32;
        if (remaining != 0u32) factor = wrapping_mul(factor, factor);
    }
    return result;
}

/*
 * Modular absolute i8 value; signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 wrapping_abs(i8 value) {
    return value < 0i8 ? wrapping_neg(value) : value;
}

/*
 * i8 add clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 saturating_add(i8 left, i8 right) {
    switch (checked_add(left, right)) {
        case Result<i8,IntegerArithmeticError>.Ok { i8 output = value }: return output; break;
        default: return right < 0i8 ? -128i8 : 127i8; break;
    }
}

/*
 * Wrapped i8 add and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i8,bool> overflowing_add(i8 left, i8 right) {
    return Tuple.make(wrapping_add(left, right), has_error(checked_add(left, right)));
}

/*
 * i8 sub clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 saturating_sub(i8 left, i8 right) {
    switch (checked_sub(left, right)) {
        case Result<i8,IntegerArithmeticError>.Ok { i8 output = value }: return output; break;
        default: return right > 0i8 ? -128i8 : 127i8; break;
    }
}

/*
 * Wrapped i8 sub and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i8,bool> overflowing_sub(i8 left, i8 right) {
    return Tuple.make(wrapping_sub(left, right), has_error(checked_sub(left, right)));
}

/*
 * i8 mul clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 saturating_mul(i8 left, i8 right) {
    switch (checked_mul(left, right)) {
        case Result<i8,IntegerArithmeticError>.Ok { i8 output = value }: return output; break;
        default: return (left < 0i8) != (right < 0i8) ? -128i8 : 127i8; break;
    }
}

/*
 * Wrapped i8 mul and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i8,bool> overflowing_mul(i8 left, i8 right) {
    return Tuple.make(wrapping_mul(left, right), has_error(checked_mul(left, right)));
}

/*
 * i8 power clamped to its bounds; exponent zero returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 saturating_pow(i8 base, u32 exponent) {
    switch (checked_pow(base, exponent)) {
        case Result<i8,IntegerArithmeticError>.Ok { i8 output = value }: return output; break;
        default: return base < 0i8 && exponent % 2u32 != 0u32 ? -128i8 : 127i8; break;
    }
}

/*
 * Wrapped i8 power and exact overflow flag; exponent zero returns one and false.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i8,bool> overflowing_pow(i8 base, u32 exponent) {
    return Tuple.make(wrapping_pow(base, exponent), has_error(checked_pow(base, exponent)));
}

/*
 * i8 neg clamped at MAX for MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 saturating_neg(i8 value) {
    if (value == -128i8) return 127i8;
    return -value;
}

/*
 * Wrapped i8 neg and MIN overflow flag.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i8,bool> overflowing_neg(i8 value) {
    return Tuple.make(wrapping_neg(value), value == -128i8);
}

/*
 * i8 abs clamped at MAX for MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 saturating_abs(i8 value) {
    if (value == -128i8) return 127i8;
    return value < 0i8 ? -value : value;
}

/*
 * Wrapped i8 abs and MIN overflow flag.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<i8,bool> overflowing_abs(i8 value) {
    return Tuple.make(wrapping_abs(value), value == -128i8);
}

/*
 * Test zero for i8 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_zero(i8 value) {
    return value == 0i8;
}

/*
 * Test negative for i8 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_negative(i8 value) {
    return value < 0i8;
}

/*
 * Test positive for i8 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_positive(i8 value) {
    return value > 0i8;
}

/*
 * Test even for i8 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_even(i8 value) {
    return value % 2i8 == 0i8;
}

/*
 * Test odd for i8 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_odd(i8 value) {
    return value % 2i8 != 0i8;
}

/*
 * Test power of two for i8 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_power_of_two(i8 value) {
    return value > 0i8 && (bits(value) & (bits(value) - 1u8)) == 0u8;
}

/*
 * Exact i8 divisibility; only zero is a multiple of zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_multiple_of(i8 left, i8 right) {
    if (right == 0i8) return left == 0i8;
    if (left == -128i8 && right == -1i8) return true;
    return left % right == 0i8;
}

/*
 * Number of set bits in the full 8-bit i8 representation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_ones(i8 value) {
    mut u8 remaining = bits(value);
    mut u32 count = 0u32;
    while (remaining != 0u8) { remaining &= remaining - 1u8; count++; }
    return count;
}

/*
 * Number of zero bits in the full 8-bit i8 representation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_zeros(i8 value) {
    return 8u32 - count_ones(value);
}

/*
 * Count leading zero bits of i8; zero returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 leading_zeros(i8 value) {
    mut u8 remaining = bits(value);
    mut u32 count = 0u32;
    while (count < 8u32 && (remaining & 128u8) == 0u8) { remaining = remaining << 1u32; count++; }
    return count;
}

/*
 * Count leading one bits of i8; all ones returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 leading_ones(i8 value) {
    return leading_zeros(signed_bits_i8(~bits(value)));
}

/*
 * Count trailing zero bits of i8; zero returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_zeros(i8 value) {
    mut u8 remaining = bits(value);
    mut u32 count = 0u32;
    while (count < 8u32 && (remaining & 1u8) == 0u8) { remaining = remaining >> 1u32; count++; }
    return count;
}

/*
 * Count trailing one bits of i8; all ones returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_ones(i8 value) {
    return trailing_zeros(signed_bits_i8(~bits(value)));
}

/*
 * Bit length of the mathematical i8 magnitude; zero returns zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 bit_length(i8 value) {
    u8 magnitude = unsigned_abs(value);
    return 8u32 - leading_zeros(magnitude);
}

/*
 * Reverse all 8 bits of i8, preserving its numeric type.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 reverse_bits(i8 value) {
    mut u8 remaining = bits(value);
    mut u8 output = 0u8;
    mut u32 position = 0u32;
    while (position < 8u32) { output = (output << 1u32) | (remaining & 1u8); remaining = remaining >> 1u32; position++; }
    return signed_bits_i8(output);
}

/*
 * Reverse i8 byte order; bit order inside each byte is preserved.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 swap_bytes(i8 value) {
    mut u8 remaining = bits(value);
    mut u8 output = 0u8;
    mut u32 position = 0u32;
    while (position < 1u32) { output = (output << 0u32) | (remaining & 255u8); remaining = remaining >> 0u32; position++; }
    return signed_bits_i8(output);
}

/*
 * Rotate i8 bits left; count is reduced modulo 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 rotate_left(i8 value, u32 count) {
    u32 amount = count % 8u32;
    if (amount == 0u32) return value;
    u8 raw = bits(value);
    return signed_bits_i8((raw << amount) | (raw >> (8u32 - amount)));
}

/*
 * Rotate i8 bits right; count is reduced modulo 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i8 rotate_right(i8 value, u32 count) {
    u32 amount = count % 8u32;
    if (amount == 0u32) return value;
    u8 raw = bits(value);
    return signed_bits_i8((raw >> amount) | (raw << (8u32 - amount)));
}

/*
 * Unsigned mask of the highest set representation bit of i8, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 highest_one_bit(i8 value) {
    if (value == 0i8) return 0u8;
    return 1u8 << (7u32 - leading_zeros(value));
}

/*
 * Unsigned mask of the lowest set representation bit of i8, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 lowest_one_bit(i8 value) {
    u8 raw = bits(value);
    return raw == 0u8 ? 0u8 : raw & (~raw + 1u8);
}

/*
 * Exact nonnegative difference of i8 values, in u8, including both numeric extremes.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 abs_diff(i8 left, i8 right) {
    u8 a = unsigned_abs(left);
    u8 b = unsigned_abs(right);
    if ((left < 0i8) != (right < 0i8)) return a + b;
    return a > b ? a - b : b - a;
}

/*
 * The exact u8 minimum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const u8 MIN_U8 = 0u8;

/*
 * The exact u8 maximum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const u8 MAX_U8 = 255u8;

u8 bits(u8 value) { return value; }

/*
 * Exact checked u8 add; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8,IntegerArithmeticError> checked_add(u8 left, u8 right) {
    if (left > 255u8 - right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left + right);
}

/*
 * Exact checked u8 sub; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8,IntegerArithmeticError> checked_sub(u8 left, u8 right) {
    if (left < right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left - right);
}

/*
 * Exact checked u8 multiplication; division bounds avoid intermediate overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8,IntegerArithmeticError> checked_mul(u8 left, u8 right) {
    if (right != 0u8 && left > 255u8 / right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left * right);
}

/*
 * Checked truncated u8 div; Zero divisor is DivisionByZero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8,IntegerArithmeticError> checked_div(u8 left, u8 right) {
    if (right == 0u8) return Result.err(IntegerArithmeticError.DivisionByZero);
    return Result.ok(left / right);
}

/*
 * Checked truncated u8 rem; Zero divisor is DivisionByZero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8,IntegerArithmeticError> checked_rem(u8 left, u8 right) {
    if (right == 0u8) return Result.err(IntegerArithmeticError.DivisionByZero);
    return Result.ok(left % right);
}

/*
 * Exact checked u8 power; zero exponent, including 0^0, returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u8,IntegerArithmeticError> checked_pow(u8 base, u32 exponent) {
    mut u8 result = 1u8;
    mut u8 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = checked_mul(result, factor)?;
        remaining /= 2u32;
        if (remaining != 0u32) factor = checked_mul(factor, factor)?;
    }
    return Result.ok(result);
}

/*
 * u8 addition modulo 2^8, without overflowing an intermediate.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 wrapping_add(u8 left, u8 right) {
    return left > 255u8 - right ? left - (255u8 - right) - 1u8 : left + right;
}

/*
 * u8 subtraction modulo 2^8, without underflowing an intermediate.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 wrapping_sub(u8 left, u8 right) {
    return left < right ? 255u8 - (right - left) + 1u8 : left - right;
}

/*
 * u8 product modulo 2^8, using bounded modular additions.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 wrapping_mul(u8 left, u8 right) {
    mut u8 result = 0u8;
    mut u8 factor = left;
    mut u8 remaining = right;
    while (remaining != 0u8) {
        if (remaining % 2u8 != 0u8) result = wrapping_add(result, factor);
        remaining /= 2u8;
        if (remaining != 0u8) factor = wrapping_add(factor, factor);
    }
    return result;
}

/*
 * Modular u8 negation; zero stays zero and signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 wrapping_neg(u8 value) {
    return wrapping_sub(0u8, value);
}

/*
 * u8 power modulo 2^8; zero exponent returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 wrapping_pow(u8 base, u32 exponent) {
    mut u8 result = 1u8;
    mut u8 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = wrapping_mul(result, factor);
        remaining /= 2u32;
        if (remaining != 0u32) factor = wrapping_mul(factor, factor);
    }
    return result;
}

/*
 * u8 add clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 saturating_add(u8 left, u8 right) {
    switch (checked_add(left, right)) {
        case Result<u8,IntegerArithmeticError>.Ok { u8 output = value }: return output; break;
        default: return 255u8; break;
