 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 wrapping_mul(u32 left, u32 right) {
    mut u32 result = 0u32;
    mut u32 factor = left;
    mut u32 remaining = right;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = wrapping_add(result, factor);
        remaining /= 2u32;
        if (remaining != 0u32) factor = wrapping_add(factor, factor);
    }
    return result;
}

