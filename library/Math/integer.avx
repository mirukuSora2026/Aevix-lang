 * i32 add modulo 2^32, reinterpreted without out-of-range casts.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i32 wrapping_add(i32 left, i32 right) {
    return signed_bits_i32(wrapping_add(bits(left), bits(right)));
