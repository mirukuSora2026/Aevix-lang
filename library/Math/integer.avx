    return Result.ok(left - right);
}

/*
 * Exact checked u32 multiplication; division bounds avoid intermediate overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u32,IntegerArithmeticError> checked_mul(u32 left, u32 right) {
    if (right != 0u32 && left > 4294967295u32 / right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left * right);
}

/*
