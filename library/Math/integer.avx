 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize rotate_right(usize value, u32 count) {
    u32 amount = count % 64u32;
    if (amount == 0u32) return value;
    usize raw = bits(value);
    return (raw >> amount) | (raw << (64u32 - amount));
}

/*
 * Unsigned mask of the highest set representation bit of usize, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize highest_one_bit(usize value) {
    if (value == 0usize) return 0usize;
    return 1usize << (63u32 - leading_zeros(value));
}

/*
 * Unsigned mask of the lowest set representation bit of usize, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize lowest_one_bit(usize value) {
    usize raw = bits(value);
    return raw == 0usize ? 0usize : raw & (~raw + 1usize);
}

/*
 * Exact nonnegative difference of usize values, in usize, including both numeric extremes.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize abs_diff(usize left, usize right) {
    usize a = left;
    usize b = right;
    return a > b ? a - b : b - a;
}
