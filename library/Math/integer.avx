/*
 * Modular i16 negation; zero stays zero and signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 wrapping_neg(i16 value) {
    return wrapping_sub(0i16, value);
}

/*
 * i16 power modulo 2^16; zero exponent returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 wrapping_pow(i16 base, u32 exponent) {
    mut i16 result = 1i16;
    mut i16 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = wrapping_mul(result, factor);
        remaining /= 2u32;
        if (remaining != 0u32) factor = wrapping_mul(factor, factor);
    }
    return result;
}

/*
 * Modular absolute i16 value; signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 wrapping_abs(i16 value) {
    return value < 0i16 ? wrapping_neg(value) : value;
}

/*
 * i16 add clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 saturating_add(i16 left, i16 right) {
    switch (checked_add(left, right)) {
        case Result<i16,IntegerArithmeticError>.Ok { i16 output = value }: return output; break;
        default: return right < 0i16 ? -32768i16 : 32767i16; break;
    }
}

/*
 * Wrapped i16 add and true exactly when its mathematical result does not fit.
