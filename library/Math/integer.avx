    mut u16 output = 0u16;
    mut u32 position = 0u32;
    while (position < 16u32) { output = (output << 1u32) | (remaining & 1u16); remaining = remaining >> 1u32; position++; }
    return signed_bits_i16(output);
}

/*
 * Reverse i16 byte order; bit order inside each byte is preserved.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 swap_bytes(i16 value) {
    mut u16 remaining = bits(value);
    mut u16 output = 0u16;
    mut u32 position = 0u32;
    while (position < 2u32) { output = (output << 8u32) | (remaining & 255u16); remaining = remaining >> 8u32; position++; }
    return signed_bits_i16(output);
}

/*
 * Rotate i16 bits left; count is reduced modulo 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 rotate_left(i16 value, u32 count) {
    u32 amount = count % 16u32;
    if (amount == 0u32) return value;
    u16 raw = bits(value);
    return signed_bits_i16((raw << amount) | (raw >> (16u32 - amount)));
}

/*
 * Rotate i16 bits right; count is reduced modulo 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 rotate_right(i16 value, u32 count) {
    u32 amount = count % 16u32;
    if (amount == 0u32) return value;
    u16 raw = bits(value);
    return signed_bits_i16((raw >> amount) | (raw << (16u32 - amount)));
}

/*
 * Unsigned mask of the highest set representation bit of i16, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 highest_one_bit(i16 value) {
    if (value == 0i16) return 0u16;
    return 1u16 << (15u32 - leading_zeros(value));
}

/*
 * Unsigned mask of the lowest set representation bit of i16, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 lowest_one_bit(i16 value) {
    u16 raw = bits(value);
    return raw == 0u16 ? 0u16 : raw & (~raw + 1u16);
}

/*
 * Exact nonnegative difference of i16 values, in u16, including both numeric extremes.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 abs_diff(i16 left, i16 right) {
    u16 a = unsigned_abs(left);
    u16 b = unsigned_abs(right);
    if ((left < 0i16) != (right < 0i16)) return a + b;
    return a > b ? a - b : b - a;
}

/*
 * The exact u16 minimum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const u16 MIN_U16 = 0u16;

/*
 * The exact u16 maximum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const u16 MAX_U16 = 65535u16;

u16 bits(u16 value) { return value; }

/*
 * Exact checked u16 add; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16,IntegerArithmeticError> checked_add(u16 left, u16 right) {
    if (left > 65535u16 - right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left + right);
}

/*
 * Exact checked u16 sub; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16,IntegerArithmeticError> checked_sub(u16 left, u16 right) {
    if (left < right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left - right);
}

/*
 * Exact checked u16 multiplication; division bounds avoid intermediate overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16,IntegerArithmeticError> checked_mul(u16 left, u16 right) {
    if (right != 0u16 && left > 65535u16 / right) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left * right);
}

/*
 * Checked truncated u16 div; Zero divisor is DivisionByZero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16,IntegerArithmeticError> checked_div(u16 left, u16 right) {
    if (right == 0u16) return Result.err(IntegerArithmeticError.DivisionByZero);
    return Result.ok(left / right);
}

/*
 * Checked truncated u16 rem; Zero divisor is DivisionByZero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16,IntegerArithmeticError> checked_rem(u16 left, u16 right) {
    if (right == 0u16) return Result.err(IntegerArithmeticError.DivisionByZero);
    return Result.ok(left % right);
}

/*
 * Exact checked u16 power; zero exponent, including 0^0, returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<u16,IntegerArithmeticError> checked_pow(u16 base, u32 exponent) {
    mut u16 result = 1u16;
    mut u16 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = checked_mul(result, factor)?;
        remaining /= 2u32;
        if (remaining != 0u32) factor = checked_mul(factor, factor)?;
    }
    return Result.ok(result);
}

/*
 * u16 addition modulo 2^16, without overflowing an intermediate.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 wrapping_add(u16 left, u16 right) {
    return left > 65535u16 - right ? left - (65535u16 - right) - 1u16 : left + right;
}

/*
 * u16 subtraction modulo 2^16, without underflowing an intermediate.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 wrapping_sub(u16 left, u16 right) {
    return left < right ? 65535u16 - (right - left) + 1u16 : left - right;
}

/*
 * u16 product modulo 2^16, using bounded modular additions.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 wrapping_mul(u16 left, u16 right) {
    mut u16 result = 0u16;
    mut u16 factor = left;
    mut u16 remaining = right;
    while (remaining != 0u16) {
        if (remaining % 2u16 != 0u16) result = wrapping_add(result, factor);
        remaining /= 2u16;
        if (remaining != 0u16) factor = wrapping_add(factor, factor);
    }
    return result;
}

/*
 * Modular u16 negation; zero stays zero and signed MIN stays MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 wrapping_neg(u16 value) {
    return wrapping_sub(0u16, value);
}

/*
 * u16 power modulo 2^16; zero exponent returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 wrapping_pow(u16 base, u32 exponent) {
    mut u16 result = 1u16;
    mut u16 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = wrapping_mul(result, factor);
        remaining /= 2u32;
        if (remaining != 0u32) factor = wrapping_mul(factor, factor);
    }
    return result;
}

/*
 * u16 add clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 saturating_add(u16 left, u16 right) {
    switch (checked_add(left, right)) {
        case Result<u16,IntegerArithmeticError>.Ok { u16 output = value }: return output; break;
        default: return 65535u16; break;
    }
}

/*
 * Wrapped u16 add and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<u16,bool> overflowing_add(u16 left, u16 right) {
    return Tuple.make(wrapping_add(left, right), has_error(checked_add(left, right)));
}

/*
 * u16 sub clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 saturating_sub(u16 left, u16 right) {
    switch (checked_sub(left, right)) {
        case Result<u16,IntegerArithmeticError>.Ok { u16 output = value }: return output; break;
        default: return 0u16; break;
    }
}

/*
 * Wrapped u16 sub and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<u16,bool> overflowing_sub(u16 left, u16 right) {
    return Tuple.make(wrapping_sub(left, right), has_error(checked_sub(left, right)));
}

/*
 * u16 mul clamped to its exact numeric bounds.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 saturating_mul(u16 left, u16 right) {
    switch (checked_mul(left, right)) {
        case Result<u16,IntegerArithmeticError>.Ok { u16 output = value }: return output; break;
        default: return 65535u16; break;
    }
}

/*
 * Wrapped u16 mul and true exactly when its mathematical result does not fit.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<u16,bool> overflowing_mul(u16 left, u16 right) {
    return Tuple.make(wrapping_mul(left, right), has_error(checked_mul(left, right)));
}

/*
 * u16 power clamped to its bounds; exponent zero returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 saturating_pow(u16 base, u32 exponent) {
    switch (checked_pow(base, exponent)) {
        case Result<u16,IntegerArithmeticError>.Ok { u16 output = value }: return output; break;
        default: return 65535u16; break;
    }
}

/*
 * Wrapped u16 power and exact overflow flag; exponent zero returns one and false.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Tuple<u16,bool> overflowing_pow(u16 base, u32 exponent) {
    return Tuple.make(wrapping_pow(base, exponent), has_error(checked_pow(base, exponent)));
}

/*
 * Test zero for u16 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_zero(u16 value) {
    return value == 0u16;
}

/*
 * Test negative for u16 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_negative(u16 value) {
    return false;
}

/*
 * Test positive for u16 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_positive(u16 value) {
    return value > 0u16;
}

/*
 * Test even for u16 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_even(u16 value) {
    return value % 2u16 == 0u16;
}

/*
 * Test odd for u16 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_odd(u16 value) {
    return value % 2u16 != 0u16;
}

/*
 * Test power of two for u16 without allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_power_of_two(u16 value) {
    return value > 0u16 && (bits(value) & (bits(value) - 1u16)) == 0u16;
}

/*
 * Exact u16 divisibility; only zero is a multiple of zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_multiple_of(u16 left, u16 right) {
    if (right == 0u16) return left == 0u16;
    return left % right == 0u16;
}

/*
 * Number of set bits in the full 16-bit u16 representation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_ones(u16 value) {
    mut u16 remaining = bits(value);
    mut u32 count = 0u32;
    while (remaining != 0u16) { remaining &= remaining - 1u16; count++; }
    return count;
}

/*
 * Number of zero bits in the full 16-bit u16 representation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_zeros(u16 value) {
    return 16u32 - count_ones(value);
}

/*
 * Count leading zero bits of u16; zero returns 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 leading_zeros(u16 value) {
    mut u16 remaining = bits(value);
    mut u32 count = 0u32;
    while (count < 16u32 && (remaining & 32768u16) == 0u16) { remaining = remaining << 1u32; count++; }
    return count;
}

/*
 * Count leading one bits of u16; all ones returns 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 leading_ones(u16 value) {
    return leading_zeros(~bits(value));
}

/*
 * Count trailing zero bits of u16; zero returns 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_zeros(u16 value) {
    mut u16 remaining = bits(value);
    mut u32 count = 0u32;
    while (count < 16u32 && (remaining & 1u16) == 0u16) { remaining = remaining >> 1u32; count++; }
    return count;
}

/*
 * Count trailing one bits of u16; all ones returns 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_ones(u16 value) {
    return trailing_zeros(~bits(value));
}

/*
 * Bit length of the mathematical u16 magnitude; zero returns zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 bit_length(u16 value) {
    u16 magnitude = value;
    return 16u32 - leading_zeros(magnitude);
}

/*
 * Reverse all 16 bits of u16, preserving its numeric type.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 reverse_bits(u16 value) {
    mut u16 remaining = bits(value);
    mut u16 output = 0u16;
    mut u32 position = 0u32;
    while (position < 16u32) { output = (output << 1u32) | (remaining & 1u16); remaining = remaining >> 1u32; position++; }
    return output;
}

/*
 * Reverse u16 byte order; bit order inside each byte is preserved.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 swap_bytes(u16 value) {
    mut u16 remaining = bits(value);
    mut u16 output = 0u16;
    mut u32 position = 0u32;
    while (position < 2u32) { output = (output << 8u32) | (remaining & 255u16); remaining = remaining >> 8u32; position++; }
    return output;
}

/*
 * Rotate u16 bits left; count is reduced modulo 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 rotate_left(u16 value, u32 count) {
    u32 amount = count % 16u32;
    if (amount == 0u32) return value;
    u16 raw = bits(value);
    return (raw << amount) | (raw >> (16u32 - amount));
}

/*
 * Rotate u16 bits right; count is reduced modulo 16.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 rotate_right(u16 value, u32 count) {
    u32 amount = count % 16u32;
    if (amount == 0u32) return value;
    u16 raw = bits(value);
    return (raw >> amount) | (raw << (16u32 - amount));
}

/*
 * Unsigned mask of the highest set representation bit of u16, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 highest_one_bit(u16 value) {
    if (value == 0u16) return 0u16;
    return 1u16 << (15u32 - leading_zeros(value));
}

/*
 * Unsigned mask of the lowest set representation bit of u16, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 lowest_one_bit(u16 value) {
    u16 raw = bits(value);
    return raw == 0u16 ? 0u16 : raw & (~raw + 1u16);
}

/*
 * Exact nonnegative difference of u16 values, in u16, including both numeric extremes.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 abs_diff(u16 left, u16 right) {
    u16 a = left;
    u16 b = right;
    return a > b ? a - b : b - a;
}

/*
 * The exact i32 minimum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const i32 MIN_I32 = -2147483648i32;

/*
 * The exact i32 maximum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const i32 MAX_I32 = 2147483647i32;

u32 bits(i32 value) { if (value >= 0i32) return represent<u32>(value); return 4294967295u32 - represent<u32>(-(value + 1i32)); }

i32 signed_bits_i32(u32 value) { if (value <= 2147483647u32) return represent<i32>(value); return -represent<i32>(4294967295u32 - value) - 1i32; }

/*
 * Exact i32 magnitude, including MIN, returned in u32; never negate MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 unsigned_abs(i32 value) {
    return value < 0i32 ? represent<u32>(-(value + 1i32)) + 1u32 : represent<u32>(value);
}

/*
 * Exact checked i32 add; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_add(i32 left, i32 right) {
    if ((right > 0i32 && left > 2147483647i32 - right) || (right < 0i32 && left < -2147483648i32 - right)) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left + right);
}

/*
 * Exact checked i32 sub; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_sub(i32 left, i32 right) {
    if ((right > 0i32 && left < -2147483648i32 + right) || (right < 0i32 && left > 2147483647i32 + right)) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left - right);
}

/*
 * Exact checked i32 multiplication; division bounds avoid intermediate overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_mul(i32 left, i32 right) {
    if (left == 0i32 || right == 0i32) return Result.ok(0i32);
    bool negative = (left < 0i32) != (right < 0i32);
    u32 a = unsigned_abs(left);
    u32 b = unsigned_abs(right);
    u32 limit = negative ? 2147483648u32 : 2147483647u32;
    if (a > limit / b) return Result.err(IntegerArithmeticError.Overflow);
    u32 product = a * b;
    return Result.ok(negative ? -represent<i32>(product - 1u32) - 1i32 : represent<i32>(product));
}

/*
 * Checked truncated i32 div; MIN/-1 is Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_div(i32 left, i32 right) {
    if (right == 0i32) return Result.err(IntegerArithmeticError.DivisionByZero);
    if (left == -2147483648i32 && right == -1i32) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left / right);
}

/*
 * Checked truncated i32 rem; MIN%-1 is zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_rem(i32 left, i32 right) {
    if (right == 0i32) return Result.err(IntegerArithmeticError.DivisionByZero);
    if (left == -2147483648i32 && right == -1i32) return Result.ok(0i32);
    return Result.ok(left % right);
}

/*
 * Exact checked i32 power; zero exponent, including 0^0, returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_pow(i32 base, u32 exponent) {
    mut i32 result = 1i32;
    mut i32 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = checked_mul(result, factor)?;
        remaining /= 2u32;
        if (remaining != 0u32) factor = checked_mul(factor, factor)?;
    }
    return Result.ok(result);
}

/*
 * Checked signed i32 neg; MIN produces Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_neg(i32 value) {
    if (value == -2147483648i32) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(-value);
}

/*
 * Checked signed i32 abs; MIN produces Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i32,IntegerArithmeticError> checked_abs(i32 value) {
    if (value == -2147483648i32) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(value < 0i32 ? -value : value);
}

