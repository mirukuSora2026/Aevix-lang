 */
public bool is_power_of_two(u8 value) {
    return value > 0u8 && (bits(value) & (bits(value) - 1u8)) == 0u8;
}

/*
 * Exact u8 divisibility; only zero is a multiple of zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public bool is_multiple_of(u8 left, u8 right) {
    if (right == 0u8) return left == 0u8;
    return left % right == 0u8;
}

/*
 * Number of set bits in the full 8-bit u8 representation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_ones(u8 value) {
    mut u8 remaining = bits(value);
    mut u32 count = 0u32;
    while (remaining != 0u8) { remaining &= remaining - 1u8; count++; }
    return count;
}

/*
 * Number of zero bits in the full 8-bit u8 representation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 count_zeros(u8 value) {
    return 8u32 - count_ones(value);
}

/*
 * Count leading zero bits of u8; zero returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 leading_zeros(u8 value) {
    mut u8 remaining = bits(value);
    mut u32 count = 0u32;
    while (count < 8u32 && (remaining & 128u8) == 0u8) { remaining = remaining << 1u32; count++; }
    return count;
}

/*
 * Count leading one bits of u8; all ones returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 leading_ones(u8 value) {
    return leading_zeros(~bits(value));
}

/*
 * Count trailing zero bits of u8; zero returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_zeros(u8 value) {
    mut u8 remaining = bits(value);
    mut u32 count = 0u32;
    while (count < 8u32 && (remaining & 1u8) == 0u8) { remaining = remaining >> 1u32; count++; }
    return count;
}

/*
 * Count trailing one bits of u8; all ones returns 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 trailing_ones(u8 value) {
    return trailing_zeros(~bits(value));
}

/*
 * Bit length of the mathematical u8 magnitude; zero returns zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u32 bit_length(u8 value) {
    u8 magnitude = value;
    return 8u32 - leading_zeros(magnitude);
}

/*
 * Reverse all 8 bits of u8, preserving its numeric type.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 reverse_bits(u8 value) {
    mut u8 remaining = bits(value);
    mut u8 output = 0u8;
    mut u32 position = 0u32;
    while (position < 8u32) { output = (output << 1u32) | (remaining & 1u8); remaining = remaining >> 1u32; position++; }
    return output;
}

/*
 * Reverse u8 byte order; bit order inside each byte is preserved.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 swap_bytes(u8 value) {
    mut u8 remaining = bits(value);
    mut u8 output = 0u8;
    mut u32 position = 0u32;
    while (position < 1u32) { output = (output << 0u32) | (remaining & 255u8); remaining = remaining >> 0u32; position++; }
    return output;
}

/*
 * Rotate u8 bits left; count is reduced modulo 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 rotate_left(u8 value, u32 count) {
    u32 amount = count % 8u32;
    if (amount == 0u32) return value;
    u8 raw = bits(value);
    return (raw << amount) | (raw >> (8u32 - amount));
}

/*
 * Rotate u8 bits right; count is reduced modulo 8.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 rotate_right(u8 value, u32 count) {
    u32 amount = count % 8u32;
    if (amount == 0u32) return value;
    u8 raw = bits(value);
    return (raw >> amount) | (raw << (8u32 - amount));
}

/*
 * Unsigned mask of the highest set representation bit of u8, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 highest_one_bit(u8 value) {
    if (value == 0u8) return 0u8;
    return 1u8 << (7u32 - leading_zeros(value));
}

/*
 * Unsigned mask of the lowest set representation bit of u8, or zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 lowest_one_bit(u8 value) {
    u8 raw = bits(value);
    return raw == 0u8 ? 0u8 : raw & (~raw + 1u8);
}

/*
 * Exact nonnegative difference of u8 values, in u8, including both numeric extremes.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u8 abs_diff(u8 left, u8 right) {
    u8 a = left;
    u8 b = right;
    return a > b ? a - b : b - a;
}

/*
 * The exact i16 minimum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const i16 MIN_I16 = -32768i16;

/*
 * The exact i16 maximum value.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public const i16 MAX_I16 = 32767i16;

u16 bits(i16 value) { if (value >= 0i16) return represent<u16>(value); return 65535u16 - represent<u16>(-(value + 1i16)); }

i16 signed_bits_i16(u16 value) { if (value <= 32767u16) return represent<i16>(value); return -represent<i16>(65535u16 - value) - 1i16; }

/*
 * Exact i16 magnitude, including MIN, returned in u16; never negate MIN.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public u16 unsigned_abs(i16 value) {
    return value < 0i16 ? represent<u16>(-(value + 1i16)) + 1u16 : represent<u16>(value);
}

/*
 * Exact checked i16 add; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_add(i16 left, i16 right) {
    if ((right > 0i16 && left > 32767i16 - right) || (right < 0i16 && left < -32768i16 - right)) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left + right);
}

/*
 * Exact checked i16 sub; precheck before ordinary arithmetic.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_sub(i16 left, i16 right) {
    if ((right > 0i16 && left < -32768i16 + right) || (right < 0i16 && left > 32767i16 + right)) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left - right);
}

/*
 * Exact checked i16 multiplication; division bounds avoid intermediate overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_mul(i16 left, i16 right) {
    if (left == 0i16 || right == 0i16) return Result.ok(0i16);
    bool negative = (left < 0i16) != (right < 0i16);
    u16 a = unsigned_abs(left);
    u16 b = unsigned_abs(right);
    u16 limit = negative ? 32768u16 : 32767u16;
    if (a > limit / b) return Result.err(IntegerArithmeticError.Overflow);
    u16 product = a * b;
    return Result.ok(negative ? -represent<i16>(product - 1u16) - 1i16 : represent<i16>(product));
}

/*
 * Checked truncated i16 div; MIN/-1 is Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_div(i16 left, i16 right) {
    if (right == 0i16) return Result.err(IntegerArithmeticError.DivisionByZero);
    if (left == -32768i16 && right == -1i16) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(left / right);
}

/*
 * Checked truncated i16 rem; MIN%-1 is zero.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_rem(i16 left, i16 right) {
    if (right == 0i16) return Result.err(IntegerArithmeticError.DivisionByZero);
    if (left == -32768i16 && right == -1i16) return Result.ok(0i16);
    return Result.ok(left % right);
}

/*
 * Exact checked i16 power; zero exponent, including 0^0, returns one.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_pow(i16 base, u32 exponent) {
    mut i16 result = 1i16;
    mut i16 factor = base;
    mut u32 remaining = exponent;
    while (remaining != 0u32) {
        if (remaining % 2u32 != 0u32) result = checked_mul(result, factor)?;
        remaining /= 2u32;
        if (remaining != 0u32) factor = checked_mul(factor, factor)?;
    }
    return Result.ok(result);
}

/*
 * Checked signed i16 neg; MIN produces Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_neg(i16 value) {
    if (value == -32768i16) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(-value);
}

/*
 * Checked signed i16 abs; MIN produces Overflow.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<i16,IntegerArithmeticError> checked_abs(i16 value) {
    if (value == -32768i16) return Result.err(IntegerArithmeticError.Overflow);
    return Result.ok(value < 0i16 ? -value : value);
}

/*
 * i16 add modulo 2^16, reinterpreted without out-of-range casts.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public i16 wrapping_add(i16 left, i16 right) {
    return signed_bits_i16(wrapping_add(bits(left), bits(right)));
}

/*
 * i16 sub modulo 2^16, reinterpreted without out-of-range casts.
 * @since 0.3.0
 * @deprecated_at none
