public Result<Optional<V>, InputError<Entry<string, V>>> insert<V>(&mut Map<string, V> table, string key, V value) {
    u64 code = hash.value(&key);
    rsn same = [](&string left, &string right) -> bool { return hash.equal(left, right); };
    return table.insert_with(key, value, code, &same);
}

