private u64 text_digits(Slice<byte> bytes) {
    mut u64 state = 0;
    mut usize index = 0;
    while (index < Slice.len(bytes)) { state = mix(state, value(&bytes[index])); index++; }
    return state;
}
private i32 text_compare(Slice<byte> left, Slice<byte> right) {
    mut usize index = 0;
    while (index < Slice.len(left) && index < Slice.len(right)) {
        if (left[index] < right[index]) return -1;
        if (left[index] > right[index]) return 1;
        index++;
    }
    return Slice.len(left) < Slice.len(right) ? -1 : Slice.len(left) > Slice.len(right) ? 1 : 0;
}
/*
 * Hash the borrowed UTF-8 bytes of string; O(bytes), with no allocation or ownership transfer.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u64 value(&string input) { return text_digits(string.as_bytes(input)); }
/*
 * Compare borrowed string keys by their UTF-8 bytes; O(bytes).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool equal(&string left, &string right) { return string.equals(left, right); }
/*
 * Lexicographically order borrowed string keys by UTF-8 bytes; O(bytes).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 compare(&string left, &string right) { return text_compare(string.as_bytes(left), string.as_bytes(right)); }
/*
