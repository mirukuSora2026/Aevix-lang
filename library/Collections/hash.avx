 */
public i32 compare(&string_view left, &string_view right) { return text_compare(string.as_bytes(*left), string.as_bytes(*right)); }
/*
 * Hash a custom key through its explicit Hash implementation, preserving ownership. Cost is the custom method cost.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u64 value<K>(&K input) where K implements Hash { return input.hash(); }
/*
 * Compare custom keys through their explicit Eq implementation, preserving ownership.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool equal<K>(&K left, &K right) where K implements Eq { return left.equal(right); }
/*
 * Order custom keys through their explicit Ord implementation, preserving ownership.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 compare<K>(&K left, &K right) where K implements Ord { return left.compare(right); }
/*
 * Select a bucket for a nonzero capacity; O(1). The caller must ensure capacity is nonzero.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public usize bucket(u64 code, usize capacity) {
    if (capacity == 0) Never.unreachable();
    Result<u64, IntegerError> widened = Integer.convert<u64>(capacity);
    switch (move widened) {
        case Result<u64, IntegerError>.Ok { u64 count = value }:
            Result<usize, IntegerError> narrowed = Integer.convert<usize>(code % count);
            switch (move narrowed) {
                case Result<usize, IntegerError>.Ok { usize index = value }: return index; break;
                case Result<usize, IntegerError>.Err: Never.unreachable(); break;
            }
            break;
        case Result<u64, IntegerError>.Err: Never.unreachable(); break;
    }
}
