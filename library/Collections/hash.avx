/*
 * Lifecycle of the hash public module.
 * @module hash
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
/*
 * Deterministic noncryptographic hashing. Equal keys must hash equally; mutating stored keys is forbidden.
 * Integer hashing is O(1); text hashing is O(bytes). This is not a collision-resistant or randomized policy.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
/*
 * Custom key hashing contract. The result must stay stable while the key is stored.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public interface Hash { /*
 * Version history for the hash.Hash.hash public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u64 hash(&Self self); };
/*
 * Custom key equivalence contract. equal must be reflexive, symmetric, transitive, and agree with Hash.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public interface Eq { /*
 * Version history for the hash.Eq.equal public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool equal(&Self self, &Self other); };
/*
 * Custom total order. compare returns a negative, zero, or positive value and agrees with Eq.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public interface Ord { /*
 * Version history for the hash.Ord.compare public API.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 compare(&Self self, &Self other); };
private u64 mix(u64 state, u64 digit) { return ((state ^ digit) * 257u64 + 17u64) % 4294967291u64; }
private u64 digits(mut u128 number, u64 seed) {
    mut u64 state = seed;
    mut usize index = 0;
    while (index < 16) {
        Result<u64, IntegerError> narrowed = Integer.convert<u64>(number % 256u128);
        switch (move narrowed) {
            case Result<u64, IntegerError>.Ok { u64 digit = value }: state = mix(state, digit); break;
            case Result<u64, IntegerError>.Err: Never.unreachable(); break;
        }
        number /= 256u128;
        index++;
    }
    return state;
}
private u64 signed_digits(i128 number) {
    i128 magnitude = number < 0i128 ? -(number + 1i128) : number;
    Result<u128, IntegerError> widened = Integer.convert<u128>(magnitude);
    switch (move widened) {
        case Result<u128, IntegerError>.Ok { u128 positive = value }: return digits(positive, number < 0i128 ? 1u64 : 0u64); break;
        case Result<u128, IntegerError>.Err: Never.unreachable(); break;
    }
}
/*
 * Hash a borrowed i8 without allocation, mutation, overflow, or implicit cloning; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public u64 value(&i8 input) {
    Result<i128, IntegerError> widened = Integer.convert<i128>(*input);
    switch (move widened) {
        case Result<i128, IntegerError>.Ok { i128 number = value }: return signed_digits(number); break;
        case Result<i128, IntegerError>.Err: Never.unreachable(); break;
    }
}
/*
 * Compare borrowed i8 keys for equivalence without taking ownership; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool equal(&i8 left, &i8 right) { return *left == *right; }
/*
 * Order borrowed i8 keys without taking ownership; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public i32 compare(&i8 left, &i8 right) { return *left < *right ? -1 : *left > *right ? 1 : 0; }
