/*
 * Failures of fixed-array materialization; distinct from canonical RangeError, which is unchanged.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public enum RangeArrayError implements Copy, Error {
    /*
     * The finite range cardinality cannot be represented as usize, before any explicit output initialization.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    CountOverflow;
    /*
     * The representable range cardinality differs from the requested compile-time array extent.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    LengthMismatch { /*
 * The compile-time usize array extent supplied as the first generic argument.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize expected; /*
 * The exact representable usize cardinality of the input sequence.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize actual; };
    /*
     * Return the stable allocation-free code of this source array-materialization error.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&Self self) {
        switch(*self){case Self.CountOverflow:return "range.array_count_overflow";break;case Self.LengthMismatch:return "range.array_length_mismatch";break;}
    }
    /*
     * Return an allocation-free English description of this source array-materialization error.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&Self self) {
        switch(*self){case Self.CountOverflow:return "The range cardinality cannot be represented by usize.";break;case Self.LengthMismatch:return "The range cardinality differs from the fixed array extent.";break;}
    }
};

T integer_zero<T>() where T implements Copy {
    switch(move Integer.convert<T>(0u8)){
        case Result<T,IntegerError>.Ok{T value=value}:return value;break;
        default:Never.unreachable();break;
    }
}
/*
 * Materialize integer Copy values after exact cardinality and byte-size checks. Map count overflow to CollectionError.SizeOverflow; reserve output once, preserve the input descriptor and release owned output on failure. Empty output performs no allocation.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Vector<T>,CollectionError> collect_vector<T>(Range<T> descriptor) where T implements Copy {
    mut usize count=0usize;
    switch(move Range.len(&descriptor)) {
        case Result<usize,RangeError>.Ok{usize length=value}:count=length;break;
        case Result<usize,RangeError>.Err{RangeError reason=error}:
            switch(move reason){case RangeError.CountOverflow:return Result.err(CollectionError.SizeOverflow);break;case RangeError.InvalidStep:Never.unreachable();break;}break;
    }
    mut Vector<T> output=[]?;
    Vector.reserve(&mut output,count)?;
    mut Cursor<T> cursor=iter(descriptor);
    while(!cursor.is_exhausted()) {
        switch(move cursor.next()) {
            case Optional<T>.Some{T value=value}:
                Result<unit,InputError<T>> appended=Vector.push(&mut output,value);
                switch(move appended){
                    case Result<unit,InputError<T>>.Ok:break;
                    case Result<unit,InputError<T>>.Err{InputError<T> reason=error}:
                        switch(move reason){case InputError<T>.AllocationFailure:return Result.err(CollectionError.AllocationFailure);break;case InputError<T>.SizeOverflow:return Result.err(CollectionError.SizeOverflow);break;case InputError<T>.OutOfBounds:Never.unreachable();break;}break;
                }break;
            case Optional<T>.None:Never.unreachable();break;
        }
    }
    return Result.ok(output);
}
/*
 * Materialize exactly N integer Copy values into inline storage; N is the first const generic argument and T is inferred. Validate count before explicit repeated-array initialization. Return source RangeArrayError on count overflow or length mismatch. The current aggregate Result ABI still reserves/copies/zero-initializes O(N) storage even on an error; no heap buffer is allocated.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public Result<Array<T,N>,RangeArrayError> to_array<const usize N,T>(Range<T> descriptor) where T implements Copy {
    mut usize count=0usize;
    switch(move Range.len(&descriptor)) {
        case Result<usize,RangeError>.Ok{usize length=value}:count=length;break;
        case Result<usize,RangeError>.Err{RangeError reason=error}:
            switch(move reason){case RangeError.CountOverflow:return Result.err(RangeArrayError.CountOverflow);break;case RangeError.InvalidStep:Never.unreachable();break;}break;
    }
    if(count!=N)return Result.err(RangeArrayError.LengthMismatch{expected=N,actual=count});
    T zero=integer_zero<T>();
    mut Array<T,N> output=[zero;N];
    mut usize index=0usize;
    mut Cursor<T> cursor=iter(descriptor);
    while(index<N) {
        switch(move cursor.next()) {
            case Optional<T>.Some{T value=value}:output[index]=value;break;
            case Optional<T>.None:Never.unreachable();break;
        }
        index++;
    }
    return Result.ok(output);
}
