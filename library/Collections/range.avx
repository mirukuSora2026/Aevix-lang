    if(value<32768u128){u128 magnitude=32768u128-value;i16 predecessor=success(Integer.convert<i16>(magnitude-1u128));return -predecessor-1i16;}
    u128 nonnegative=value-32768u128;return success(Integer.convert<i16>(nonnegative));
}
