    if(value<0i128){u128 magnitude=widen(integer.unsigned_abs(value));return 170141183460469231731687303715884105728u128-magnitude;}
    u128 nonnegative=widen(value);return 170141183460469231731687303715884105728u128+nonnegative;
}
