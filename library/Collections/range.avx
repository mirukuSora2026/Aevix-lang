    if(value<9223372036854775808u128){u128 magnitude=9223372036854775808u128-value;i64 predecessor=success(Integer.convert<i64>(magnitude-1u128));return -predecessor-1i64;}
    u128 nonnegative=value-9223372036854775808u128;return success(Integer.convert<i64>(nonnegative));
}
u128 rank(u64 value){return widen(value);}
u64 unrank(u64 witness,u128 value){return success(Integer.convert<u64>(value));}
