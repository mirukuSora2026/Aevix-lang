/*
 * Explicit-import finite integer range utilities. The canonical Range namespace is unchanged.
 * Signed ranks map MIN to zero and MAX to 2^width-1; all spans use u128.
 * Last ordinal is stored instead of count, so closed full-domain ranges stay representable.
 * Descriptor and cursor helpers do not allocate; collect_vector explicitly allocates output storage.
 * Materialization reports size/allocation errors; fixed-array Result storage is proportional to N.
 * No descriptor mutation, signed endpoint subtraction, or max-end increment is used.
 */
/*
 * Lifecycle of the range public module.
 * @module range
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
import error { Error };
import integer;

/*
 * The stored ascending or descending direction, independent of whether the sequence is empty.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public enum RangeDirection implements Copy { /*
 * Values advance toward larger integers by a positive unsigned magnitude.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
Ascending; /*
 * Values advance toward smaller integers by a positive unsigned magnitude.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
Descending; };
/*
 * Failures of source-only ordinal and step helpers; distinct from canonical RangeError.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public enum RangeOperationError implements Copy, Error {
    /*
     * The requested ordinal is outside the sequence, or a split index exceeds its cardinality.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    OutOfBounds { /*
 * The original usize ordinal supplied by the caller.
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
public usize index; };
    /*
     * A zero multiplicative step factor is invalid, including for empty descriptors.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    InvalidStep;
    /*
     * The product of the current magnitude and factor does not fit the element unsigned magnitude type.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    StepOverflow;
    /*
     * Return a stable allocation-free code for this source error carrier.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    public string_view code(&Self self) {
        switch(*self) {
            case Self.OutOfBounds:return "range.ordinal_out_of_bounds";break;
            case Self.InvalidStep:return "range.invalid_step_factor";break;
            case Self.StepOverflow:return "range.step_overflow";break;
        }
    }
    /*
     * Return an allocation-free English description for this source error carrier.
     * @since 0.3.0
     * @deprecated_at none
     * @removed_at none
     */
    public string_view message(&Self self) {
        switch(*self) {
            case Self.OutOfBounds:return "The ordinal is outside the finite range sequence.";break;
            case Self.InvalidStep:return "The step factor must be positive.";break;
            case Self.StepOverflow:return "The scaled step does not fit its unsigned magnitude type.";break;
        }
    }
};
T success<T,E>(Result<T,E> input) {
    switch(move input){case Result<T,E>.Ok{T value=value}:return value;break;default:Never.unreachable();break;}
}
u128 widen<T>(T value) where T implements Copy {
    Result<u128,IntegerError> converted=Integer.convert<u128>(value);
    u128 output=success<u128,IntegerError>(converted);
    return output;
}
struct RankedRange implements Copy {
    public u128 first;
    public u128 limit;
    public u128 magnitude;
    public bool descending;
    public bool inclusive;
    public bool empty;
};

u128 rank(i8 value) {
    if(value<0i8){u128 magnitude=widen(integer.unsigned_abs(value));return 128u128-magnitude;}
    u128 nonnegative=widen(value);return 128u128+nonnegative;
}
i8 unrank(i8 witness,u128 value) {
    if(value<128u128){u128 magnitude=128u128-value;i8 predecessor=success(Integer.convert<i8>(magnitude-1u128));return -predecessor-1i8;}
    u128 nonnegative=value-128u128;return success(Integer.convert<i8>(nonnegative));
}
u128 rank(u8 value){return widen(value);}
u8 unrank(u8 witness,u128 value){return success(Integer.convert<u8>(value));}
