    if(value<170141183460469231731687303715884105728u128){u128 magnitude=170141183460469231731687303715884105728u128-value;i128 predecessor=success(Integer.convert<i128>(magnitude-1u128));return -predecessor-1i128;}
    u128 nonnegative=value-170141183460469231731687303715884105728u128;return success(Integer.convert<i128>(nonnegative));
}
