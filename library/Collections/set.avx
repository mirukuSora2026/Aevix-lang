/*
 * Lifecycle of the set public module.
 * @module set
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
import map;
import hash;

/*
 * An owning hashed set backed by Map<T,unit>, with immutable stored representatives.
 * Expected membership/insert/remove is O(1), worst O(capacity), plus key work.
 * Default hashing is deterministic and noncryptographic. No operation implicitly clones members.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public struct Set<T> {
    map.Map<T, unit> storage;

/*
     * Create an empty set, preserving explicit fallible initialization; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Result<Self, CollectionError> new() {
        map.Map<T, unit> storage = map.Map<T, unit>.new()?;
        return Result.ok(Self { storage = storage });
    }

/*
     * Create an empty set with an explicit deterministic placement seed; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Result<Self, CollectionError> with_seed(u64 seed) {
        map.Map<T, unit> storage = map.Map<T, unit>.with_seed(seed)?;
        return Result.ok(Self { storage = storage });
    }

/*
     * Return the number of stored representatives; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public usize len(&Self self) { return self.storage.len(); }

/*
     * Test whether no representatives are stored; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public bool is_empty(&Self self) { return self.storage.is_empty(); }

/*
     * Return the entry limit before the next table growth/compaction check; O(1).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public usize capacity(&Self self) { return self.storage.capacity(); }

/*
     * Reserve additional member capacity without consuming members. Failure preserves entries; O(capacity) on rehash.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Result<unit, CollectionError> reserve(&mut Self self, usize additional) { return self.storage.reserve(additional); }

/*
     * Drop every representative exactly once while retaining bucket storage; O(capacity) plus Drop work.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public unit clear(&mut Self self) { return self.storage.clear(); }

/*
     * Explicit hash/equality membership. Equal query/member keys must use equal stable codes; expected O(1), worst O(capacity).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public bool contains_with<F>(&Self self, &T query, u64 code, &F same) where F implements Fn<Tuple<&T, &T>, bool> {
        return self.storage.contains_key_with(query, code, same);
    }

/*
     * Borrow the canonical immutable representative with explicit compatible hash/equality; expected O(1), worst O(capacity).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Optional<&T> get_with<F>(&Self self, &T query, u64 code, &F same) where F implements Fn<Tuple<&T, &T>, bool> {
        return self.storage.get_key_with(query, code, same);
    }

/*
     * Insert an owned member. Duplicate success keeps the stored representative and drops the incoming member.
     * Failure returns the original member in InputError<T>; expected amortized O(1), worst O(capacity).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Result<bool, InputError<T>> insert_with<F>(&mut Self self, T value, u64 code, &F same) where F implements Fn<Tuple<&T, &T>, bool> {
        Result<Optional<unit>, InputError<map.Entry<T, unit>>> inserted = self.storage.insert_with(value, Unit.value(), code, same);
        switch (move inserted) {
            case Result<Optional<unit>, InputError<map.Entry<T, unit>>>.Ok { Optional<unit> previous = value }:
                return Result.ok(Optional.is_none(&previous));
                break;
            case Result<Optional<unit>, InputError<map.Entry<T, unit>>>.Err { InputError<map.Entry<T, unit>> problem = error }:
                switch (move problem) {
                    case InputError<map.Entry<T, unit>>.AllocationFailure { map.Entry<T, unit> entry = input }:
                        switch (move entry) {
                            case map.Entry<T, unit>.Pair { T recovered = key }:
                                return Result.err(InputError<T>.AllocationFailure { input = recovered });
                                break;
                        }
                        break;
                    case InputError<map.Entry<T, unit>>.SizeOverflow { map.Entry<T, unit> entry = input }:
                        switch (move entry) {
                            case map.Entry<T, unit>.Pair { T recovered = key }:
                                return Result.err(InputError<T>.SizeOverflow { input = recovered });
                                break;
                        }
                        break;
                    // This path only delegates to push/rehash, which never reports an index error.
                    case InputError<map.Entry<T, unit>>.OutOfBounds: Never.unreachable(); break;
                }
                break;
        }
    }

/*
     * Remove an equivalent member, dropping its stored owner once; expected O(1), worst O(capacity).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public bool remove_with<F>(&mut Self self, &T query, u64 code, &F same) where F implements Fn<Tuple<&T, &T>, bool> {
        Optional<unit> removed = self.storage.remove_with(query, code, same);
        return Optional.is_some(&removed);
    }

/*
     * Remove and return the canonical member without cloning; expected O(1), worst O(capacity).
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Optional<T> take_with<F>(&mut Self self, &T query, u64 code, &F same) where F implements Fn<Tuple<&T, &T>, bool> {
        Optional<map.Entry<T, unit>> removed = self.storage.remove_entry_with(query, code, same);
        switch (move removed) {
            case Optional<map.Entry<T, unit>>.Some { map.Entry<T, unit> entry = value }:
                switch (move entry) { case map.Entry<T, unit>.Pair { T member = key }: return Optional.some(member); break; }
                break;
            case Optional<map.Entry<T, unit>>.None: return Optional.none(); break;
        }
    }

/*
     * Explicitly copy members into a new Vector, preserving this set; O(capacity), with fallible allocation.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
    public Result<Vector<T>, CollectionError> values_copy(&Self self) where T implements Copy { return self.storage.keys_copy(); }
};

/*
 * contains for i8 members. Expected O(1), worst O(capacity), plus key work. No hidden clone.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public bool contains(& Set<i8> table, &i8 query) {
    u64 code = hash.value(query);
    rsn same = [](&i8 left, &i8 right) -> bool { return hash.equal(left, right); };
    return table.contains_with(query, code, &same);
}

/*
 * get for i8 members. Expected O(1), worst O(capacity), plus key work. No hidden clone.
 * @since 0.3
 * @deprecated_at none
 * @removed_at none
 */
public Optional<&i8> get(& Set<i8> table, &i8 query) {
    u64 code = hash.value(query);
    rsn same = [](&i8 left, &i8 right) -> bool { return hash.equal(left, right); };
    return table.get_with(query, code, &same);
}

