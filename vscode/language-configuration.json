{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" }, { "open": "[", "close": "]" }, { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "[A-Za-z_][A-Za-z_0-9]*",
  "indentationRules": {
    "increaseIndentPattern": "^((?!//).)*\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*([}\\]]|case\\b.*:|default\\s*:)",
    "indentNextLinePattern": "^\\s*(?:if|else\\s+if|while|for)\\b[^;{}]*\\)\\s*$|^\\s*else\\s*$|^\\s*(?:case\\b.*|default)\\s*:\\s*$"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*/\\*.*$", "afterText": "^\\s*\\*/$", "action": { "indentAction": "indentOutdent", "appendText": " * " } },
    { "beforeText": "^\\s*\\*(?:[^/]|/(?!\\*))*$", "action": { "indentAction": "none", "appendText": "* " } }
  ]
}
