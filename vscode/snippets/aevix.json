{
  "Function": {
    "prefix": "fn",
    "body": [
      "${1:i32} ${2:name}(${3:i32 value}) {",
      "\t${4:return value;}",
      "}"
    ],
    "description": "Type-first function with an explicit return."
  },
  "Void function": {
    "prefix": "fnvoid",
    "body": [
      "void ${1:name}(${2}) {",
      "\t${3}",
      "\treturn;",
      "}"
    ],
    "description": "Void function."
  },
  "Main": {
    "prefix": "main",
    "body": [
      "i32 main() {",
      "\t${1}",
      "\treturn 0;",
      "}"
    ],
    "description": "Program entry point."
  },
  "Variable": {
    "prefix": "var",
    "body": "${1:i32} ${2:value} = ${3:0};",
    "description": "Immutable typed variable."
  },
  "Mutable variable": {
    "prefix": "mut",
    "body": "mut ${1:i32} ${2:value} = ${3:0};",
    "description": "Explicitly mutable binding."
  },
  "Inferred variable": {
    "prefix": "rsn",
    "body": "rsn ${1:value} = ${2:0};",
    "description": "Infer a variable type."
  },
  "Constant": {
    "prefix": "const",
    "body": "const ${1:i32} ${2:VALUE} = ${3:0};",
    "description": "Compile-time constant."
  },
  "Persistent value": {
    "prefix": "persist",
    "body": "persist ${1:i32} ${2:value} = ${3:0};",
    "description": "Persistent storage; requires compiler runtime support."
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Point} implements Copy {",
      "\tpublic ${2:i32} ${3:x};",
      "};"
    ],
    "description": "Value type; fields are private unless public."
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Event} {",
      "\t${2:Quit};",
      "\t${3:Move} { public i32 x; public i32 y; };",
      "};"
    ],
    "description": "Tagged union with named payload fields."
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Named} {",
      "\t${2:i32} ${3:value}(&Self self);",
      "};"
    ],
    "description": "Static interface requirement."
  },
  "Generic function": {
    "prefix": "generic",
    "body": [
      "T ${1:identity}<T>(T value) where T implements Copy {",
      "\treturn value;",
      "}"
    ],
    "description": "Generic function with a where constraint."
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "}"
    ],
    "description": "Parentheses required around condition."
  },
  "If else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "} else {",
      "\t${3}",
      "}"
    ],
    "description": "Conditional statement."
  },
  "While": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t${2}",
      "}"
    ],
    "description": "While loop."
  },
  "C-style for": {
    "prefix": "for",
    "body": [
      "for (mut i32 ${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {",
      "\t${3}",
      "}"
    ],
    "description": "Counted for loop."
  },
  "Enhanced for": {
    "prefix": "foreach",
    "body": [
      "for (${1:i32} ${2:value} : ${3:values}) {",
      "\t${4}",
      "}"
    ],
    "description": "Enhanced iteration."
  },
  "Range for": {
    "prefix": "forrange",
    "body": [
      "for (${1:i32} ${2:i} in ${3:0}..${4:10}) {",
      "\t${5}",
      "}"
    ],
    "description": "Half-open range iteration."
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:0}:",
      "\t\t${3}",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "Switch with explicit break."
  },
  "Enum case": {
    "prefix": "caseenum",
    "body": [
      "case ${1:Event}.${2:Move} { i32 ${3:dx} = x, i32 ${4:dy} = y }:",
      "\t${5}",
      "\tbreak;"
    ],
    "description": "Named payload bindings in a switch case."
  },
  "Read method": {
    "prefix": "method",
    "body": [
      "${1:i32} ${2:value}(&${3:Type} self) {",
      "\treturn ${4:0};",
      "}"
    ],
    "description": "Method with an explicit shared receiver."
  },
  "Mutable method": {
    "prefix": "methodmut",
    "body": [
      "void ${1:update}(&mut ${2:Type} self, ${3:i32 value}) {",
      "\t${4}",
      "\treturn;",
      "}"
    ],
    "description": "Method with an explicit mutable receiver."
  },
  "Static array": {
    "prefix": "array",
    "body": "${1:i32} ${2:values}[${3:3}] = [${4:1, 2, 3}];",
    "description": "Fixed-length array."
  },
  "Multidimensional array": {
    "prefix": "array2d",
    "body": "${1:i32} ${2:grid}[2][3] = [[1, 2, 3], [4, 5, 6]];",
    "description": "Contiguous, fixed-size nested arrays."
  },
  "Dynamic nested array": {
    "prefix": "vector2d",
    "body": "${1:i32} ${2:grid}[](2) = [[1, 2], [3, 4, 5]]?;",
    "description": "Nested dynamic vectors; requires allocation and Result support."
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:math.vector};",
    "description": "Import a module using its full path."
  },
  "Selective import": {
    "prefix": "importfrom",
    "body": "import ${1:math.vector} { ${2:Point, dot} };",
    "description": "Import selected public names."
  },
  "Re-export": {
    "prefix": "export",
    "body": "public import ${1:math.vector} { ${2:Point} };",
    "description": "Explicit named re-export."
  },
  "Documentation comment": {
    "prefix": "doc",
    "body": [
      "/*",
      " * ${1:Description.}",
      " * @parameter ${2:value} ${3:Description.}",
      " * @return ${4:Description.}",
      " * @version ${5:0.3}",
      " * @since ${6:0.3}",
      " * @deprecated_at none",
      " * @removed_at none",
      " */"
    ],
    "description": "Aevix block documentation with introduction, deprecation, and removal history."
  },
  "Deprecated documentation": {
    "prefix": "deprecated",
    "body": [
      "/*",
      " * @deprecated ${1:Use replacement instead.}",
      " * @since ${2:0.3}",
      " * @deprecated_at ${3:0.4}",
      " * @removed_at ${4:none}",
      " */"
    ],
    "description": "Document deprecation and the target version."
  },
  "C external declaration": {
    "prefix": "extern",
    "body": "extern \"C\" ${1:i32} ${2:function}(${3:i32 value});",
    "description": "External C function declaration; requires compiler FFI support."
  },
  "Variadic function": {
    "prefix": "variadic",
    "body": [
      "usize ${1:count}(${2:i32} ${3:values}[]) {",
      "    return Slice.len(${3:values});",
      "}"
    ],
    "description": "A homogeneous read-only argument pack backed by call-frame storage; no hidden heap allocation."
  },
  "Result propagation function": {
    "prefix": "resultfn",
    "body": [
      "Result<${1:i32}, ${2:i32}> ${3:compute}(${4:bool available}) {",
      "    ${1:i32} ${5:value} = ${6:fetch}(${7:available})?;",
      "    return Result.ok(${5:value});",
      "}"
    ],
    "description": "Propagate an owned Result with an exactly matching error type."
  },
  "Type alias": {
    "prefix": "typealias",
    "body": "type ${1:UserId} = ${2:u64};",
    "description": "A transparent alias of an existing type."
  },
  "Repeated static array": {
    "prefix": "arrayrepeat",
    "body": "${1:i32} ${2:zeros}[${3:128}] = [${4:0}; ${3:128}];",
    "description": "Evaluate one Copy value and repeat it a compile-time number of times."
  },
  "Tuple value": {
    "prefix": "tuple",
    "body": "Tuple<${1:i32}, ${2:bool}> ${3:status} = Tuple.make(${4:200}, ${5:true});",
    "description": "An owned tuple with different field types."
  },
  "Tuple field borrow": {
    "prefix": "tupleget",
    "body": "&${1:i32} ${2:code} = Tuple.get<${3:0}>(&${4:status});",
    "description": "Borrow a tuple field using a compile-time index."
  },
  "String view": {
    "prefix": "strview",
    "body": "string_view ${1:message} = \"${2:Hello, Aevix}\";",
    "description": "An allocation-free borrowed UTF-8 string literal."
  },
  "Owned string function": {
    "prefix": "stringfn",
    "body": [
      "Result<string, TextError> ${1:make_message}() {",
      "    return string.from_view(\"${2:Hello, Aevix}\");",
      "}"
    ],
    "description": "Create an owned UTF-8 string with explicit allocation failure."
  },
  "Typed numeric literals": {
    "prefix": "typednumbers",
    "body": [
      "i64 ${1:count} = ${2:100}i64;",
      "f32 ${3:ratio} = ${4:0.25}f32;"
    ],
    "description": "Select exact numeric types with literal suffixes."
  },
  "Bench function": {
    "prefix": "benchfn",
    "body": [
      "@bench ${1:i32} ${2:measured}() {",
      "    return ${3:0};",
      "}"
    ],
    "description": "Measure inclusive function time and sampled process RSS."
  },
  "Lambda": {
    "prefix": "lambda",
    "body": "rsn ${1:callback} = [](${2:i32} ${3:value}) -> ${4:i32} { return ${3:value}; };",
    "description": "An explicitly typed closure with an empty capture list."
  },
  "Captured lambda": {
    "prefix": "capturelambda",
    "body": [
      "i32 ${1:factor} = ${2:3};",
      "rsn ${3:multiply} = [${1:factor}](i32 ${4:value}) -> i32 { return ${4:value} * ${1:factor}; };"
    ],
    "description": "Capture a Copy scalar by value without hidden allocation."
  },
  "Generic fixed buffer": {
    "prefix": "genericbuffer",
    "body": [
      "struct ${1:Buffer}<T = i32, const usize N = 4> {",
      "    public Array<T, N> values;",
      "};"
    ],
    "description": "A user-defined fixed array container with type and usize defaults."
  },
  "CPU SIMD import": {
    "prefix": "importsimd",
    "body": "import simd { Simd, SimdMask };",
    "description": "Make fixed CPU lane types available explicitly."
  },
  "CPU parallel import": {
    "prefix": "importparallel",
    "body": "import parallel;",
    "description": "Import validated scoped scalar parallel iteration."
  },
  "Complex import": {
    "prefix": "importcomplex",
    "body": "import complex { Complex, complex, ComplexError };",
    "description": "Import floating complex values and explicit zero-divisor errors."
  }
}
