# ========================
#
# Created By : miruku_sora2026
#
# File name : .gitignore
#
# Description :
#     개인 설정과 경로가 포함된 로컬 산출물을 공개 저장소에서 제외한다.
#     Exclude private settings and local artifacts that can contain personal paths.
#
# ========================

# Build trees, dependencies, and machine-specific metadata.
build/
build-*/
cmake-build-*/
.idea/
.vscode/
.codex/
.agents/
node_modules/
**/_CPack_Packages/
**/CMakeFiles/
**/CMakeCache.txt
**/Testing/
compile_commands.json
*.log
*.py
# Public regression oracles; keep other local Python scripts private.
!/tests/generate_bytes_golden.py
!/tests/generate_encoding_bytes_golden.py
!/tests/generate_encoding_golden.py
!/tests/generate_float_bits_golden.py
!/tests/generate_floating_golden.py
!/tests/generate_integer_golden.py
!/tests/generate_range_golden.py
!/tests/generate_range_materialization_golden.py
!/tests/generate_unicode_golden.py
!/tests/generate_unicode_properties_golden.py
__pycache__/
*.py[cod]
.DS_Store
._*
*.swp
*.swo
*~

# Local packages can embed user paths, archive ownership, and debug metadata.
/releases/
/vscode/dist/*
!/vscode/dist/aevix-0.1.0.vsix
!/vscode/dist/aevix-0.2.0.vsix
!/vscode/dist/SHA256SUMS
*.bundle
*.bak

# Keep examples and private Markdown local; publish only the root README.
/examples/
/demo.avx
/design/logo/aevix-a-draft-*.png
*.[mM][dD]
!/README.md
!/CONTRIBUTING.md

# Keep review prompts local while retaining documentation and license notices.
*[Pp][Rr][Oo][Mm][Pp][Tt]*.[tT][xX][tT]
**/[Pp][Rr][Oo][Mm][Pp][Tt]*/**/*.[tT][xX][tT]
*프롬프트*.[tT][xX][tT]
*프롬포트*.[tT][xX][tT]

# Personal configuration, credentials, and private keys.
.env
.env.*
.netrc
.npmrc
.pypirc
.ssh/
.aws/
.gnupg/
*.local
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
