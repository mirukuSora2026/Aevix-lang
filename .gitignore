# ========================
#
# Created By : miruku_sora2026
#
# File name : .gitignore
#
# Description :
#     개인 설정과 경로가 포함된 로컬 산출물을 공개 저장소에서 제외한다.
#     Exclude private settings and local artifacts that can contain personal paths.
#
# ========================

# Build trees, dependencies, and machine-specific metadata.
build/
build-*/
cmake-build-*/
.idea/
.vscode/
.codex/
.agents/
node_modules/
**/_CPack_Packages/
**/CMakeFiles/
**/CMakeCache.txt
**/Testing/
compile_commands.json
*.log
*.py
.DS_Store
._*
*.swp
*.swo
*~

# Local packages can embed user paths, archive ownership, and debug metadata.
/releases/
/vscode/dist/*
!/vscode/dist/aevix-0.1.0.vsix
!/vscode/dist/SHA256SUMS
*.bundle
*.bak

# Keep examples and private Markdown local; publish only the root README.
/examples/
/demo.avx
*.[mM][dD]
!/README.md

# Personal configuration, credentials, and private keys.
.env
.env.*
.netrc
.npmrc
.pypirc
.ssh/
.aws/
.gnupg/
*.local
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
