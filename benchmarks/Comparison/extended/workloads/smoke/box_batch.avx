/*
 * Generated box_batch: exact unsigned arithmetic, runtime inputs, no fast math.
 * Initialization, input parsing, validation and output are outside clock calls.
 * @module box_batch
 * @since 0.3.0
 * @deprecated_at none
 * @removed_at none
 */
import system;
import memory { Box };
T success<T, E>(Result<T, E> input) {
    switch (move input) {
        case Result<T, E>.Ok { T output = value }: return output; break;
        default: Never.unreachable(); break;
    }
}
u64 read_seed() {
    Optional<u64> input = success(system.input<u64>());
    switch (input) {
        case Optional<u64>.Some { u64 supplied = value }: return supplied % 97u64; break;
        case Optional<u64>.None: Never.unreachable(); break;
    }
}

void kernel(&Array<u64, 16> input, &mut Array<u64, 16> output) {
    for (mut usize index = 0usize; index < 16usize; index++) {
        Box<u64> owner = success(Box.new(input[index]));
        output[index] = *Box.as_ref(&owner) * 3u64 + 1u64;
    }
    return;
}

i32 main() {
    u64 seeds[2] = [read_seed(), read_seed()];
    mut u64 values[16] = [0u64; 16];
    mut u64 right[16] = [0u64; 16];
    mut u64 output[16] = [0u64; 16];
    for (mut usize iteration = 0usize; iteration < 2usize; iteration++) {
        u64 seed = seeds[iteration];
        mut u64 initial = 0u64;
        for (mut usize index = 0usize; index < 16usize; index++) {
            values[index] = (initial * 17u64 + seed * 13u64) % 251u64;
            right[index] = (initial * 7u64 + seed * 3u64) % 19u64;
            initial++;
        }
        for (mut usize index = 0usize; index < 16usize; index++) output[index] = 0u64;
        kernel(&values, &mut output);
        if (iteration == 0usize) {
            u64 expected[16] = [1u64, 52u64, 103u64, 154u64, 205u64, 256u64, 307u64, 358u64, 409u64, 460u64, 511u64, 562u64, 613u64, 664u64, 715u64, 13u64];
            for (mut usize index = 0usize; index < 16usize; index++) if (output[index] != expected[index]) return 1;
        }
        if (iteration == 1usize) {
            u64 expected[16] = [40u64, 91u64, 142u64, 193u64, 244u64, 295u64, 346u64, 397u64, 448u64, 499u64, 550u64, 601u64, 652u64, 703u64, 1u64, 52u64];
            for (mut usize index = 0usize; index < 16usize; index++) if (output[index] != expected[index]) return 1;
        }
    }
    return 0;
}
