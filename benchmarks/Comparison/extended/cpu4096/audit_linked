#     Statically inspect actual clock calls and kernel envelopes in existing Mach-O executables.
#
# ========================
import argparse
from collections import Counter
import hashlib
import json
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parents[4]
CASES = {("lcg_256", "serial"), ("lcg_256", "parallel_fresh"), ("matmul64", "serial"),
         ("interface_dyn", "serial"), ("box_batch", "serial")}
CLOCK = "_aevixbench_clock_ns"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def rel(path):
    return path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path)


def ir_clock_function(path):
    active = None
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("define "):
            active = re.search(r"@([^ (]+)\(", line)[1]
        if re.search(r"\bcall\b.*@aevixbench_clock_ns\(", line):
            return "_" + active
    raise ValueError("No timed function in " + rel(path))


def assembly_instructions(path):
    instructions = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not re.match(r"\t[a-z]", line):
            continue
        text = line.split(";")[0].strip()
        instructions.append({"line": number, "text": text, "opcode": text.split()[0]})
    return instructions


def linked_instructions(text, stubs):
    result = []
    for line in text.splitlines():
        match = re.match(r"^([0-9a-f]+):\s+([a-z][^;]*)", line)
        if not match:
            continue
        address, instruction = int(match[1], 16), match[2].strip()
        opcode = instruction.split()[0]
        target = re.match(r"(?:b|bl)\s+0x([0-9a-f]+)", instruction)
        target_address = int(target[1], 16) if target else None
        symbol = stubs.get(target_address)
        result.append({"address": hex(address), "text": instruction, "opcode": opcode,
                       "target_address": hex(target_address) if target_address else None, "stub_symbol": symbol})
    return result


def split_pairs(instructions, linked):
    clocks = [index for index, item in enumerate(instructions)
              if item["opcode"] == "bl" and (item["stub_symbol"] == CLOCK if linked else item["text"].endswith(CLOCK))]
    if not clocks or len(clocks) % 2:
        raise ValueError("Unpaired clock calls: " + str(clocks))
    return [instructions[first:last + 1] for first, last in zip(clocks[::2], clocks[1::2])]


def metric(part, linked):
    return {"instruction_lines_including_clocks": len(part),
            "opcode_counts": dict(sorted(Counter(item["opcode"] for item in part).items())),
            "store_instructions": [item for item in part if re.match(r"st(?:r|p|[1-4])", item["opcode"])],
            "load_instructions": [item for item in part if re.match(r"ld(?:r|p|[1-4])", item["opcode"])],
            "vector_instructions": [item for item in part if re.search(r"\bv\d+\b|\bq\d+\b|\.\d+[bhsd]\b", item["text"])],
            "calls": [item for item in part if item["opcode"] in ("bl", "blr")],
            "indirect_calls": [item for item in part if item["opcode"] == "blr"],
            "start": part[0]["address" if linked else "line"],
            "stop": part[-1]["address" if linked else "line"]}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--prepared", type=Path, required=True)
    parser.add_argument("--objdump", type=Path, default=Path("/opt/homebrew/opt/llvm/bin/llvm-objdump"))
    parser.add_argument("--report", type=Path, default=Path("benchmarks/Comparison/extended/cpu4096/linked_audit.json"))
    args = parser.parse_args()
    prepared_path = ROOT / args.prepared
    prepared_bytes = prepared_path.read_bytes()
    prepared = json.loads(prepared_bytes)
    base = prepared_path.parent
    artifacts = base / "linked-audit"
    artifacts.mkdir(exist_ok=True)
    commands = []

    def dump(argv, name):
        result = subprocess.run([str(args.objdump), *map(str, argv)], cwd=ROOT, capture_output=True, timeout=30)
        if result.returncode:
            raise RuntimeError(result.stderr.decode("utf-8", "replace"))
        path = artifacts / name
        path.write_bytes(result.stdout)
        commands.append({"argv": [str(args.objdump), *[str(value).replace(str(ROOT) + "/", "") for value in argv]],
                         "exit_code": result.returncode, "stdout": rel(path), "sha256": sha(path)})
        return result.stdout.decode("utf-8")

    version = dump(["--version"], "objdump-version.txt").splitlines()[0]
    entries = []
    for item in prepared["programs"]:
        if (item["case"], item["mode"]) not in CASES:
            continue
        name = item["case"] + "-" + item["mode"]
        for language, suffix in (("C", "c"), ("AOT", "aevix")):
            binary = ROOT / item["commands"][language][0]
            if sha(binary) != item["binary_sha256"][language]:
                raise ValueError("Prepared executable changed: " + rel(binary))
            ir = base / "ir" / (name + "." + suffix + ".O2.ll")
            asm = base / "ir" / (name + "." + suffix + ".O2.s")
            timed = ir_clock_function(ir)
            indirect = dump(["--macho", "--indirect-symbols", binary], name + "." + language + ".indirect.txt")
            stubs, in_stubs = {}, False
            for line in indirect.splitlines():
                if line.startswith("Indirect symbols"):
                    in_stubs = "(__TEXT,__stubs)" in line
                match = re.match(r"^(0x[0-9a-f]+)\s+\d+\s+(\S+)", line)
                if in_stubs and match:
                    stubs[int(match[1], 16)] = match[2]
            if CLOCK not in stubs.values():
                raise ValueError("No shared-clock import stub")
            body = dump(["--disassemble", "--no-show-raw-insn", "--disassemble-symbols=" + timed, binary], name + "." + language + ".timed.txt")
            linked = linked_instructions(body, stubs)
            pairs = split_pairs(linked, True)
            prepared_pairs = split_pairs(assembly_instructions(asm), False)
            if len(pairs) != len(prepared_pairs):
                raise ValueError("Prepared and linked clock envelope counts differ")
            record = {"case": item["case"], "mode": item["mode"], "language": language,
                      "evidence_kind": "actual linked Mach-O executable disassembly", "binary": rel(binary), "binary_sha256": sha(binary),
                      "timed_symbol": timed, "prepared_assembly": rel(asm), "prepared_assembly_sha256": sha(asm),
                      "clock_stub_address": hex(next(address for address, symbol in stubs.items() if symbol == CLOCK)),
                      "clock_binding_evidence": "Mach-O __TEXT,__stubs indirect symbol table; generic objdump annotations for import stubs are not trusted.",
                      "pairs": []}
            for index, (actual, source) in enumerate(zip(pairs, prepared_pairs)):
                role = "warmup and sample share this loop body" if len(pairs) == 1 else "warmup" if index == 0 else "sample"
                actual_metrics, source_metrics = metric(actual, True), metric(source, False)
                opcodes_equal = [value["opcode"] for value in actual] == [value["opcode"] for value in source]
                if not opcodes_equal:
                    raise ValueError("Prepared/linked opcode envelope differs; review before claiming preservation")
                record["pairs"].append({"role": role, "linked": actual_metrics,
                                        "prepared_dot_s": source_metrics, "opcode_sequence_equal": opcodes_equal,
                                        "comparison_limit": "Same lexical opcode sequence and count; this is not a byte-equality claim against relocatable assembly text."})
                excerpt = artifacts / (name + "." + language + ".pair" + str(index) + ".txt")
                excerpt.write_bytes(("\n".join(value["address"] + " " + value["text"] + (" ; import " + value["stub_symbol"] if value["stub_symbol"] else "") for value in actual) + "\n").encode("utf-8"))
            used = dump(["--macho", "--dylibs-used", binary], name + "." + language + ".dylibs.txt")
            record["dylibs_used"] = [line.replace(str(ROOT) + "/", "") for line in used.splitlines()[1:]]
            record["dylib_path_policy"] = "Repository install names are ROOT-relative here; exact original names remain in the private disassembly artifacts."
            if item["mode"] == "parallel_fresh":
                names = ["_bench_lcg_256_callback", "_bench_parallel_for_each", "_bench_entry"] if language == "C" else ["_aevix.fn.47", "_aevix_parallel_for_each", "__ZN12_GLOBAL__N_15entryEPv"]
                record["linked_parallel_functions"] = []
                for symbol in names:
                    text = dump(["--disassemble", "--no-show-raw-insn", "--disassemble-symbols=" + symbol, binary], name + "." + language + "." + symbol + ".txt")
                    part = linked_instructions(text, stubs)
                    if not part:
                        raise ValueError("Missing linked parallel function " + symbol)
                    record["linked_parallel_functions"].append({"symbol": symbol, **metric(part, True)})
            if language == "AOT":
                thunk = dump(["--disassemble", "--no-show-raw-insn", "--disassemble-symbols=_main", binary], name + ".AOT.main.txt")
                first = linked_instructions(thunk, stubs)[0]
                record["main_first_instruction"] = first
                record["main_tail_branch_to_timed_entry"] = first["opcode"] == "b" and timed in first["text"]
                if not record["main_tail_branch_to_timed_entry"]:
                    raise ValueError("Unexpected AOT entry thunk")
            entries.append(record)
    if prepared_path.read_bytes() != prepared_bytes:
        raise ValueError("Prepared manifest changed during read-only inspection")
    host_runtime = ROOT / "build/libaevix_runtime.a"
    jit_link_recipe = ROOT / "build/CMakeFiles/aevixc.dir/link.txt"
    report = {"schema_version": 1, "created_by": "miruku_sora2026", "file_name": args.report.name,
              "description": "Actual linked C/AOT clock envelopes, compared with previously prepared assembly; no benchmark execution or rebuilding.",
              "prepared": rel(prepared_path), "prepared_sha256": hashlib.sha256(prepared_bytes).hexdigest(),
              "objdump": str(args.objdump), "objdump_sha256": sha(args.objdump), "objdump_version": version,
              "audit_tool_sha256": sha(Path(__file__)), "commands": commands, "entries": entries,
              "runtime_boundaries": {
                  "AOT": {"path": "build/bench-cpu4096/baseline-14e539e9/lib/aevix/libaevix_runtime.a",
                          "sha256": "ae46e345905ab78b8aa30b6b90fd28fd777c32851d5235a94779387d7ecf78d1",
                          "selection": "Explicit --runtime in recorded AOT preparation commands."},
                  "CLI_JIT": {"compiler": "build/aevixc", "compiler_sha256": "b87fb39dd145f003844ce77362f0ac4f235960c99ddc033ab5458377aa5c69dc",
                              "host_archive_path": rel(host_runtime), "host_archive_sha256_observed_now": sha(host_runtime),
                              "link_recipe": rel(jit_link_recipe), "link_recipe_sha256": sha(jit_link_recipe),
                              "selection": "Host runtime is linked into the compiler by the recorded build recipe. --runtime is not a JIT runtime selector.",
                              "evidence_boundary": "JIT machine code and its actual runtime function bodies were not disassembled by this audit; no identical-runtime-machine-code claim is made."}},
              "findings": [
                  "All ten linked C/AOT envelopes have the same lexical opcode sequence and count as their respective prepared .s envelopes; actual calls resolve to the shared clock import stub.",
                  "Serial result load/arithmetic/store loops remain between the two clock calls. AOT _main tail-branches to the actual timed entry without a per-element wrapper.",
                  "C matmul/interface/box/parallel entries have distinct linked warmup and sample clock pairs; both were inspected. LCG serial and all AOT entries share a retained loop body across the two iterations.",
                  "Both linked box_batch hot regions contain no allocation/free calls. Both linked interface_dyn hot regions contain no indirect calls; the C hot loop has six vector-instruction sites while AOT is scalar. These cases do not establish heap-allocation or opaque-dispatch throughput.",
                  "The representative parallel callbacks each contain 24 scalar instructions and a result store. Both linked runtimes contain pthread_create/join and indirect per-element callback calls, including caller and spawned-thread paths.",
                  "The AOT parallel runtime additionally queries sysconf inside the clock envelope; C computes its configured worker count before the clocks and passes it to its backend. These are residual runtime differences, not isolated measurements of their individual costs."
              ],
              "limits": ["No JIT-generated machine-code dump was captured or inferred.",
                         "Lexical excerpts show ordinary hot instructions; out-of-line failure targets must be interpreted with optimized CFG evidence.",
                         "A compiler can remove language-level allocations and devirtualize calls; source syntax alone does not establish retained allocation or dispatch cost.",
                         "No timing observations were created or modified by this audit."]}
    path = ROOT / args.report
    path.write_bytes((json.dumps(report, indent=2) + "\n").encode("utf-8"))
    print(json.dumps({"report": rel(path), "sha256": sha(path), "linked_binaries": len(entries), "rebuilds": 0, "executions": 0}))


if __name__ == "__main__":
    main()
