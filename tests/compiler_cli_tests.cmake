# File name : compiler_cli_tests.cmake
#
# Description :
#     검사부터 AIR·LLVM 출력과 실제 AOT 빌드·실행까지 명령행 경로를 확인한다.
#     Check CLI paths from analysis through AIR and LLVM output to actual AOT builds and execution.
#
# ========================

if(NOT DEFINED AEVIXC OR NOT DEFINED TEST_DIR OR NOT DEFINED CLANG)
    message(FATAL_ERROR "AEVIXC, TEST_DIR, and CLANG are required")
endif()
if(NOT EXISTS "${CLANG}")
    message(STATUS "LLVM clang unavailable; compiler execution tests skipped")
    return()
endif()
file(MAKE_DIRECTORY "${TEST_DIR}/src")
file(WRITE "${TEST_DIR}/src/main.avx" "const i32 answer = 6 * 7; i32 main() { return answer; }\n")
file(WRITE "${TEST_DIR}/src/generic.avx" "T identity<T>(T value) { return value; } i32 main() { return identity(42); }\n")
file(WRITE "${TEST_DIR}/src/enum.avx" "enum Event { Quit; Move { public i32 x; }; }; i32 main() { Event event = Event.Move { x = 42 }; switch (event) { case Event.Quit: return 0; break; case Event.Move { i32 value = x }: return value; break; } }\n")
file(WRITE "${TEST_DIR}/src/interface.avx" "interface Value { public i32 get(&Self self); public i32 doubled(&Self self) { return self.get() * 2; } }; struct Item implements Value { public i32 value; public i32 get(&Item self) { return (*self).value; } }; i32 main() { Item item = Item { value = 21 }; return item.doubled(); }\n")
file(WRITE "${TEST_DIR}/src/moved.avx" "struct Item { public i32 value; }; i32 consume(Item value) { return value.value; } i32 main() { Item item = Item { value = 2 }; i32 used = consume(item); return item.value; }\n")
file(WRITE "${TEST_DIR}/src/borrow.avx" "i32 main() { mut i32 value = 1; &mut i32 loan = &mut value; i32 copy = value; return *loan + copy; }\n")
file(WRITE "${TEST_DIR}/src/escape.avx" "&i32 leak() { i32 local = 1; return &local; } i32 main() { return *leak(); }\n")
file(WRITE "${TEST_DIR}/src/trap.avx" "i32 main() { i32 zero = 0; return 1 / zero; }\n")

function(run_cli name expected pattern)
    execute_process(COMMAND "${AEVIXC}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 20)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: exit ${code}, expected ${expected}\n${output}\n${error}")
    endif()
    if(NOT "${pattern}" STREQUAL "" AND NOT "${output}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "${name}: missing ${pattern}\n${output}\n${error}")
    endif()
endfunction()

run_cli(check_all_phases 0 "ownership checked" --check "${TEST_DIR}/src/main.avx")
run_cli(emit_air 0 "return" --emit-air "${TEST_DIR}/src/main.avx")
run_cli(emit_llvm 0 "define i32 @main" --emit-llvm "${TEST_DIR}/src/main.avx")
run_cli(default_run 42 "" --clang "${CLANG}" "${TEST_DIR}/src/main.avx")
run_cli(run_scalar 42 "" --run --clang "${CLANG}" "${TEST_DIR}/src/main.avx")
run_cli(run_generic 42 "" --run --clang "${CLANG}" "${TEST_DIR}/src/generic.avx")
run_cli(run_enum 42 "" --run --clang "${CLANG}" "${TEST_DIR}/src/enum.avx")
run_cli(run_static_interface 42 "" --run --clang "${CLANG}" "${TEST_DIR}/src/interface.avx")
run_cli(reject_move 1 "error:" --check "${TEST_DIR}/src/moved.avx")
run_cli(reject_conflicting_borrow 1 "error:" --check "${TEST_DIR}/src/borrow.avx")
run_cli(reject_escaping_reference 1 "error:" --check "${TEST_DIR}/src/escape.avx")
set(spaced_program "${TEST_DIR}/program with spaces")
if(CMAKE_HOST_WIN32)
    string(APPEND spaced_program ".exe")
endif()
run_cli(build_output_with_spaces 0 "Built" --build --clang "${CLANG}" -O2 -o "${spaced_program}" "${TEST_DIR}/src/main.avx")
execute_process(COMMAND "${spaced_program}" RESULT_VARIABLE code TIMEOUT 10)
if(NOT "${code}" STREQUAL "42")
    message(FATAL_ERROR "Built program returned ${code}, expected 42")
endif()
foreach(target IN ITEMS arm64-apple-macosx aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu x86_64-pc-windows-msvc x86_64-w64-windows-gnu)
    set(object "${TEST_DIR}/${target}.o")
    run_cli("object_${target}" 0 "Built" --build -c --clang "${CLANG}" --target "${target}" -o "${object}" "${TEST_DIR}/src/enum.avx")
    if(NOT EXISTS "${object}")
        message(FATAL_ERROR "Missing object for ${target}")
    endif()
    file(SIZE "${object}" object_size)
    if(object_size EQUAL 0)
        message(FATAL_ERROR "Empty object for ${target}")
    endif()
    if(target MATCHES "windows")
        file(READ "${object}" object_magic LIMIT 2 HEX)
        if(NOT object_magic STREQUAL "6486")
            message(FATAL_ERROR "Expected AMD64 COFF object for ${target}: ${object_magic}")
        endif()
    endif()
endforeach()
run_cli(reject_intel_macos_target 2 "supported targets" --build --target x86_64-apple-macosx "${TEST_DIR}/src/main.avx")
run_cli(reject_unsupported_target 2 "supported targets" --build --target wasm32-unknown-unknown "${TEST_DIR}/src/main.avx")
run_cli(reject_object_run 2 "invalid command line" --run -c "${TEST_DIR}/src/main.avx")
foreach(level IN ITEMS -O0 -O2)
    execute_process(COMMAND "${AEVIXC}" --run --clang "${CLANG}" "${level}" "${TEST_DIR}/src/trap.avx"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if("${code}" STREQUAL "0" OR NOT "${output}" STREQUAL "")
        message(FATAL_ERROR "Unsafe arithmetic did not stop at ${level}: ${code} ${output} ${error}")
    endif()
endforeach()
# 기본 실행은 소스 옆에 산출물을 남기지 않고 starter는 명시적으로 보존한다.
# Default execution leaves no adjacent outputs; starter generation explicitly preserves them.
file(MAKE_DIRECTORY "${TEST_DIR}/starter fixtures/main's [draft] $cash")
set(starter_base "${TEST_DIR}/starter fixtures/main's [draft] $cash/main")
set(starter_source "${starter_base}.avx")
if(CMAKE_HOST_WIN32)
    set(starter_binary "${starter_base}.exe")
else()
    set(starter_binary "${starter_base}")
endif()
file(REMOVE "${starter_binary}" "${starter_base}.sh")
file(WRITE "${starter_source}" "persist i32 answer = 42; i32 main() { return answer; }\n")
file(SHA256 "${starter_source}" source_before)
run_cli(default_relative_run 42 "" --clang "${CLANG}" "starter fixtures/main's [draft] $cash/main.avx")
if(EXISTS "${starter_binary}" OR EXISTS "${starter_base}.sh")
    message(FATAL_ERROR "Default execution left starter artifacts")
endif()
run_cli(generate_starter 0 "Built" --with-starter --clang "${CLANG}" "starter fixtures/main's [draft] $cash/main.avx")
file(SHA256 "${starter_source}" source_after)
if(NOT source_before STREQUAL source_after)
    message(FATAL_ERROR "Source changed during starter generation")
endif()
execute_process(COMMAND "${starter_binary}" RESULT_VARIABLE starter_exit TIMEOUT 10)
if(NOT "${starter_exit}" STREQUAL "42")
    message(FATAL_ERROR "Starter binary returned ${starter_exit}")
endif()
if(NOT CMAKE_HOST_WIN32)
    if(NOT EXISTS "${starter_base}.sh")
        message(FATAL_ERROR "Missing POSIX starter script")
    endif()
    execute_process(COMMAND "${starter_base}.sh" WORKING_DIRECTORY "/" RESULT_VARIABLE starter_exit TIMEOUT 10)
    if(NOT "${starter_exit}" STREQUAL "42")
        message(FATAL_ERROR "Starter script failed outside its directory: ${starter_exit}")
    endif()
    set(relocated "${TEST_DIR}/relocated starter")
    file(MAKE_DIRECTORY "${relocated}")
    file(COPY "${starter_binary}" "${starter_base}.sh" DESTINATION "${relocated}")
    execute_process(COMMAND "${relocated}/main.sh" WORKING_DIRECTORY "/" RESULT_VARIABLE starter_exit TIMEOUT 10)
    if(NOT "${starter_exit}" STREQUAL "42")
        message(FATAL_ERROR "Relocated starter failed: ${starter_exit}")
    endif()
    set(linebreak_directory "${TEST_DIR}/starter directory\n")
    file(MAKE_DIRECTORY "${linebreak_directory}")
    file(COPY "${starter_binary}" "${starter_base}.sh" DESTINATION "${linebreak_directory}")
    execute_process(COMMAND "${linebreak_directory}/main.sh" WORKING_DIRECTORY "/" RESULT_VARIABLE starter_exit TIMEOUT 10)
    if(NOT "${starter_exit}" STREQUAL "42")
        message(FATAL_ERROR "Starter failed with trailing directory newline: ${starter_exit}")
    endif()
endif()
file(SHA256 "${starter_binary}" binary_before)
run_cli(reject_existing_starter 2 "already exists" --with-starter --clang "${CLANG}" "${starter_source}")
file(SHA256 "${starter_binary}" binary_after)
if(NOT binary_before STREQUAL binary_after)
    message(FATAL_ERROR "Existing starter was overwritten")
endif()
run_cli(reject_starter_object 2 "invalid command line" --with-starter -c "${starter_source}")
message(STATUS "Compiler CLI: analysis, execution, safety, target objects, and starter checks passed")
