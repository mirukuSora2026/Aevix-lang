import unicode;
import encoding;
T success<T,E>(Result<T,E> input){switch(move input){case Result<T,E>.Ok {T value=value}:return value;break;default:Never.unreachable();break;}}
unicode.UnicodeError failed<T>(Result<T,unicode.UnicodeError> input){switch(move input){case Result<T,unicode.UnicodeError>.Err {unicode.UnicodeError value=error}:return value;break;default:Never.unreachable();break;}}
bool bad8(Slice<byte> input,usize expected){
    unicode.UnicodeError reason=failed(unicode.from_utf8(input));
    switch(reason){case unicode.UnicodeError.Encoding {encoding.EncodingError nested=reason}:switch(nested){case encoding.EncodingError.InvalidUtf8 {usize position=offset}:return position==expected;break;default:return false;break;}break;default:return false;break;}
}
bool short8(Slice<byte> input,usize expected){
    unicode.UnicodeError reason=failed(unicode.from_utf8(input));
    switch(reason){case unicode.UnicodeError.IncompleteUtf8 {usize position=offset,usize width=expected,usize count=available}:return position==0usize&&width==expected&&count==Slice.len(input);break;default:return false;break;}
}
bool bad16(Slice<u16> input,usize expected){
    unicode.UnicodeError reason=failed(unicode.from_utf16(input));
    switch(reason){case unicode.UnicodeError.Encoding {encoding.EncodingError nested=reason}:switch(nested){case encoding.EncodingError.InvalidUtf16 {usize position=offset}:return position==expected;break;default:return false;break;}break;default:return false;break;}
}
bool syntax(Result<char,unicode.UnicodeError> result,usize expected){
    unicode.UnicodeError reason=failed(result);
    switch(reason){case unicode.UnicodeError.InvalidSyntax {usize position=offset}:return position==expected;break;default:return false;break;}
}
bool trailing(Result<char,unicode.UnicodeError> result,usize expected){
    unicode.UnicodeError reason=failed(result);
    switch(reason){case unicode.UnicodeError.TrailingInput {usize position=offset}:return position==expected;break;default:return false;break;}
}
i32 main(){
    byte lone[1]=[Byte.from_u8(128u8)];if(!bad8(Slice.from_array(&lone),0usize))return 1;
    byte over2[2]=[Byte.from_u8(192u8),Byte.from_u8(128u8)];if(!bad8(Slice.from_array(&over2),0usize))return 2;
    byte incomplete2[1]=[Byte.from_u8(194u8)];if(!short8(Slice.from_array(&incomplete2),2usize))return 3;
