import ordered_map { OrderedMap, Entry, InsertError, OwningIterator };
import hash;

struct Key implements hash.Ord, Drop {
    public i32 order;
    public &mut i32 drops;
    public i32 compare(&Self self, &Self other) { return self.order < other.order ? -1 : self.order > other.order ? 1 : 0; }
    public void drop(&mut Self self) { *self.drops += 1; return; }
};
struct Value implements Drop {
    public &mut i32 drops;
    public i32 id;
    public void drop(&mut Self self) { *self.drops += 1; return; }
};
bool accepted(Result<Optional<Value>, InsertError<Key, Value>> input) {
    switch (move input) {
        case Result<Optional<Value>, InsertError<Key, Value>>.Ok: return true; break;
        case Result<Optional<Value>, InsertError<Key, Value>>.Err: return false; break;
    }
}

/* Count each moved owner after every tree, error and cursor lease has ended. */
i32 main() {
    mut i32 k1 = 0;
    mut i32 k2 = 0;
    mut i32 k3 = 0;
    mut i32 k4 = 0;
    mut i32 k5 = 0;
    mut i32 v1 = 0;
    mut i32 v2 = 0;
    mut i32 v3 = 0;
    mut i32 v4 = 0;
    mut i32 v5 = 0;
    mut i32 query_drops = 0;
    {
        mut OrderedMap<Key, Value> tree = OrderedMap<Key, Value>.new();
        rsn compare = [](&Key left, &Key right) -> i32 { return left.compare(right); };
        if (!accepted(tree.insert_with(Key { order = 2, drops = &mut k2 }, Value { drops = &mut v2, id = 2 }, &compare))) return 90;
        if (!accepted(tree.insert_with(Key { order = 1, drops = &mut k1 }, Value { drops = &mut v1, id = 1 }, &compare))) return 91;
        if (!accepted(tree.insert_with(Key { order = 3, drops = &mut k3 }, Value { drops = &mut v3, id = 3 }, &compare))) return 92;
        if (!accepted(tree.insert_with(Key { order = 2, drops = &mut k4 }, Value { drops = &mut v4, id = 4 }, &compare))) return 93;
        {
            Key query = Key { order = 1, drops = &mut query_drops };
            Optional<Value> removed = tree.remove_with(&query, &compare);
            if (!Optional.is_some(&removed)) return 1;
        }
        {
            Result<&mut Value, InsertError<Key, Value>> duplicate = tree.try_insert_with(Key { order = 2, drops = &mut k5 }, Value { drops = &mut v5, id = 5 }, &compare);
            switch (move duplicate) { case Result<&mut Value, InsertError<Key, Value>>.Ok: return 2; break; case Result<&mut Value, InsertError<Key, Value>>.Err: break; }
        }
        mut OwningIterator<Key, Value> cursor = tree.into_iter();
        Optional<Entry<Key, Value>> first = cursor.next();
        switch (move first) {
            case Optional<Entry<Key, Value>>.Some { Entry<Key, Value> pair = value }:
                switch (pair) { case Entry<Key, Value>.Pair { &Value value = value }: if (value.id != 4) return 3; break; }
                break;
            case Optional<Entry<Key, Value>>.None: return 4; break;
        }
    }
    if (k1 != 1 || k2 != 1 || k3 != 1 || k4 != 1 || k5 != 1) return 5;
    if (v1 != 1 || v2 != 1 || v3 != 1 || v4 != 1 || v5 != 1 || query_drops != 1) return 6;
    mut i32 k6 = 0;
    mut i32 k7 = 0;
    mut i32 k8 = 0;
    mut i32 v6 = 0;
    mut i32 v7 = 0;
    mut i32 v8 = 0;
    {
        mut OrderedMap<Key, Value> tree = OrderedMap<Key, Value>.new();
        rsn compare = [](&Key left, &Key right) -> i32 { return left.compare(right); };
        if (!accepted(tree.insert_with(Key { order = 6, drops = &mut k6 }, Value { drops = &mut v6, id = 6 }, &compare))) return 94;
        if (!accepted(tree.insert_with(Key { order = 7, drops = &mut k7 }, Value { drops = &mut v7, id = 7 }, &compare))) return 95;
        tree.retain([](&Key key, &mut Value value) -> bool { return false; });
        if (!tree.is_empty()) return 7;
        if (!accepted(tree.insert_with(Key { order = 8, drops = &mut k8 }, Value { drops = &mut v8, id = 8 }, &compare))) return 96;
        tree.clear();
    }
    if (k6 != 1 || k7 != 1 || k8 != 1 || v6 != 1 || v7 != 1 || v8 != 1) return 8;
    return 0;
}
