import unicode;
extern "C" void ucd_fault_point(u32 point);
extern "C" u32 ucd_outstanding();
extern "C" u32 ucd_attempts();
bool outcome<T>(Result<T,unicode.UnicodeError> result,bool expected){
    switch(move result){
        case Result<T,unicode.UnicodeError>.Ok:return !expected;break;
        case Result<T,unicode.UnicodeError>.Err {unicode.UnicodeError reason=error}:
            switch(reason){case unicode.UnicodeError.AllocationFailure:return expected;break;default:return false;break;}
            break;
    }
}
bool operation(u32 number,bool expected){
    if(number==0u32)return outcome(unicode.to_lowercase('İ'),expected);
    if(number==1u32)return outcome(unicode.to_uppercase('ß'),expected);
    if(number==2u32)return outcome(unicode.to_titlecase('ﬃ'),expected);
    if(number==3u32)return outcome(unicode.case_fold('ẞ'),expected);
    if(number==4u32)return outcome(unicode.name('A'),expected);
    if(number==5u32)return outcome(unicode.name('한'),expected);
    if(number==6u32)return outcome(unicode.name('一'),expected);
    if(number==7u32)return outcome(unicode.script_extensions('·'),expected);
    if(number==8u32)return outcome(unicode.name_aliases('\t'),expected);
    if(number==9u32)return outcome(unicode.name_aliases('A'),expected);
    return outcome(unicode.name('\u{10ffff}'),expected);
}
i32 main(){
    mut u32 number=0u32;
    while(number<11u32){
        ucd_fault_point(0u32);
        if(!operation(number,false)||ucd_outstanding()!=0u32)return 1;
        u32 count=ucd_attempts();mut u32 point=1u32;
        while(point<=count){ucd_fault_point(point);if(!operation(number,true)||ucd_outstanding()!=0u32)return 2;point++;}
        number++;
    }
    return 0;
}
