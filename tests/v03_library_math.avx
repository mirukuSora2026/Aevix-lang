i32 test_i8() {
    i8 minimum = -128i8;
    i8 maximum = 127i8;
    if (math.min(minimum, maximum) != minimum || math.max(minimum, maximum) != maximum) return 1;
    if (take_i8(math.clamp(minimum, -2i8, 3i8)) != -2i8 || take_i8(math.clamp(maximum, -2i8, 3i8)) != 3i8 || take_i8(math.clamp(1i8, -2i8, 3i8)) != 1i8) return 2;
    if (!invalid_bounds_i8(math.clamp(0i8, 1i8, -1i8))) return 3;
    if (math.midpoint(minimum, maximum) != 0i8 || math.midpoint(minimum, minimum) != minimum || math.midpoint(maximum, maximum) != maximum || math.midpoint(-1i8, 2i8) != 0i8 || math.midpoint(1i8, -2i8) != 0i8) return 4;
    if (math.signum(minimum) != -1i8 || math.signum(maximum) != 1i8 || math.signum(0i8) != 0i8) return 5;
    if (math.unsigned_abs(minimum) != 128u8 || math.unsigned_abs(maximum) != 127u8) return 6;
    if (!overflowed_i8(math.checked_abs(minimum)) || take_i8(math.checked_abs(-127i8)) != maximum || take_i8(math.checked_abs(maximum)) != maximum || take_i8(math.checked_abs(0i8)) != 0i8) return 7;
    if (math.gcd(minimum, 0i8) != 128u8 || math.gcd(minimum, minimum) != 128u8 || math.gcd(-54i8, 24i8) != 6u8 || math.gcd(0i8, 0i8) != 0u8) return 8;
    if (take_u8(math.lcm(minimum, 1i8)) != 128u8 || take_u8(math.lcm(-6i8, 8i8)) != 24u8 || take_u8(math.lcm(0i8, minimum)) != 0u8 || !overflowed_u8(math.lcm(minimum, maximum))) return 9;
    if (take_i8(math.checked_pow(0i8, 0u32)) != 1i8 || take_i8(math.checked_pow(0i8, 9u32)) != 0i8 || take_i8(math.checked_pow(minimum, 1u32)) != minimum || take_i8(math.checked_pow(maximum, 1u32)) != maximum) return 10;
    if (take_i8(math.checked_pow(-2i8, 7u32)) != minimum || !overflowed_i8(math.checked_pow(2i8, 7u32)) || !overflowed_i8(math.checked_pow(-2i8, 8u32)) || !overflowed_i8(math.checked_pow(maximum, 2u32))) return 11;
    if (take_i8(math.checked_pow(1i8, 4294967295u32)) != 1i8 || take_i8(math.checked_pow(-1i8, 4294967295u32)) != -1i8) return 12;
    return 0;
}
