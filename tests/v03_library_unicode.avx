u32 lower_code(u32 code){return code>=65u32&&code<=90u32?code+32u32:code;}
i32 ascii_cases(){
    mut u32 raw=0u32;
    while(raw<256u32){
        char c=success(Char.from_u32(raw));
        bool ascii=raw<128u32;bool upper=raw>=65u32&&raw<=90u32;bool lower=raw>=97u32&&raw<=122u32;
        bool alpha=upper||lower;bool digit=raw>=48u32&&raw<=57u32;bool graphic=raw>=33u32&&raw<=126u32;
        if(unicode.ascii_is_alphabetic(c)!=alpha||unicode.ascii_is_alphanumeric(c)!=(alpha||digit))return 1;
        if(unicode.ascii_is_uppercase(c)!=upper||unicode.ascii_is_lowercase(c)!=lower||unicode.ascii_is_digit(c)!=digit)return 2;
        if(unicode.ascii_is_binary_digit(c)!=(raw==48u32||raw==49u32)||unicode.ascii_is_octal_digit(c)!=(raw>=48u32&&raw<=55u32))return 3;
        if(unicode.ascii_is_hex_digit(c)!=(digit||(raw>=65u32&&raw<=70u32)||(raw>=97u32&&raw<=102u32)))return 4;
        if(unicode.ascii_is_blank(c)!=(raw==32u32||raw==9u32)||unicode.ascii_is_sign(c)!=(raw==43u32||raw==45u32))return 5;
        if(unicode.ascii_is_control(c)!=(raw<32u32||raw==127u32)||unicode.ascii_is_whitespace(c)!=(raw==32u32||raw==9u32||raw==10u32||raw==12u32||raw==13u32))return 6;
        if(unicode.ascii_is_graphic(c)!=graphic||unicode.ascii_is_printable(c)!=(raw>=32u32&&raw<=126u32)||unicode.ascii_is_punctuation(c)!=(graphic&&!alpha&&!digit))return 7;
        u32 lowered=unicode.to_u32(unicode.ascii_to_lowercase(c));u32 raised=unicode.to_u32(unicode.ascii_to_uppercase(c));
        if(lowered!=lower_code(raw)||raised!=(lower?raw-32u32:raw))return 8;
        byte byte_value=Byte.from_u8(represent<u8>(raw));
        if(ascii){if(unicode.to_u32(success(unicode.ascii_from_u8(represent<u8>(raw))))!=raw||unicode.to_u32(success(unicode.ascii_decode(byte_value)))!=raw||success(unicode.ascii_encode(c))!=byte_value)return 9;}
        else {unicode.UnicodeError error=failed(unicode.ascii_encode(c));switch(error){case unicode.UnicodeError.InvalidAscii {u32 value=value}:if(value!=raw)return 10;break;default:return 11;break;}}
        mut u32 right=0u32;
        while(right<256u32){
            char other=success(Char.from_u32(right));u32 a=lower_code(raw);u32 b=lower_code(right);
            i32 order=a<b?-1:(a>b?1:0);
            if(ordering.to_i32(unicode.ascii_compare_ignore_case(c,other))!=order||unicode.ascii_equal_ignore_case(c,other)!=(order==0))return 12;
            right++;
        }
        mut u32 radix=2u32;
        while(radix<=36u32){
            Optional<u32> found=success(unicode.ascii_digit_value(c,radix));
            u32 value=digit?raw-48u32:(upper?raw-65u32+10u32:(lower?raw-97u32+10u32:36u32));
            switch(found){case Optional<u32>.Some {u32 actual=value}:if(value>=radix||actual!=value)return 13;break;case Optional<u32>.None:if(value<radix)return 14;break;}
            radix++;
        }
        raw++;
    }
    if(unicode.ascii_is_whitespace('\u{b}'))return 15;
    return 0;
}
i32 codec_errors(){
    byte incomplete8[2]=[Byte.from_u8(226u8),Byte.from_u8(130u8)];
    unicode.UnicodeError error8=failed(unicode.decode_utf8_at(Slice.from_array(&incomplete8),0usize));
    switch(error8){case unicode.UnicodeError.IncompleteUtf8 {usize position=offset,usize width=expected,usize count=available}:if(position!=0usize||width!=3usize||count!=2usize)return 1;break;default:return 2;break;}
