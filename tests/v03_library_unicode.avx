string owned_text(){return success(unicode.to_string('😀'));}
AnyError erased_error(){return success(AnyError.pack(unicode.UnicodeError.BufferTooSmall {required=4usize,available=1usize}));}
i32 owned_values(){
    string text=owned_text();if(!string.equals(string.view(&text),"😀")||string.scalar_count(string.view(&text))!=1usize)return 1;
    string escaped=success(unicode.escape_unicode('😀'));if(!string.equals(string.view(&escaped),"\\u{1f600}"))return 2;
