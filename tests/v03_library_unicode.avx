    switch(beyond){case unicode.UnicodeError.Encoding {encoding.EncodingError nested=reason}:switch(nested){case encoding.EncodingError.OffsetOutOfBounds {usize position=offset,usize length=length}:if(position!=4usize||length!=3usize)return 13;break;default:return 14;break;}break;default:return 15;break;}
    return 0;
}
i32 bounded_outputs(){
    mut byte short8[3]=[Byte.from_u8(90u8),Byte.from_u8(90u8),Byte.from_u8(90u8)];
    unicode.UnicodeError error=failed(unicode.encode_utf8_into('😀',Slice.from_array_mut(&mut short8)));
    switch(error){case unicode.UnicodeError.BufferTooSmall {usize width=required,usize count=available}:if(width!=4usize||count!=3usize)return 1;break;default:return 2;break;}
    if(Byte.to_u8(short8[0])!=90u8||Byte.to_u8(short8[1])!=90u8||Byte.to_u8(short8[2])!=90u8)return 3;
    mut u16 short16[1]=[90u16];
    failed(unicode.encode_utf16_into('😀',Slice.from_array_mut(&mut short16)));
    if(short16[0]!=90u16)return 4;
