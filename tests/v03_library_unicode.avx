    if(success(unicode.encode_utf8_into('😀',Slice.from_array_mut(&mut buffer8)))!=4usize||Byte.to_u8(buffer8[0])!=240u8||Byte.to_u8(buffer8[1])!=159u8||Byte.to_u8(buffer8[2])!=152u8||Byte.to_u8(buffer8[3])!=128u8||Byte.to_u8(buffer8[4])!=90u8)return 5;
    buffer8[0]=Byte.from_u8(1u8);
    mut u16 buffer16[3]=[90u16,90u16,90u16];
    if(success(unicode.encode_utf16_into('😀',Slice.from_array_mut(&mut buffer16)))!=2usize||buffer16[0]!=55357u16||buffer16[1]!=56832u16||buffer16[2]!=90u16)return 6;
    return 0;
}
i32 text_errors(){
    if(success(unicode.ascii_parse("A"))!='A'||success(unicode.parse_scalar("한"))!='한'||success(unicode.parse_uplus("U+1f600"))!='😀')return 1;
    if(success(unicode.parse_escape("\\u{1F600}"))!='😀'||success(unicode.parse_escape("\\0"))!='\0'||success(unicode.parse_escape("한"))!='한')return 2;
