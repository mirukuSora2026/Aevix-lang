    switch(invalid){case unicode.UnicodeError.Scalar {CharError original=reason}:switch(original){case CharError.InvalidScalar {u32 raw=value}:if(raw!=55296u32)return 5;break;}break;default:return 6;break;}
    unicode.UnicodeError radix=failed(unicode.ascii_digit_value('1',4294967295u32));
