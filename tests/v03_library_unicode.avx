    switch(trailing){case unicode.UnicodeError.TrailingInput {usize position=offset}:if(position!=1usize)return 9;break;default:return 10;break;}
    u16 prefix16[3]=[65u16,55357u16,56832u16];
    Tuple<char,usize> decoded16=success(unicode.decode_utf16_at(Slice.from_array(&prefix16),1usize));
    if(*Tuple.get<0>(&decoded16)!='😀'||*Tuple.get<1>(&decoded16)!=2usize)return 11;
    byte empty[0]=[];
    unicode.UnicodeError empty_error=failed(unicode.from_utf8(Slice.from_array(&empty)));
