/*
 * Exercise every ASCII operation against fixed ASCII category tables and exhaustive radix boundaries.
 * Non-ASCII values deliberately remain unchanged.
 */
import ascii;
u32 categories(char value) {
    mut u32 bits = 0;
    if (ascii.is_ascii(value)) bits |= 1u32;
    if (ascii.is_control(value)) bits |= 2u32;
    if (ascii.is_whitespace(value)) bits |= 4u32;
    if (ascii.is_uppercase(value)) bits |= 8u32;
    if (ascii.is_lowercase(value)) bits |= 16u32;
    if (ascii.is_alphabetic(value)) bits |= 32u32;
    if (ascii.is_digit(value)) bits |= 64u32;
    if (ascii.is_alphanumeric(value)) bits |= 128u32;
    if (ascii.is_hex_digit(value)) bits |= 256u32;
    if (ascii.is_oct_digit(value)) bits |= 512u32;
    if (ascii.is_binary_digit(value)) bits |= 1024u32;
    if (ascii.is_graphic(value)) bits |= 2048u32;
    if (ascii.is_printable(value)) bits |= 4096u32;
    if (ascii.is_punctuation(value)) bits |= 8192u32;
    return bits;
}
u32 categories(byte value) {
    mut u32 bits = 0;
    if (ascii.is_ascii(value)) bits |= 1u32;
    if (ascii.is_control(value)) bits |= 2u32;
    if (ascii.is_whitespace(value)) bits |= 4u32;
    if (ascii.is_uppercase(value)) bits |= 8u32;
    if (ascii.is_lowercase(value)) bits |= 16u32;
    if (ascii.is_alphabetic(value)) bits |= 32u32;
    if (ascii.is_digit(value)) bits |= 64u32;
    if (ascii.is_alphanumeric(value)) bits |= 128u32;
    if (ascii.is_hex_digit(value)) bits |= 256u32;
    if (ascii.is_oct_digit(value)) bits |= 512u32;
    if (ascii.is_binary_digit(value)) bits |= 1024u32;
    if (ascii.is_graphic(value)) bits |= 2048u32;
    if (ascii.is_printable(value)) bits |= 4096u32;
    if (ascii.is_punctuation(value)) bits |= 8192u32;
    return bits;
}
usize index_of(u8 value) { Result<usize, IntegerError> converted = Integer.convert<usize>(value); switch (move converted) { case Result<usize, IntegerError>.Ok { usize index = value }: return index; break; default: Never.unreachable(); break; } }
usize index_of(u32 value) { Result<usize, IntegerError> converted = Integer.convert<usize>(value); switch (move converted) { case Result<usize, IntegerError>.Ok { usize index = value }: return index; break; default: Never.unreachable(); break; } }
bool digit_is(Result<Optional<u32>, ascii.DigitError> result, bool present, u32 expected) {
    switch (move result) {
        case Result<Optional<u32>, ascii.DigitError>.Ok { Optional<u32> option = value }:
            switch (move option) { case Optional<u32>.Some { u32 digit = value }: return present && digit == expected; break; case Optional<u32>.None: return !present; break; }
            break;
        case Result<Optional<u32>, ascii.DigitError>.Err: return false; break;
    }
}
bool character_is(Result<Optional<char>, ascii.DigitError> result, bool present, char expected) {
    switch (move result) {
        case Result<Optional<char>, ascii.DigitError>.Ok { Optional<char> option = value }:
            switch (move option) { case Optional<char>.Some { char digit = value }: return present && digit == expected; break; case Optional<char>.None: return !present; break; }
            break;
        case Result<Optional<char>, ascii.DigitError>.Err: return false; break;
    }
}
bool invalid_digit(Result<Optional<u32>, ascii.DigitError> result) {
    switch (result) { case Result<Optional<u32>, ascii.DigitError>.Err { &ascii.DigitError problem = error }: return string.equals(problem.code(), "ascii.invalid_radix") && string.byte_len(problem.message()) > 0; break; default: return false; break; }
}
bool invalid_character(Result<Optional<char>, ascii.DigitError> result) {
    switch (result) { case Result<Optional<char>, ascii.DigitError>.Err { &ascii.DigitError problem = error }: return string.equals(problem.code(), "ascii.invalid_radix") && string.byte_len(problem.message()) > 0; break; default: return false; break; }
}
