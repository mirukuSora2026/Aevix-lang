class SourceLifecycleTests(unittest.TestCase):
    def test_nested_public_surface(self):
        source = '''
import memory { Box };
public struct Buffer<T> {
    public T item;
    T hidden;
    public T get(&Self self) { public i32 fake = 1; return self.item; }
    T helper() { return item; }
};
public enum Event {
    Quit;
    Message { public string text; i32 hidden; };
    private Secret;
    public i32 code(&Self self) { return 1; }
    i32 helper(&Self self) { return 1; }
};
public interface Named { string_view name(&Self self); };
struct Private { public i32 invisible; };
public T identity<T>(T value) where T implements Copy { return value; }
public type Count = usize;
'''
        names = {item["name"] for item in api.declarations(source, "sample")}
        self.assertEqual(names, {"sample.Buffer", "sample.Buffer.item", "sample.Buffer.get",
                                "sample.Event", "sample.Event.Quit", "sample.Event.Message",
                                "sample.Event.Message.text", "sample.Event.code", "sample.Named",
                                "sample.Named.name", "sample.identity", "sample.Count"})

    def test_annotation_complete_and_idempotent(self):
        source = 'public struct A { public i32 field; public i32 read(&Self self) { return self.field; } };\n'
        updated = api.annotate(source, "sample", "0.3")
        self.assertEqual(updated, api.annotate(updated, "sample", "0.3"))
        for item in api.declarations(updated, "sample"):
            api.validate_lifecycle(item["lifecycle"], item["name"])
        self.assertIn("@module sample", updated)
        self.assertEqual(updated.count("@since 0.3"), 4)

    def test_existing_tags_and_version_preserved(self):
        source = '''/*
 * Retain useful prose.
 * @version 7.2
 * @parameter input Original name.
 * @since 0.2
 * @deprecated_at 0.4
 * @removed_at 0.5
 */
public i32 old(i32 input) { return input; }
'''
        updated = api.annotate(source, "sample", "0.3")
        self.assertIn("@version 7.2", updated)
        self.assertIn("@parameter input Original name.", updated)
        values = api.declarations(updated, "sample")[0]["lifecycle"]
        self.assertEqual(values, {"since": "0.2", "deprecated_at": "0.4", "removed_at": "0.5"})
        self.assertEqual(updated, api.annotate(updated, "sample", "0.3"))

    def test_no_fabricated_deprecation(self):
        updated = api.annotate('public void current() { return; }\n', "sample", "0.3")
        values = api.declarations(updated, "sample")[0]["lifecycle"]
        self.assertEqual(values["deprecated_at"], "none")
