    def test_implicit_array_copy_preserves_overload_boundary(self):
        source = '''
            std::optional<TypeId> valueIntrinsic(const Node& node, TypeId expected)
            {
                if (owner.value == "Array") {
                    if (method != "from_copy") return {};
                    return done(reference.element, "array.copy");
                }
                return {};
            }
'''
        operations = api.array_operations(source)
        self.assertEqual(len(operations), 1)
        self.assertEqual(operations[0]["id"], "intrinsic:Array.from_copy")
        self.assertIn("where T implements Copy", operations[0]["signature"])
        self.assertIn("Arrays remain move-only", operations[0]["availability_note"])
        self.assertIn("fill-constructor", operations[0]["availability_note"])
        updated = api.annotate_implicit(source, "0.3", {})
        self.assertEqual(updated, api.annotate_implicit(updated, "0.3", {}))
        self.assertEqual(api.TOKEN.findall(api.masked_source(source)), api.TOKEN.findall(api.masked_source(updated)))
        self.assertEqual(updated.count("@api Array.from_copy"), 1)
        self.assertIn("@since 0.3", updated)
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            checker = root / api.SIMD_PROVIDER
            checker.parent.mkdir(parents=True)
            checker.write_text(updated)
            recorded = api.implicit_sources(root)
            self.assertEqual(recorded[0]["virtual_module"], "$core")
            self.assertEqual(recorded[0]["lifecycle"]["since"], "0.3")
        with self.assertRaisesRegex(ValueError, "Array namespace dispatch changed"):
            api.array_operations(source.replace('"array.copy"', '"array.changed"'))

    def test_english_comments_preserve_korean_string_literals(self):
        source = '''/*
 * 입력 문자열을 그대로 돌려준다.
 * Return the input text unchanged.
 * @since 0.3
 */
public string_view text() {
    string_view value = "한글 /* 문자열 안의 텍스트 */";
    string_view raw = r#"한글 // 문자열"#;
    return value;
}
// 한국어 요약.
// English summary.
'''
        updated = api.english_comments(source, "sample.avx")
        self.assertNotIn("입력 문자열을", updated)
        self.assertNotIn("한국어 요약", updated)
        self.assertIn("Return the input text unchanged.", updated)
        self.assertIn('"한글 /* 문자열 안의 텍스트 */"', updated)
        self.assertIn('r#"한글 // 문자열"#', updated)
        self.assertIn("// English summary.", updated)
        self.assertEqual(api.TOKEN.findall(api.masked_source(source)), api.TOKEN.findall(api.masked_source(updated)))
        with self.assertRaisesRegex(ValueError, "meaningful English translation"):
            api.english_comments('/* 순수 한국어 설명. */\npublic void f() {}', "sample.avx")
        with self.assertRaisesRegex(ValueError, "without dropping tags"):
            api.english_comments('/*\n * Return the value.\n * @version 1.0 한국어 설명.\n */', "sample.avx")


