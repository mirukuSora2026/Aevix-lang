    def test_float_bits_lifecycle_requires_dispatch_not_only_comments(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            provider = root / api.SIMD_PROVIDER
            provider.parent.mkdir(parents=True)
            docs = "\n".join("/*\n * @api Float." + name + "\n * @since 0.3\n * @deprecated_at none\n * @removed_at none\n */"
                             for name in ("to_bits", "from_bits"))
            provider.write_text(docs)
            self.assertEqual(api.implicit_sources(root), [])
            dispatch = 'if (node.kind == "CompilerFloatBitsExpression") { if (node.value == "Float.to_bits" || node.value == "Float.from_bits") return output; }'
            provider.write_text(docs + "\n" + dispatch)
            items = api.implicit_sources(root)
            self.assertEqual({item["name"] for item in items}, {"Float.to_bits", "Float.from_bits"})
            for item in items:
                api.validate_lifecycle(item["lifecycle"], item["name"])
                self.assertIn("f16/bf16 pair with u16", item["availability_note"])
                self.assertNotIn("provider_declaration", item)
            provider.write_text(docs + '\nif (node.kind == "CompilerFloatBitsExpression") { return output; }')
            with self.assertRaisesRegex(ValueError, "dispatch changed"):
                api.implicit_sources(root)

