    def test_render_checkpoint_is_separate_from_new_declaration_presence(self):
        checkpoint = {"checkpoint_id": "2026-10-18<&>",
                      "ctest": {"passed": 106, "total": 106, "elapsed_seconds": 294.03},
                      "binary": {"sha256": "e1fec8a4"},
                      "source_snapshot": {"public_declarations": 1971}}
        output = api.render({"source": []}, checkpoint=checkpoint)
        self.assertIn('id="Verified-Checkpoint"', output)
        self.assertIn("106/106", output)
        self.assertIn("2026-10-18&lt;&amp;&gt;", output)
        self.assertIn("later source declarations and compiler changes are unverified", output)
        self.assertIn("does not complete the CPU library catalog", output)
        self.assertNotIn("Verified-Checkpoint", api.render({"source": []}))

