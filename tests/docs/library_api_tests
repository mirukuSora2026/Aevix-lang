    def test_inventory_detects_added_removed_and_changed_api(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            path = root / "library/Core/sample.avx"
            path.parent.mkdir(parents=True)
            path.write_text(api.annotate('public i32 value() { return 1; }\n', "sample", "0.3"))
            with contextlib.redirect_stdout(io.StringIO()):
                api.main(["--root", str(root), "inventory"])
                api.main(["--root", str(root), "check"])
            original = path.read_text()
            for changed in (original + 'public i32 newer() { return 2; }\n',
                            original.replace('public i32 value()', 'public i32 changed()'),
                            original.replace('public i32 value()', 'public i64 value()')):
                path.write_text(changed)
                with self.assertRaisesRegex(ValueError, "inventory mismatch"):
                    api.main(["--root", str(root), "check"])
            path.write_text(original.replace('@removed_at none', '@removed_at 0.5', 1))
            with self.assertRaisesRegex(ValueError, "Stale lifecycle"):
                api.main(["--root", str(root), "check"])

