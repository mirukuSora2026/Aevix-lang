    def test_invalid_and_duplicate_metadata(self):
        with self.assertRaisesRegex(ValueError, "Duplicate"):
            api.lifecycle('/*\n * @since 0.2\n * @since 0.3\n */')
        for values in ({"since": "none", "deprecated_at": "none", "removed_at": "none"},
                       {"since": "0.3", "deprecated_at": "0.2", "removed_at": "none"},
                       {"since": "0.2", "deprecated_at": "0.4", "removed_at": "0.3"},
                       {"since": "0.3", "deprecated_at": "0.3-beta", "removed_at": "none"}):
            with self.assertRaises(ValueError):
                api.validate_lifecycle(values, "sample")

