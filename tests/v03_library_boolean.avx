        if (Optional.is_some(&uncalled) || success(Atomic.load(&evaluated,MemoryOrder.Relaxed)) != 4 || success(Atomic.load(&destroyed,MemoryOrder.Relaxed)) != 5) return 24;
    }
    {
        Owned capture = Owned { value = 60 };
        Optional<Owned> called = boolean.then(true,[capture]() -> Owned { success(Atomic.fetch_add(&evaluated,1,MemoryOrder.Relaxed)); return Owned { value = capture.value }; });
        if (!Optional.is_some(&called) || success(Atomic.load(&evaluated,MemoryOrder.Relaxed)) != 5 || success(Atomic.load(&destroyed,MemoryOrder.Relaxed)) != 6) return 25;
