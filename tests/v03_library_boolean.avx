    if (boolean.all(Slice.from_array(&inputs)) || !boolean.any(Slice.from_array(&inputs)) || boolean.count_true(Slice.from_array(&inputs)) != 3usize) return 11;
    for (i32 encoded in Range.new(0,2)) {
        bool value = encoded == 1;
        string_view token = value ? "true" : "false";
        usize required = string.byte_len(token);
        string owned = success(boolean.format(value));
        if (!string.equals(string.view(&owned),token)) return 12;
        for (usize capacity in Range.new(0usize,7usize)) {
            mut byte output[6] = [Byte.from_u8(99u8),Byte.from_u8(99u8),Byte.from_u8(99u8),Byte.from_u8(99u8),Byte.from_u8(99u8),Byte.from_u8(99u8)];
            Result<usize,boolean.BooleanError> result = boolean.format_into(value,success(Slice.slice_mut(Slice.from_array_mut(&mut output),0usize,capacity)));
            if (capacity < required) {
                switch (result) {
                    case Result<usize,boolean.BooleanError>.Ok: return 13; break;
                    case Result<usize,boolean.BooleanError>.Err { boolean.BooleanError cause = error }:
                        switch (cause) { case boolean.BooleanError.BufferTooSmall { usize needed = required, usize available = available }: if (needed != required || available != capacity) return 14; break; default: return 15; break; }
                        break;
                }
                for (byte item : output) if (Byte.to_u8(item) != 99u8) return 16;
            } else {
                if (success(result) != required) return 17;
                Slice<byte> expected = string.as_bytes(token);
                for (usize index in Range.new(0usize,6usize)) if (Byte.to_u8(output[index]) != (index < required ? Byte.to_u8(expected[index]) : 99u8)) return 18;
            }
        }
    }
    {
