};
bool bump(bool value) { success(Atomic.fetch_add(&evaluated,1,MemoryOrder.Relaxed)); return value; }
bool invalid_text(string_view token) {
    switch (boolean.parse(token)) {
        case Result<bool,boolean.BooleanError>.Ok: return false; break;
        case Result<bool,boolean.BooleanError>.Err { boolean.BooleanError failure = error }:
            switch (failure) { case boolean.BooleanError.InvalidText: return true; break; default: return false; break; }
            break;
    }
}
i32 main() {
    for (i32 l in Range.new(0,2)) {
        for (i32 r in Range.new(0,2)) {
            bool left = l == 1;
            bool right = r == 1;
