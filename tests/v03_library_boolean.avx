    if (!success(boolean.parse("true")) || success(boolean.parse("false"))) return 8;
    if (!invalid_text("") || !invalid_text("True") || !invalid_text("FALSE") || !invalid_text(" true") || !invalid_text("false ") || !invalid_text("1") || !invalid_text("true\0") || !invalid_text("trué")) return 9;
    bool empty[0] = [];
    bool inputs[5] = [false,true,true,false,true];
