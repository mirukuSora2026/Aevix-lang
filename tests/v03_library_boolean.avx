    if (string.is_empty(packed.message())) return 36;
    boolean.BooleanError reasons[4] = [boolean.BooleanError.InvalidRepresentation,boolean.BooleanError.InvalidText,boolean.BooleanError.AllocationFailure,boolean.BooleanError.BufferTooSmall { required = 5usize, available = 4usize }];
    string_view codes[4] = ["boolean.invalid_representation","boolean.invalid_text","boolean.allocation_failure","boolean.buffer_too_small"];
    for (usize index in Range.new(0usize,4usize)) {
        if (!string.equals(reasons[index].code(),codes[index]) || string.is_empty(reasons[index].message())) return 37;
    }
    return 0;
