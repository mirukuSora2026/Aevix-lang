    if (success(Atomic.load(&destroyed,MemoryOrder.Relaxed)) != 7) return 26;
    success(boolean.ok_or(true,Owned { value = 70 }));
    if (success(Atomic.load(&destroyed,MemoryOrder.Relaxed)) != 8) return 27;
    {
