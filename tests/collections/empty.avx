Result<i32,CollectionError> run() {i32 values[] = []?; if (Vector.len(&values) == 0) return Result.ok(42); return Result.ok(9);}
i32 main() { Result<i32,CollectionError> result = run(); switch (move result) { case Result<i32,CollectionError>.Ok { i32 n = value }: return n; break; case Result<i32,CollectionError>.Err: return 99; break; } }
