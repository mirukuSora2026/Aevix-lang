# Description :
#     범위의 보폭과 정확한 길이를 AOT 및 JIT 경계 사례로 검증한다.
#     Verify Range stepping and exact cardinality with AOT and JIT boundary cases.
#
# ========================
if(NOT DEFINED COMPILER OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "COMPILER and TEST_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${COMPILER}" --version OUTPUT_VARIABLE version RESULT_VARIABLE version_result)
set(modes --run)
if(version MATCHES "ORC JIT enabled")
    list(APPEND modes --jit)
endif()
function(run_range name body expected)
    set(path "${TEST_DIR}/${name}.avx")
    file(WRITE "${path}" "T identity<T>(T value) { return value; } T duplicate<T>(T value) where T implements Copy { T original = value; return original; } i32 endpoint(&mut i32 calls) { (*calls)++; return *calls; } Result<i32,RangeError> work() { ${body} }\ni32 main() { Result<i32,RangeError> result = work(); switch (move result) { case Result<i32,RangeError>.Ok { i32 number = value }: return number; break; case Result<i32,RangeError>.Err: return 99; break; } }\n")
    foreach(mode IN LISTS modes)
        foreach(level IN ITEMS 0 3)
            execute_process(COMMAND "${COMPILER}" "${mode}" "-O${level}" "${path}" RESULT_VARIABLE result ERROR_VARIABLE error OUTPUT_VARIABLE output TIMEOUT 30)
            if(NOT "${result}" STREQUAL "${expected}")
                message(FATAL_ERROR "${name} ${mode} O${level}: expected ${expected}, got ${result}\n${error}\n${output}")
            endif()
        endforeach()
    endforeach()
endfunction()
run_range(ascending "Range<i32> r = Range.with_step(Range.closed(0,10),4)?; usize count = Range.len(&r)?; mut i32 sum = 0; for (i32 n in r) sum += n; return Result.ok(count == 3 && sum == 12 ? 42 : 9);" 42)
run_range(half_open "Range<i32> r = Range.with_step(0..10,4)?; usize count = Range.len(&r)?; return Result.ok(count == 3 ? 42 : 9);" 42)
run_range(descending "Range<i32> r = Range.with_step(Range.descending_closed(10,0),4)?; usize count = Range.len(&r)?; mut i32 sum = 0; for (i32 n in r) sum += n; return Result.ok(count == 3 && sum == 18 ? 42 : 9);" 42)
run_range(empty "Range<i32> r = Range.with_step(10..0,4)?; usize count = Range.len(&r)?; return Result.ok(count == 0 ? 42 : 9);" 42)
run_range(singleton "Range<i32> r = Range.with_step(7..=7,3)?; usize count = Range.len(&r)?; return Result.ok(count == 1 ? 42 : 9);" 42)
run_range(invalid_step "Result<Range<i32>,RangeError> r = Range.with_step(0..10,0); switch (move r) { case Result<Range<i32>,RangeError>.Ok: return Result.ok(8); break; case Result<Range<i32>,RangeError>.Err { RangeError reason = error }: switch (reason) { case RangeError.InvalidStep: return Result.ok(42); break; case RangeError.CountOverflow: return Result.ok(9); break; } break; }" 42)
run_range(unsigned_boundary "u8 start = 0; u8 end = 255; Range<u8> r = Range.with_step(Range.closed(start,end),255)?; usize count = Range.len(&r)?; mut i32 visits = 0; for (u8 n in r) visits++; return Result.ok(count == 2 && visits == 2 ? 42 : 9);" 42)
run_range(signed_boundary "i8 start = -128; i8 end = 127; Range<i8> r = Range.with_step(Range.closed(start,end),255)?; usize count = Range.len(&r)?; mut i32 visits = 0; for (i8 n in r) visits++; return Result.ok(count == 2 && visits == 2 ? 42 : 9);" 42)
run_range(unsigned_descending "u8 start = 255; u8 end = 0; Range<u8> r = Range.with_step(Range.descending_closed(start,end),255)?; usize count = Range.len(&r)?; mut i32 visits = 0; for (u8 n in r) visits++; return Result.ok(count == 2 && visits == 2 ? 42 : 9);" 42)
run_range(u64_cardinality "u64 low = 0; u64 high = 18446744073709551615; Range<u64> r = Range.closed(low,high); Result<usize,RangeError> count = Range.len(&r); mut i32 visits = 0; for (u64 n in r) { visits++; if (visits == 3) break; } return Result.ok(Result.is_err(&count) && visits == 3 ? 42 : 9);" 42)
run_range(i64_cardinality "i64 low = -9223372036854775808; i64 high = 9223372036854775807; Range<i64> r = Range.closed(low,high); Result<usize,RangeError> count = Range.len(&r); return Result.ok(Result.is_err(&count) ? 42 : 9);" 42)
run_range(u64_max_fits "u64 low = 0; u64 high = 18446744073709551615; Range<u64> r = Range.new(low,high); usize count = Range.len(&r)?; usize expected = 18446744073709551615; return Result.ok(count == expected ? 42 : 9);" 42)
run_range(i32_full_fits "i32 low = -2147483648; i32 high = 2147483647; Range<i32> r = Range.closed(low,high); usize count = Range.len(&r)?; return Result.ok(count == 4294967296 ? 42 : 9);" 42)
run_range(contextual_u8 "Range<u8> r = Range.with_step(Range.closed(0,255),255)?; usize count = Range.len(&r)?; return Result.ok(count == 2 ? 42 : 9);" 42)
run_range(wide_step "u64 low = 0; u64 high = 18446744073709551615; Range<u64> r = Range.with_step(Range.closed(low,high),high)?; usize count = Range.len(&r)?; mut i32 visits = 0; for (u64 n in r) visits++; return Result.ok(count == 2 && visits == 2 ? 42 : 9);" 42)
run_range(inferred_generic "rsn r = Range.with_step(0..10,4)?; Range<i32> copy = identity(r); rsn count = Range.len(&copy)?; usize passed = identity(count); return Result.ok(passed == 3 ? 42 : 9);" 42)
run_range(endpoints_once "mut i32 calls = 0; Range<i32> r = Range.with_step(endpoint(&mut calls)..endpoint(&mut calls),1)?; mut i32 visits = 0; for (i32 n in r) visits++; return Result.ok(calls == 2 && visits == 1 ? 42 : 9);" 42)
run_range(isize_step "isize start = -2; isize end = 2; usize stride = 2; Range<isize> r = Range.with_step(Range.closed(start,end),stride)?; usize count = Range.len(&r)?; return Result.ok(count == 3 ? 42 : 9);" 42)
run_range(copy_constraint "Range<i32> r = Range.with_step(0..10,4)?; Range<i32> copy = duplicate(r); usize count = Range.len(&copy)?; return Result.ok(count == 3 ? 42 : 9);" 42)
run_range(contextual_result_u8 "Result<Range<u8>,RangeError> raw = Range.with_step(Range.closed(0,255),255); Range<u8> r = raw?; usize count = Range.len(&r)?; return Result.ok(count == 2 ? 42 : 9);" 42)
run_range(inferred_result "rsn raw = Range.with_step(Range.closed(0,255),255); rsn r = raw?; rsn count = Range.len(&r)?; return Result.ok(count == 2 ? 42 : 9);" 42)
function(reject_range name body)
    set(path "${TEST_DIR}/${name}.avx")
    file(WRITE "${path}" "Result<i32,RangeError> work() { ${body} return Result.ok(0); } i32 main() { return 0; }\n")
    execute_process(COMMAND "${COMPILER}" --check "${path}" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR "${name}: invalid Range operation accepted")
    endif()
endfunction()
reject_range(signed_step "Range<i32> r = 0..3; i32 step = 2; Range<i32> bad = Range.with_step(r,step)?;")
reject_range(wrong_width "Range<i8> r = Range.new(0,3); u64 step = 2; Range<i8> bad = Range.with_step(r,step)?;")
reject_range(missing_borrow "Range<i32> r = 0..3; usize count = Range.len(r)?;")
reject_range(borrowed_step "Range<i32> r = 0..3; Range<i32> bad = Range.with_step(&r,2)?;")
reject_range(negative_step "Range<i32> r = 0..3; Range<i32> bad = Range.with_step(r,-1)?;")
message(STATUS "Range API: 21 positive programs across AOT/JIT O0/O3; 5 negative programs passed")
