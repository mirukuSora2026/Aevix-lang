parts=['''import error { Error };
import integer;

public enum RangeDirection implements Copy { Ascending; Descending; };
public enum RangeOperationError implements Copy, Error {
    OutOfBounds { public usize index; };
    InvalidStep;
    StepOverflow;
    public string_view code(&Self self) {
        switch(*self) {
            case Self.OutOfBounds:return "range.ordinal_out_of_bounds";break;
            case Self.InvalidStep:return "range.invalid_step_factor";break;
            case Self.StepOverflow:return "range.step_overflow";break;
        }
    }
    public string_view message(&Self self) {
        switch(*self) {
            case Self.OutOfBounds:return "The ordinal is outside the finite range sequence.";break;
            case Self.InvalidStep:return "The step factor must be positive.";break;
            case Self.StepOverflow:return "The scaled step does not fit its unsigned magnitude type.";break;
        }
    }
};
T success<T,E>(Result<T,E> input) {
    switch(move input){case Result<T,E>.Ok{T value=value}:return value;break;default:Never.unreachable();break;}
}
u128 widen<T>(T value) where T implements Copy {
    Result<u128,IntegerError> converted=Integer.convert<u128>(value);
    u128 output=success<u128,IntegerError>(converted);
    return output;
}
struct RankedRange implements Copy {
    public u128 first;
    public u128 limit;
    public u128 magnitude;
    public bool descending;
    public bool inclusive;
    public bool empty;
};
''']
types=[(f'{p}{w}',w,p=='i')for w in(8,16,32,64,128)for p in('i','u')]+[('isize',64,True),('usize',64,False)]
for t,w,signed in types:
    if signed:
        bias=1<<(w-1)
        parts.append(f'''u128 rank({t} value) {{
    if(value<0{t}){{u128 magnitude=widen(integer.unsigned_abs(value));return {bias}u128-magnitude;}}
    u128 nonnegative=widen(value);return {bias}u128+nonnegative;
}}
{t} unrank({t} witness,u128 value) {{
    if(value<{bias}u128){{u128 magnitude={bias}u128-value;{t} predecessor=success(Integer.convert<{t}>(magnitude-1u128));return -predecessor-1{t};}}
    u128 nonnegative=value-{bias}u128;return success(Integer.convert<{t}>(nonnegative));
}}''')
    else:
        parts.append(f'''u128 rank({t} value){{return widen(value);}}
{t} unrank({t} witness,u128 value){{return success(Integer.convert<{t}>(value));}}''')
parts.append('''
RankedRange ranked<T>(&Range<T> descriptor) where T implements Copy {
    T begin=Range.start(descriptor);
    T end=Range.end(descriptor);
    u128 first=rank(begin);
    u128 limit=rank(end);
    u128 magnitude=widen(Range.step_magnitude(descriptor));
    return RankedRange{first=first,limit=limit,magnitude=magnitude,descending=Range.is_descending(descriptor),inclusive=Range.is_inclusive(descriptor),empty=Range.is_empty(descriptor)};
}
u128 last_ordinal(&RankedRange descriptor) {
    u128 distance=descriptor.descending?descriptor.first-descriptor.limit:descriptor.limit-descriptor.first;
    u128 eligible=descriptor.inclusive?distance:distance-1u128;
    return eligible/descriptor.magnitude;
}
u128 ordinal_rank(&RankedRange descriptor,u128 ordinal) {
    u128 distance=ordinal*descriptor.magnitude;
    return descriptor.descending?descriptor.first-distance:descriptor.first+distance;
}
Optional<u128> lookup(&RankedRange descriptor,u128 ordinal) {
    if(descriptor.empty)return Optional.none();
    u128 final=last_ordinal(descriptor);
    if(ordinal>final)return Optional.none();
    return Optional.some(ordinal_rank(descriptor,ordinal));
}
Range<T> same_step<T>(Range<T> output,&Range<T> original) where T implements Copy {
    return success(Range.with_step(output,Range.step_magnitude(original)));
}
Range<T> closed_segment<T>(T first,T last,&Range<T> original) where T implements Copy {
    Range<T> output=Range.is_descending(original)?Range.descending_closed(first,last):Range.closed(first,last);
    return same_step(output,original);
}
Range<T> suffix<T>(T first,&Range<T> original) where T implements Copy {
    T end=Range.end(original);
    bool descending=Range.is_descending(original);
    bool inclusive=Range.is_inclusive(original);
    Range<T> output=descending?(inclusive?Range.descending_closed(first,end):Range.descending(first,end)):(inclusive?Range.closed(first,end):Range.new(first,end));
    return same_step(output,original);
}

public Range<T> empty<T>() where T implements Copy {
    T zero=success(Integer.convert<T>(0u8));
    return Range.new(zero,zero);
}
public RangeDirection direction<T>(&Range<T> descriptor) where T implements Copy {
    return Range.is_descending(descriptor)?RangeDirection.Descending:RangeDirection.Ascending;
}
public bool contains<T>(&Range<T> descriptor,T value) where T implements Copy {
    RankedRange state=ranked(descriptor);
    if(state.empty)return false;
    u128 candidate=rank(value);
    if(state.descending?candidate>state.first:candidate<state.first)return false;
    u128 distance=state.descending?state.first-candidate:candidate-state.first;
    u128 extent=state.descending?state.first-state.limit:state.limit-state.first;
    if(state.inclusive?distance>extent:distance>=extent)return false;
    return distance%state.magnitude==0u128;
}
public bool equal<T>(&Range<T> left,&Range<T> right) where T implements Copy {
    RankedRange a=ranked(left);RankedRange b=ranked(right);
    return a.first==b.first&&a.limit==b.limit&&a.magnitude==b.magnitude&&a.descending==b.descending&&a.inclusive==b.inclusive;
}
public Optional<T> first<T>(&Range<T> descriptor) where T implements Copy {
    if(Range.is_empty(descriptor))return Optional.none();
    T value=Range.start(descriptor);return Optional.some(value);
}
public Optional<T> get<T>(&Range<T> descriptor,usize index) where T implements Copy {
    RankedRange state=ranked(descriptor);
    u128 ordinal=widen(index);
    switch(move lookup(&state,ordinal)){
        case Optional<u128>.Some{u128 raw=value}:T witness=Range.start(descriptor);T output=unrank(witness,raw);return Optional.some(output);break;
        case Optional<u128>.None:return Optional.none();break;
    }
}
public Optional<T> last<T>(&Range<T> descriptor) where T implements Copy {
    RankedRange state=ranked(descriptor);
    if(state.empty)return Optional.none();
    u128 ordinal=last_ordinal(&state);
    u128 raw=ordinal_rank(&state,ordinal);
    T witness=Range.start(descriptor);T value=unrank(witness,raw);return Optional.some(value);
}
public Result<T,RangeOperationError> at<T>(&Range<T> descriptor,usize index) where T implements Copy {
    switch(move get(descriptor,index)){
        case Optional<T>.Some{T value=value}:return Result.ok(value);break;
        case Optional<T>.None:return Result.err(RangeOperationError.OutOfBounds{index=index});break;
    }
}
public Range<T> reverse<T>(Range<T> descriptor) where T implements Copy {
    RankedRange state=ranked(&descriptor);
    if(state.empty)return empty<T>();
    u128 ordinal=last_ordinal(&state);u128 final_rank=ordinal_rank(&state,ordinal);
    T begin=Range.start(&descriptor);T last=unrank(begin,final_rank);
    Range<T> output=state.descending?Range.closed(last,begin):Range.descending_closed(last,begin);
    return same_step(output,&descriptor);
}
public Range<T> take<T>(Range<T> descriptor,usize count) where T implements Copy {
    if(count==0usize)return empty<T>();
    RankedRange state=ranked(&descriptor);
    if(state.empty)return descriptor;
    u128 amount=widen(count);u128 final=last_ordinal(&state);
    if(amount>final)return descriptor;
    u128 last_rank=ordinal_rank(&state,amount-1u128);
    T begin=Range.start(&descriptor);T end=unrank(begin,last_rank);
    return closed_segment(begin,end,&descriptor);
}
public Range<T> skip<T>(Range<T> descriptor,usize count) where T implements Copy {
    if(count==0usize)return descriptor;
    RankedRange state=ranked(&descriptor);
    if(state.empty)return descriptor;
    u128 amount=widen(count);u128 final=last_ordinal(&state);
    if(amount>final)return empty<T>();
    u128 first_rank=ordinal_rank(&state,amount);
    u128 last_rank=ordinal_rank(&state,final);
    T witness=Range.start(&descriptor);T begin=unrank(witness,first_rank);T end=unrank(witness,last_rank);
    return closed_segment(begin,end,&descriptor);
}
public Result<Tuple<Range<T>,Range<T>>,RangeOperationError> split_at<T>(Range<T> descriptor,usize index) where T implements Copy {
    RankedRange state=ranked(&descriptor);u128 ordinal=widen(index);
    if(state.empty){if(index!=0usize)return Result.err(RangeOperationError.OutOfBounds{index=index});}
    else if(index!=0usize){u128 final=last_ordinal(&state);if(ordinal>final&&ordinal-1u128!=final)return Result.err(RangeOperationError.OutOfBounds{index=index});}
    Range<T> prefix=take(descriptor,index);Range<T> tail=skip(descriptor,index);
    return Result.ok(Tuple.make(prefix,tail));
}
public bool sequence_equal<T>(&Range<T> left,&Range<T> right) where T implements Copy {
    RankedRange a=ranked(left);RankedRange b=ranked(right);
    if(a.empty||b.empty)return a.empty==b.empty;
    if(a.first!=b.first)return false;
    u128 a_last=last_ordinal(&a);u128 b_last=last_ordinal(&b);
    if(a_last!=b_last)return false;
    return a_last==0u128||(a.magnitude==b.magnitude&&a.descending==b.descending);
}
Result<u128,RangeOperationError> scale_step(u128 old,u128 factor,u128 maximum) {
    if(factor==0u128)return Result.err(RangeOperationError.InvalidStep);
    if(old>maximum/factor)return Result.err(RangeOperationError.StepOverflow);
    return Result.ok(old*factor);
}
public struct Cursor<T> implements Copy where T implements Copy {
    T witness;
    u128 current;
    u128 final;
    u128 magnitude;
    bool descending;
    bool active;
    public Self new(Range<T> descriptor){
        RankedRange state=ranked(&descriptor);
        u128 final=state.empty?state.first:ordinal_rank(&state,last_ordinal(&state));
        T witness=Range.start(&descriptor);
        return Self{witness=witness,current=state.first,final=final,magnitude=state.magnitude,descending=state.descending,active=!state.empty};
    }
    public bool is_exhausted(&Self self){return !self.active;}
    public Optional<T> next(&mut Self self){
        if(!self.active)return Optional.none();
        u128 raw=self.current;
        if(raw==self.final)self.active=false;
        else self.current=self.descending?self.current-self.magnitude:self.current+self.magnitude;
        T output=unrank(self.witness,raw);return Optional.some(output);
    }
    public Optional<T> next_back(&mut Self self){
        if(!self.active)return Optional.none();
        u128 raw=self.final;
        if(raw==self.current)self.active=false;
        else self.final=self.descending?self.final+self.magnitude:self.final-self.magnitude;
        T output=unrank(self.witness,raw);return Optional.some(output);
    }
};
public Cursor<T> iter<T>(Range<T> descriptor) where T implements Copy {return Cursor<T>.new(descriptor);}
public Cursor<T> rev_iter<T>(Range<T> descriptor) where T implements Copy {Range<T> reversed=reverse(descriptor);return Cursor<T>.new(reversed);}
''')
for t,w,signed in types:
    u='usize'if t=='isize'else'u'+str(w)if signed else t
    parts.append(f'''public Result<Range<{t}>,RangeOperationError> step_by(Range<{t}> descriptor,{u} factor){{
    u128 magnitude=widen(Range.step_magnitude(&descriptor));u128 multiplier=widen(factor);
    u128 product=scale_step(magnitude,multiplier,{(1<<w)-1}u128)?;
    {u} narrowed=success(Integer.convert<{u}>(product));
    Range<{t}> output=success(Range.with_step(descriptor,narrowed));return Result.ok(output);
}}''')
parts.append('''
public enum RangeArrayError implements Copy, Error {
    CountOverflow;
    LengthMismatch { public usize expected; public usize actual; };
    public string_view code(&Self self) {
        switch(*self){case Self.CountOverflow:return "range.array_count_overflow";break;case Self.LengthMismatch:return "range.array_length_mismatch";break;}
    }
    public string_view message(&Self self) {
        switch(*self){case Self.CountOverflow:return "The range cardinality cannot be represented by usize.";break;case Self.LengthMismatch:return "The range cardinality differs from the fixed array extent.";break;}
    }
};

T integer_zero<T>() where T implements Copy {
    switch(move Integer.convert<T>(0u8)){
        case Result<T,IntegerError>.Ok{T value=value}:return value;break;
        default:Never.unreachable();break;
    }
}
public Result<Vector<T>,CollectionError> collect_vector<T>(Range<T> descriptor) where T implements Copy {
    mut usize count=0usize;
    switch(move Range.len(&descriptor)) {
        case Result<usize,RangeError>.Ok{usize length=value}:count=length;break;
        case Result<usize,RangeError>.Err{RangeError reason=error}:
            switch(move reason){case RangeError.CountOverflow:return Result.err(CollectionError.SizeOverflow);break;case RangeError.InvalidStep:Never.unreachable();break;}break;
    }
    mut Vector<T> output=[]?;
    Vector.reserve(&mut output,count)?;
    mut Cursor<T> cursor=iter(descriptor);
    while(!cursor.is_exhausted()) {
        switch(move cursor.next()) {
            case Optional<T>.Some{T value=value}:
                Result<unit,InputError<T>> appended=Vector.push(&mut output,value);
                switch(move appended){
                    case Result<unit,InputError<T>>.Ok:break;
                    case Result<unit,InputError<T>>.Err{InputError<T> reason=error}:
                        switch(move reason){case InputError<T>.AllocationFailure:return Result.err(CollectionError.AllocationFailure);break;case InputError<T>.SizeOverflow:return Result.err(CollectionError.SizeOverflow);break;case InputError<T>.OutOfBounds:Never.unreachable();break;}break;
                }break;
            case Optional<T>.None:Never.unreachable();break;
        }
    }
    return Result.ok(output);
}
public Result<Array<T,N>,RangeArrayError> to_array<const usize N,T>(Range<T> descriptor) where T implements Copy {
    mut usize count=0usize;
    switch(move Range.len(&descriptor)) {
        case Result<usize,RangeError>.Ok{usize length=value}:count=length;break;
        case Result<usize,RangeError>.Err{RangeError reason=error}:
            switch(move reason){case RangeError.CountOverflow:return Result.err(RangeArrayError.CountOverflow);break;case RangeError.InvalidStep:Never.unreachable();break;}break;
    }
    if(count!=N)return Result.err(RangeArrayError.LengthMismatch{expected=N,actual=count});
    T zero=integer_zero<T>();
    mut Array<T,N> output=[zero;N];
    mut usize index=0usize;
    mut Cursor<T> cursor=iter(descriptor);
    while(index<N) {
        switch(move cursor.next()) {
            case Optional<T>.Some{T value=value}:output[index]=value;break;
            case Optional<T>.None:Never.unreachable();break;
        }
        index++;
    }
    return Result.ok(output);
}
''')
