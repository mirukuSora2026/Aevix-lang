def require(condition, message):
    if not condition:
        raise SystemExit(message)


input_manifest = json.loads((INPUT / 'manifest.json').read_text(encoding='utf-8'))
require(hashlib.sha256(json.dumps(input_manifest, sort_keys=True, separators=(',', ':')).encode()).hexdigest() == '70bf55c770fdc341bcfc65168784431b6eedb8a63fd7b4cb8ca69bc5a3d5016c', 'Pinned Unicode input manifest changed.')
