def rows(filename):
    for raw in (INPUT / filename).read_text(encoding='utf-8-sig').splitlines():
        clean = raw.split('#', 1)[0].strip()
        if clean:
            yield [part.strip() for part in clean.split(';')]


def span(text):
    parts = text.split('..')
    return int(parts[0], 16), int(parts[-1], 16)


def assign(values, left, right, value):
    values[left:right + 1] = array(values.typecode, [value]) * (right - left + 1)


def pascal(value):
    value = ''.join(word[:1].upper() + word[1:] for word in re.split(r'[^A-Za-z0-9]+', value) if word)
    return 'Value' + value if value[:1].isdigit() else value


aliases = {}
for parts in rows('PropertyValueAliases.txt'):
    if len(parts) < 3:
        continue
    for spelling in parts[1:]:
        if spelling:
            aliases[(parts[0], spelling)] = parts[2]


def canonical(prop, value):
    return aliases.get((prop, value), value)


def pack(value, width):
    assert 0 <= value < 64 ** width, (value, width)
    return ''.join(chr(48 + ((value >> (6 * shift)) & 63)) for shift in range(width - 1, -1, -1))


def literal(value):
    return json.dumps(value, ensure_ascii=True)


def doc(text):
    return '/*\n * ' + text + '\n * @since 0.3\n * @deprecated_at none\n * @removed_at none\n */\n'


pieces = []
tables = {}
properties = {}
enum_specs = {}


def data(name, payload):
    pieces.append('string_view ucd_' + name + '_data(){return ' + literal(payload) + ';}\n')
    tables[name] = {'bytes': len(payload), 'sha256': hashlib.sha256(payload.encode('ascii')).hexdigest()}


def ranges(name, values, width=2):
    records = []
    last = None
    for code, value in enumerate(values):
        if value != last:
            records.append(pack(code, 4) + pack(value, width))
            last = value
    data(name, ''.join(records))
    tables[name]['records'] = len(records)
    tables[name]['value_width'] = width


def add_enum(name, variants):
    assert len(set(variants)) == len(variants), name
    enum_specs[name] = variants
    pieces.append(doc('Unicode 17 ' + name + ' property values; variants have no numeric ABI guarantee.'))
    pieces.append('public enum ' + name + ' implements Copy {\n')
    for variant in variants:
        pieces.append(doc('The ' + variant + ' value from the pinned Unicode property artifact.'))
        pieces.append(variant + ';\n')
    pieces.append('};\n')
    pieces.append(name + ' ucd_' + name + '(u32 value){switch(value){\n')
    for index, variant in enumerate(variants):
        pieces.append('case ' + str(index) + 'u32:return ' + name + '.' + variant + ';break;\n')
    pieces.append('default:Never.unreachable();break;}}\n')


def prop_file(filename, prop, default, field=1, select=None):
    actual = []
    missing = []
    for raw in (INPUT / filename).read_text(encoding='utf-8-sig').splitlines():
        if '@missing:' in raw:
            parts = [part.strip() for part in raw.split('@missing:', 1)[1].split(';')]
            if select and (len(parts) < 3 or parts[1] != select):
                continue
            missing.append((span(parts[0]), parts[-1]))
        clean = raw.split('#', 1)[0].strip()
        if not clean:
            continue
        parts = [part.strip() for part in clean.split(';')]
        if select and (len(parts) < 3 or parts[1] != select):
            continue
        actual.append((span(parts[0]), parts[field]))
    names = {canonical(prop, default)}
    names.update(canonical(prop, value) for _, value in actual + missing)
    ordered = sorted(names)
    ids = {value: index for index, value in enumerate(ordered)}
    result = array('I', [ids[canonical(prop, default)]]) * LIMIT
    for (first, last), value in missing + actual:
        assign(result, first, last, ids[canonical(prop, value)])
    return result, ordered


pieces.append('''
u32 ucd_unpack(Slice<byte> input,usize offset,usize width){
    mut u32 result=0u32;mut usize index=0usize;
    while(index<width){result=(result<<6)|represent<u32>(Byte.to_u8(input[offset+index])-48u8);index++;}
    return result;
}
u32 ucd_find(string_view table,u32 scalar_value,usize value_width){
    Slice<byte> input=string.as_bytes(table);usize stride=4usize+value_width;
    mut usize low=0usize;mut usize high=Slice.len(input)/stride;
    while(low<high){usize middle=low+(high-low)/2usize;if(ucd_unpack(input,middle*stride,4usize)<=scalar_value)low=middle+1usize;else high=middle;}
    if(low==0usize)Never.unreachable();
    return ucd_unpack(input,(low-1usize)*stride+4usize,value_width);
}
''')

