algorithmic = []
pending = None
for entry in unicode_rows:
    point = int(entry[0], 16)
    if entry[1].endswith(', First>'):
        pending = entry
        continue
    first = point
    if entry[1].endswith(', Last>'):
        assert pending
        first = int(pending[0], 16)
        if 'CJK Ideograph' in pending[1]:
            algorithmic.append((first, point, 'CJK UNIFIED IDEOGRAPH-'))
        elif 'Tangut Ideograph' in pending[1]:
            algorithmic.append((first, point, 'TANGUT IDEOGRAPH-'))
        pending = None
    assign(general, first, point, category_ids[entry[2]])
    assign(combining, first, point, int(entry[3]))
    if entry[6]:
        assign(decimal, first, point, int(entry[6]))
    if not entry[1].startswith('<'):
        names[point] = entry[1]
    for case, field in [('uppercase', 12), ('lowercase', 13), ('titlecase', 14)]:
        if entry[field]:
            simple[case][point] = int(entry[field], 16)
        elif case == 'titlecase' and entry[12]:
            simple[case][point] = int(entry[12], 16)

