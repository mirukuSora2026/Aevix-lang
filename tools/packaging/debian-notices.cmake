#
# File name : debian-notices.cmake
#
# Description :
#     Debian 경로 별칭과 다중 아키텍처 소유자를 해석하여 원본 고지와 공통 라이선스를 수집한다.
#     Resolve Debian path aliases and multiarch owners to collect verbatim notices and common licenses.
#
# ========================

cmake_minimum_required(VERSION 3.20)

function(aevix_collect_debian_notices)
    cmake_parse_arguments(NOTICE "" "DEPENDENCY;STAGE;MANIFEST;DPKG_QUERY;SYSTEM_ROOT" "UPSTREAM_NOTICES" ${ARGN})
    foreach(required DEPENDENCY STAGE MANIFEST DPKG_QUERY)
        if(NOT NOTICE_${required})
            message(FATAL_ERROR "Debian notice collection requires ${required}")
        endif()
    endforeach()
    string(REGEX REPLACE "/$" "" system_root "${NOTICE_SYSTEM_ROOT}")
    set(doc_root "${system_root}/usr/share/doc")
    set(common_root "${system_root}/usr/share/common-licenses")
    file(REAL_PATH "${NOTICE_DEPENDENCY}" resolved)
    set(candidates "${NOTICE_DEPENDENCY}" "${resolved}")
    # merged-/usr 별칭과 SONAME의 실제 파일을 모두 조회한다.
    # Query both merged-/usr aliases and the actual file behind a SONAME symlink.
    foreach(candidate IN ITEMS "${NOTICE_DEPENDENCY}" "${resolved}")
        foreach(directory lib lib64)
            foreach(pair IN ITEMS "${directory}|usr/${directory}" "usr/${directory}|${directory}")
                string(REPLACE "|" ";" parts "${pair}")
                list(GET parts 0 from)
                list(GET parts 1 to)
                set(prefix "${system_root}/${from}/")
                string(FIND "${candidate}" "${prefix}" position)
                if(position EQUAL 0)
                    string(LENGTH "${prefix}" prefix_length)
                    string(SUBSTRING "${candidate}" ${prefix_length} -1 remainder)
                    list(APPEND candidates "${system_root}/${to}/${remainder}")
                endif()
            endforeach()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES candidates)
    set(owners)
    set(owner_queries)
    foreach(candidate IN LISTS candidates)
        execute_process(COMMAND "${NOTICE_DPKG_QUERY}" -S "${candidate}"
            RESULT_VARIABLE query_code OUTPUT_VARIABLE query_output ERROR_VARIABLE query_error TIMEOUT 10)
        if(NOT "${query_code}" STREQUAL "0")
            continue()
        endif()
        string(REPLACE "\n" ";" lines "${query_output}")
        foreach(line IN LISTS lines)
            # 소유자 구분자는 ': '이다. package:arch 안의 콜론을 버리지 않는다.
            # The owner delimiter is ': '; preserve the colon inside package:arch.
            if(line MATCHES "^(.+):[ \t]+/")
                string(REPLACE "," ";" line_owners "${CMAKE_MATCH_1}")
                foreach(owner IN LISTS line_owners)
                    string(STRIP "${owner}" owner)
                    if(NOT owner MATCHES "^[a-z0-9][a-z0-9+.-]*(:[a-z0-9][a-z0-9-]*)?$")
                        message(FATAL_ERROR "Invalid dpkg owner '${owner}' for ${candidate}")
                    endif()
                    if(NOT owner IN_LIST owners)
                        list(APPEND owners "${owner}")
                        list(APPEND owner_queries "${candidate}")
                    endif()
                endforeach()
            endif()
        endforeach()
    endforeach()
    if(NOT owners)
        message(WARNING "No dpkg owner for bundled dependency ${NOTICE_DEPENDENCY}; checked original, real path and merged-/usr aliases: ${candidates}. Review upstream notices in dependency-notices.tsv.")
        if(NOTICE_UPSTREAM_NOTICES)
            set(status unowned-upstream)
        else()
            set(status unowned-no-notice)
        endif()
        file(APPEND "${NOTICE_MANIFEST}" "${NOTICE_DEPENDENCY}\t${resolved}\t-\t-\t-\t${NOTICE_UPSTREAM_NOTICES}\t\t${status}\n")
        return()
    endif()
    list(LENGTH owners owner_count)
    math(EXPR last_owner "${owner_count} - 1")
    foreach(index RANGE 0 ${last_owner})
        list(GET owners ${index} owner)
        list(GET owner_queries ${index} queried_path)
        string(REGEX REPLACE ":[^:]+$" "" package "${owner}")
        set(copyright "${doc_root}/${package}/copyright")
        if(NOT EXISTS "${copyright}" OR IS_DIRECTORY "${copyright}")
            message(FATAL_ERROR "Bundled dependency ${NOTICE_DEPENDENCY} is owned by ${owner} (query: ${queried_path}), but its Debian copyright notice is missing: ${copyright}")
        endif()
        file(REAL_PATH "${copyright}" notice_source)
        set(notice_relative "share/aevix/licenses/${package}/copyright")
        file(MAKE_DIRECTORY "${NOTICE_STAGE}/share/aevix/licenses/${package}")
        # COPYONLY는 배포판 문구를 바꾸지 않고 심볼릭 링크의 실제 내용을 복사한다.
        # COPYONLY preserves distro text verbatim and copies the actual contents of symlinks.
        configure_file("${copyright}" "${NOTICE_STAGE}/${notice_relative}" COPYONLY)
        file(READ "${copyright}" copyright_text)
        string(REGEX MATCHALL "/usr/share/common-licenses/[A-Za-z0-9][A-Za-z0-9_.+-]*" common_references "${copyright_text}")
        set(common_notices)
        foreach(reference IN LISTS common_references)
            get_filename_component(common_name "${reference}" NAME)
            string(REGEX REPLACE "[.]+$" "" common_name "${common_name}")
            set(common_source "${common_root}/${common_name}")
            if(NOT EXISTS "${common_source}" OR IS_DIRECTORY "${common_source}")
                message(FATAL_ERROR "Debian copyright for ${owner} references an unavailable common license: ${reference}")
            endif()
            set(common_relative "share/aevix/licenses/common-licenses/${common_name}")
            file(MAKE_DIRECTORY "${NOTICE_STAGE}/share/aevix/licenses/common-licenses")
            configure_file("${common_source}" "${NOTICE_STAGE}/${common_relative}" COPYONLY)
            list(APPEND common_notices "${common_relative}")
        endforeach()
        list(REMOVE_DUPLICATES common_notices)
        set(bundled_notices ${NOTICE_UPSTREAM_NOTICES} "${notice_relative}")
        file(APPEND "${NOTICE_MANIFEST}" "${NOTICE_DEPENDENCY}\t${resolved}\t${owner}\t${queried_path}\t${notice_source}\t${bundled_notices}\t${common_notices}\tdpkg\n")
    endforeach()
endfunction()
