# File name : bundle-runtime.cmake
#
# Description :
#     설치된 컴파일러의 외부 공유 라이브러리를 수집하고 재배치한다.
#     Collect and relocate the installed compiler's external shared libraries.
#
# ========================

cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/debian-notices.cmake")
if(NOT DEFINED STAGE OR NOT EXISTS "${STAGE}/bin/aevixc")
    message(FATAL_ERROR "STAGE must contain bin/aevixc")
endif()
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${STAGE}/bin/aevixc"
    RESOLVED_DEPENDENCIES_VAR dependencies
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    POST_EXCLUDE_REGEXES "^/System/Library/" "^/usr/lib/[^/]+[.]dylib$"
        "/(ld-linux[^/]*|libc[.]so[^/]*|libm[.]so[^/]*|libpthread[.]so[^/]*|libdl[.]so[^/]*|librt[.]so[^/]*|libresolv[.]so[^/]*|libutil[.]so[^/]*)$")
if(unresolved)
    message(FATAL_ERROR "Unresolved compiler libraries: ${unresolved}")
endif()
set(bundle "${STAGE}/lib/aevix/compiler")
file(MAKE_DIRECTORY "${bundle}")
file(MAKE_DIRECTORY "${STAGE}/share/aevix/licenses")
set(notice_manifest "${STAGE}/share/aevix/licenses/dependency-notices.tsv")
file(WRITE "${notice_manifest}" "dependency\tresolved_dependency\towner\tqueried_path\tnotice_source\tbundled_notices\tcommon_licenses\tstatus\n")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    find_program(DPKG_QUERY dpkg-query)
endif()
set(originals)
foreach(dependency IN LISTS dependencies)
    get_filename_component(name "${dependency}" NAME)
    if(EXISTS "${bundle}/${name}")
        file(SHA256 "${dependency}" original_hash)
        file(SHA256 "${bundle}/${name}" copied_hash)
        if(NOT original_hash STREQUAL copied_hash)
            message(FATAL_ERROR "Conflicting bundled library name: ${name}")
        endif()
    else()
        configure_file("${dependency}" "${bundle}/${name}" COPYONLY)
        file(CHMOD "${bundle}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
    list(APPEND originals "${dependency}")
    # Homebrew 등의 라이브러리 배포 조건을 위해 설치 루트의 라이선스도 동봉한다.
    # Include license files from dependency installation prefixes for redistribution.
    get_filename_component(library_directory "${dependency}" DIRECTORY)
    get_filename_component(dependency_prefix "${library_directory}" DIRECTORY)
    get_filename_component(dependency_name "${dependency_prefix}" NAME)
    file(GLOB license_files "${dependency_prefix}/LICENSE*" "${dependency_prefix}/COPYING*")
    set(upstream_notices)
    foreach(license IN LISTS license_files)
        if(NOT IS_DIRECTORY "${license}")
            file(INSTALL "${license}" DESTINATION "${STAGE}/share/aevix/licenses/${dependency_name}")
            get_filename_component(license_name "${license}" NAME)
            list(APPEND upstream_notices "share/aevix/licenses/${dependency_name}/${license_name}")
        endif()
    endforeach()
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND DPKG_QUERY)
        aevix_collect_debian_notices(DEPENDENCY "${dependency}" STAGE "${STAGE}"
            MANIFEST "${notice_manifest}" DPKG_QUERY "${DPKG_QUERY}" UPSTREAM_NOTICES ${upstream_notices})
    else()
        file(REAL_PATH "${dependency}" resolved_dependency)
        file(APPEND "${notice_manifest}" "${dependency}\t${resolved_dependency}\t-\t-\t${dependency_prefix}\t${upstream_notices}\t\tupstream\n")
    endif()
endforeach()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    find_program(INSTALL_NAME_TOOL install_name_tool REQUIRED)
    find_program(CODESIGN codesign REQUIRED)
    set(images "${STAGE}/bin/aevixc")
    foreach(dependency IN LISTS originals)
        get_filename_component(name "${dependency}" NAME)
        list(APPEND images "${bundle}/${name}")
    endforeach()
    foreach(image IN LISTS images)
        foreach(dependency IN LISTS originals)
            get_filename_component(name "${dependency}" NAME)
            if(image STREQUAL "${STAGE}/bin/aevixc")
                set(replacement "@executable_path/../lib/aevix/compiler/${name}")
            else()
                set(replacement "@loader_path/${name}")
            endif()
            execute_process(COMMAND "${INSTALL_NAME_TOOL}" -change "${dependency}" "${replacement}" "${image}" RESULT_VARIABLE code ERROR_VARIABLE error)
            if(NOT code EQUAL 0)
                message(FATAL_ERROR "Cannot relocate ${image}: ${error}")
            endif()
        endforeach()
        if(NOT image STREQUAL "${STAGE}/bin/aevixc")
            get_filename_component(name "${image}" NAME)
            execute_process(COMMAND "${INSTALL_NAME_TOOL}" -id "@rpath/${name}" "${image}" RESULT_VARIABLE code)
            if(NOT code EQUAL 0)
                message(FATAL_ERROR "Cannot update bundled library identity")
            endif()
        endif()
        execute_process(COMMAND "${CODESIGN}" --force --sign - "${image}" RESULT_VARIABLE code ERROR_VARIABLE error)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Cannot ad-hoc sign ${image}: ${error}")
        endif()
    endforeach()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND dependencies)
    find_program(PATCHELF patchelf)
    if(PATCHELF)
        execute_process(COMMAND "${PATCHELF}" --set-rpath "$ORIGIN/../lib/aevix/compiler" "${STAGE}/bin/aevixc" RESULT_VARIABLE code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Cannot relocate compiler library search path")
        endif()
        foreach(dependency IN LISTS originals)
            get_filename_component(name "${dependency}" NAME)
            execute_process(COMMAND "${PATCHELF}" --set-rpath "$ORIGIN" "${bundle}/${name}" RESULT_VARIABLE code)
            if(NOT code EQUAL 0)
                message(FATAL_ERROR "Cannot relocate bundled library search path: ${name}")
            endif()
        endforeach()
    else()
        file(RENAME "${STAGE}/bin/aevixc" "${STAGE}/bin/aevixc.real")
        configure_file("${CMAKE_CURRENT_LIST_DIR}/../../packaging/posix/compiler-launcher.sh" "${STAGE}/bin/aevixc" COPYONLY)
        file(CHMOD "${STAGE}/bin/aevixc" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
endif()
